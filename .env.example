# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
REVENUECAT_API_KEY=
REVENUECAT_WEBHOOK_SECRET=

# Push
EXPO_ACCESS_TOKEN=

# Auth: Google is the only sign-in, plus Sign in with Apple on iOS (docs/flows/auth.md).
# Client ids are public, but they still come from config, never hard-coded.
# Per-variant iOS client ids live in packages/config/variants/*.json.
WEB_APP_URL=
GOOGLE_OAUTH_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
VITE_GOOGLE_WEB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
APPLE_TEAM_ID=
APPLE_SIGNIN_KEY_ID=
APPLE_SIGNIN_PRIVATE_KEY=
APPLE_SIGNIN_CLIENT_IDS=
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
# Only if web Apple sign-in is approved (TRD §18 D10)
APPLE_SERVICES_ID=
AUTH_IDENTITY_HASH_PEPPER=
AUTH_MANAGED_IDENTITY_DOMAIN=
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# Trial and abuse signals (TRD §11)
APPLE_DEVICECHECK_KEY_ID=
APPLE_DEVICECHECK_PRIVATE_KEY=
PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON=

# Only if guardian consent needs a DigiLocker age token (TRD §18 D8)
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=

# Observability
SENTRY_DSN_API=
SENTRY_DSN_WORKER=
SENTRY_DSN_MOBILE=
SENTRY_DSN_WEB=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
