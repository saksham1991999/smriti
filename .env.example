# Names only. Values live in Railway, Cloudflare, GitHub and EAS secrets (docs/DEPLOY.md, TRD §17).
# `pnpm env:check` fails when code reads a name that no .env.example lists, or when a name here is
# read by nothing. App-specific public names also live in apps/web, apps/mobile and apps/site.
# A section whose header says [platform] lists settings a provider reads, not our code.

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=
# The API and worker: Supavisor transaction pooler (port 6543), postgresql+asyncpg://...
DATABASE_URL=
# The release migrator (python -m smriti_api.migrate): direct or session-mode URL (port 5432),
# which the advisory lock needs. Falls back to DATABASE_URL.
MIGRATIONS_DATABASE_URL=
# Live mock fan-out: supabase (Realtime broadcast with the service key) or redis (SSE only).
# Empty: supabase outside local when the URL and service key are set.
REALTIME_PROVIDER=

# Redis
REDIS_URL=

# API and worker (apps/api, apps/worker; defaults and meanings in apps/api/README.md)
APP_ENV=
API_PUBLIC_URL=
CORS_ORIGINS=
DB_POOL_SIZE=
DB_SYSTEM_ROLE=
JWT_AUDIENCE=
JWT_ISSUER=
# Local and test only: signs dev auth tokens (a random key per process when empty)
DEV_JWT_SECRET=
JOBS_MODE=
# Worker queues for this process: all, one queue, or a comma-separated list (python -m smriti_worker)
WORKER_QUEUE=
# Uvicorn worker processes per API container (the image defaults to 2)
WEB_CONCURRENCY=
CONTENT_LOCAL_DIR=
CONTENT_PUBLISH_CMD=
VARIANTS_DIR=
LOG_LEVEL=
LOG_HASH_SALT=
OTEL_SERVICE_NAME=

# Optional tuning: every one has a default in code; set only to change it
JWT_LEEWAY_S=
RATE_SYNC_PER_MIN=
RATE_DEV_AUTH_PER_MIN=
RATE_MERGES_PER_DAY=
RATE_DEFAULT_PER_MIN=
RATE_ANALYTICS_PER_MIN=
AI_REQUEST_TIMEOUT_S=
AI_IMAGE_TIMEOUT_S=
# CDN key layout for content (must match tools/content-publish)
CONTENT_BUNDLE_PATH=
CONTENT_MANIFEST_PATH=
CONTENT_PATCH_PATH=
# Provider API bases (overridden only in tests or for a regional endpoint)
RAZORPAY_BASE_URL=
RESEND_BASE_URL=
REVENUECAT_BASE_URL=
# Another copy of packages/config/flag-defaults.json (for example in a slim image)
FLAG_DEFAULTS_PATH=

# Cloudflare R2 and CDN (TRD §8). CDN_BASE_URL is https://cdn.<domain>; content is under /c/.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_ASSETS=
R2_BUCKET_CONTENT=
R2_BUCKET_UPLOADS=
CDN_BASE_URL=

# AI (model tiers are config, never hard-coded)
AGNES_AI_API_KEY=
AGNES_BASE_URL=
AI_TIER_TUTOR_MODEL=
AI_TIER_CHEAP_MODEL=
AI_TIER_AUTHOR_MODEL=
AI_TIER_IMAGE_MODEL=
# Photo doubt (AI-18 reading): a vision-capable chat model
AI_TIER_VISION_MODEL=
# agnes (default) or fake (tests and offline development)
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=
DEEPGRAM_API_KEY=
# A Deepgram Flux voice id for POST /v2/speak (R62); STT stays on /v1/listen.
DEEPGRAM_TTS_MODEL=
DEEPGRAM_STT_MODEL=

# Analytics
CLICKHOUSE_URL=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=
# Local only: where POST /v1/analytics/events writes while CLICKHOUSE_URL is unset
ANALYTICS_EVENTS_FILE=
# Optional: path to the analytics catalogue JSON (default packages/analytics/catalogue.json in the repo)
ANALYTICS_CATALOGUE_PATH=

# Payments (TRD §11). Without keys, local and test use fake providers; other environments refuse.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_INTRO_OFFER_ID=
RAZORPAY_TOTAL_COUNT=
# The ₹799/year plan and the family plans (PRD §11.2); empty means that checkout is off
RAZORPAY_YEARLY_PLAN_ID=
RAZORPAY_FAMILY_MONTHLY_PLAN_ID=
RAZORPAY_FAMILY_YEARLY_PLAN_ID=
RAZORPAY_YEARLY_TOTAL_COUNT=
# Days of Pro kept after a failed web renewal (proposed 7; owner to confirm)
RAZORPAY_GRACE_DAYS=
# RevenueCat secret API key (REVENUECAT_SECRET_API_KEY is read as the same setting)
REVENUECAT_API_KEY=
# The exact Authorization header value RevenueCat sends with webhooks (alias REVENUECAT_WEBHOOK_AUTH)
REVENUECAT_WEBHOOK_SECRET=
AUTH_IDENTITY_HASH_KEY_VERSION=

# Push: Expo for the apps, Web Push (VAPID) for the web app
PUSH_PROVIDER=
EXPO_PUSH_URL=
EXPO_ACCESS_TOKEN=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=

# Transactional email (guardian consent links): MAIL_PROVIDER is resend or smtp
MAIL_PROVIDER=
MAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=

# File storage: r2 (default when R2 keys are set) or local (.dev/storage)
STORAGE_PROVIDER=
STORAGE_LOCAL_DIR=
R2_ENDPOINT=
SIGNED_URL_TTL_S=
GUARDIAN_LINK_BASE_URL=
CHILD_PAY_LINK_BASE_URL=
# Managed children (auth flow §6.11): domain for internal identities, e.g. managed.<auth-domain>
MANAGED_IDENTITY_DOMAIN=
BRAND_NAME=
# Server copy is read from packages/i18n; point elsewhere in a slim image
I18N_LOCALES_DIR=
# Content publish job (apps/worker): content root and the folder metadata.sql is written to
CONTENT_ROOT=
CONTENT_PUBLISH_REPORT_DIR=
# Fixes the publish time for reproducible content builds (tools/content-publish)
SOURCE_DATE_EPOCH=
# Optional, for the publisher CLI: production, staging or local (no default; the worker passes
# --env from APP_ENV). Production refuses media that is not approved.
CONTENT_PUBLISH_ENV=

# Auth: Google is the only sign-in, plus Sign in with Apple on iOS (docs/flows/auth.md).
# Client ids are public, but they still come from config, never hard-coded.
WEB_APP_URL=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
VITE_GOOGLE_WEB_CLIENT_ID=
VITE_TURNSTILE_SITE_KEY=
AUTH_IDENTITY_HASH_PEPPER=

# Supabase Auth provider settings, entered in the Supabase dashboard (Auth > Providers, Captcha) [platform]
# Google: the web client id plus every iOS client id, comma separated, and the web client secret.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# Apple: every variant bundle id, and the client secret JWT made from the APPLE_SIGNIN_* key
# below (expires in 6 months).
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
# Cloudflare Turnstile secret for anonymous sign-in (Supabase verifies the token)
TURNSTILE_SECRET_KEY=

# Sign in with Apple token revocation on account deletion (API; Apple TN3194). The API signs a
# five-minute client secret per call with this key; the .p8 PEM may use literal \n.
APPLE_TEAM_ID=
APPLE_SIGNIN_KEY_ID=
APPLE_SIGNIN_PRIVATE_KEY=
# Every variant bundle id that offers Sign in with Apple, comma separated
APPLE_SIGNIN_CLIENT_IDS=
# Overridden only in tests
APPLE_SIGNIN_BASE_URL=

# Device attestation on sensitive endpoints (G-10, TRD §14; flag security.attestation_required).
# ATTESTATION_PROVIDER=fake forces the fake; otherwise each platform is real once its env is set.
ATTESTATION_PROVIDER=
PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON=
# variant=android.package pairs, comma separated
PLAY_INTEGRITY_PACKAGES=
# variant=TEAMID.bundle.id pairs, comma separated
APP_ATTEST_APP_IDS=
# production | development (the App Attest environment entitlement)
APP_ATTEST_ENVIRONMENT=production
# Optional: overrides the bundled Apple App Attestation Root CA (PEM)
APP_ATTEST_ROOT_CA_PEM=
ATTESTATION_NONCE_TTL_S=300

# Observability: traces go to OTLP when the endpoint is set
OTEL_EXPORTER_OTLP_ENDPOINT=
# Sentry errors for the API and worker (off when empty; no personal data is sent)
SENTRY_DSN=
# Optional release name; defaults to smriti-api@<version> or smriti-worker@<version>
SENTRY_RELEASE=

# Read by the OpenTelemetry SDK itself, e.g. Authorization=Basic <token> for Grafana Cloud [platform]
OTEL_EXPORTER_OTLP_HEADERS=

# Mobile builds (apps/mobile; public, set per EAS environment). The sims host is the CDN's
# sims folder, https://cdn.<domain>/sims, served with Cross-Origin-Resource-Policy: cross-origin.
EXPO_PUBLIC_SIM_BASE_URL=
# Optional per-variant overrides of the iOS Google client id and URL scheme in
# packages/config/variants/*.json, read by app.config.ts for APP_VARIANT
GOOGLE_IOS_CLIENT_ID_ALL=
GOOGLE_IOS_CLIENT_ID_JEE=
GOOGLE_IOS_CLIENT_ID_NEET=
GOOGLE_IOS_CLIENT_ID_UPSC=
GOOGLE_IOS_CLIENT_ID_SSC=
GOOGLE_IOS_URL_SCHEME_ALL=
GOOGLE_IOS_URL_SCHEME_JEE=
GOOGLE_IOS_URL_SCHEME_NEET=
GOOGLE_IOS_URL_SCHEME_UPSC=
GOOGLE_IOS_URL_SCHEME_SSC=
# Which variant's seed pack scripts/seed-pack.mjs builds (defaults to APP_VARIANT)
SEED_VARIANT=
