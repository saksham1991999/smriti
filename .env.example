# Names only. Values live in Railway, Cloudflare and EAS secrets (see docs/TRD.md §17).

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=
DATABASE_URL=

# Redis
REDIS_URL=

# API and worker (apps/api, apps/worker; defaults and meanings in apps/api/README.md)
APP_ENV=
API_PUBLIC_URL=
CORS_ORIGINS=
DB_POOL_SIZE=
DB_SYSTEM_ROLE=
JWT_AUDIENCE=
JWT_ISSUER=
# Local and test only: signs dev auth tokens (a random key per process when empty)
DEV_JWT_SECRET=
JOBS_MODE=
WORKER_QUEUE=
CONTENT_LOCAL_DIR=
CONTENT_PUBLISH_CMD=
VARIANTS_DIR=
LOG_LEVEL=
LOG_HASH_SALT=
OTEL_SERVICE_NAME=

# Cloudflare R2 and CDN
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_ASSETS=
R2_BUCKET_CONTENT=
R2_BUCKET_UPLOADS=
R2_BUCKET_STAGING=
CDN_BASE_URL=

# AI (model tiers are config, never hard-coded)
AGNES_AI_API_KEY=
AGNES_BASE_URL=
AI_TIER_TUTOR_MODEL=
AI_TIER_CHEAP_MODEL=
AI_TIER_AUTHOR_MODEL=
AI_TIER_IMAGE_MODEL=
# agnes (default) or fake (tests and offline development)
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_MODEL=
DEEPGRAM_STT_MODEL=
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=

# Analytics
CLICKHOUSE_URL=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=

# Payments (TRD §11). Without keys, local and test use fake providers; other environments refuse.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_INTRO_OFFER_ID=
RAZORPAY_TOTAL_COUNT=
# Days of Pro kept after a failed web renewal (proposed 7; owner to confirm)
RAZORPAY_GRACE_DAYS=
REVENUECAT_API_KEY=
# The exact Authorization header value RevenueCat sends with webhooks
REVENUECAT_WEBHOOK_SECRET=
AUTH_IDENTITY_HASH_KEY_VERSION=

# Push: Expo for the apps, Web Push (VAPID) for the web app
PUSH_PROVIDER=
EXPO_PUSH_URL=
EXPO_ACCESS_TOKEN=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=

# Transactional email (guardian consent links): MAIL_PROVIDER is resend or smtp
MAIL_PROVIDER=
MAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=

# File storage: r2 (default when R2 keys are set) or local (.dev/storage)
STORAGE_PROVIDER=
STORAGE_LOCAL_DIR=
R2_ENDPOINT=
SIGNED_URL_TTL_S=
GUARDIAN_LINK_BASE_URL=
BRAND_NAME=
# Server copy is read from packages/i18n; point elsewhere in a slim image
I18N_LOCALES_DIR=
# Content publish job (apps/worker): content root and the folder metadata.sql is written to
CONTENT_ROOT=
CONTENT_PUBLISH_REPORT_DIR=

# Auth: Google is the only sign-in, plus Sign in with Apple on iOS (docs/flows/auth.md).
# Client ids are public, but they still come from config, never hard-coded.
# Per-variant iOS client ids live in packages/config/variants/*.json.
WEB_APP_URL=
GOOGLE_OAUTH_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
VITE_GOOGLE_WEB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
APPLE_TEAM_ID=
APPLE_SIGNIN_KEY_ID=
APPLE_SIGNIN_PRIVATE_KEY=
APPLE_SIGNIN_CLIENT_IDS=
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
# Only if web Apple sign-in is approved (TRD §18 D10)
APPLE_SERVICES_ID=
AUTH_IDENTITY_HASH_PEPPER=
AUTH_MANAGED_IDENTITY_DOMAIN=
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# Trial and abuse signals (TRD §11)
APPLE_DEVICECHECK_KEY_ID=
APPLE_DEVICECHECK_PRIVATE_KEY=
PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON=
# Device attestation on sensitive endpoints (G-10, TRD §14; flag security.attestation_required).
# ATTESTATION_PROVIDER=fake forces the fake; otherwise each platform is real once its env is set.
ATTESTATION_PROVIDER=
# variant=android.package pairs, comma separated
PLAY_INTEGRITY_PACKAGES=
# variant=TEAMID.bundle.id pairs, comma separated
APP_ATTEST_APP_IDS=
# production | development (the App Attest environment entitlement)
APP_ATTEST_ENVIRONMENT=production
# Optional: overrides the bundled Apple App Attestation Root CA (PEM)
APP_ATTEST_ROOT_CA_PEM=
ATTESTATION_NONCE_TTL_S=300

# Only if guardian consent needs a DigiLocker age token (TRD §18 D8)
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=

# Observability
SENTRY_DSN_API=
SENTRY_DSN_WORKER=
SENTRY_DSN_MOBILE=
SENTRY_DSN_WEB=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
