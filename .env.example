R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_ASSETS=
R2_BUCKET_CONTENT=
R2_BUCKET_UPLOADS=
R2_BUCKET_STAGING=
CDN_BASE_URL=

# AI (model tiers are config, never hard-coded)
