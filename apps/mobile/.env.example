# apps/mobile: public build-time config. Every EXPO_PUBLIC_* value ships inside the app bundle,
# so none of these is a secret. Values go in EAS secrets (build profiles) or a local .env.

# Build
APP_VARIANT=all                       # all | jee | neet | upsc | ssc (packages/config/variants)
EAS_PROJECT_ID=                       # enables Expo push tokens (ExpoNotifier.pushToken)

# Client config (packages/config parseClientEnv)
EXPO_PUBLIC_APP_ENV=local             # local | test | preview | staging | production
EXPO_PUBLIC_APP_VARIANT=all
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
EXPO_PUBLIC_CDN_BASE_URL=
EXPO_PUBLIC_AUTH_MODE=dev             # dev (apps/api /v1/dev/auth) | supabase
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_ANALYTICS_URL=

# Switches: each turns a fake into the real implementation (src/env.ts)
EXPO_PUBLIC_BILLING=                  # revenuecat for the real store; fake by default in local/test
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=     # RevenueCat public SDK keys
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=
EXPO_PUBLIC_GOOGLE_SIGNIN=            # native for @react-native-google-signin; dev form by default locally
EXPO_PUBLIC_FAKE_API=                 # 1 = in-app fake API (demos without apps/api), local/test only
EXPO_PUBLIC_SIM_BASE_URL=             # where sims/ bundles are served (lab cards)
# Local only: the header apps/api accepts on /v1/webhooks/revenuecat when APP_ENV is local/test,
# so FakeBilling can play RevenueCat. Ignored by the app outside local/test.
EXPO_PUBLIC_DEV_REVENUECAT_WEBHOOK_AUTH=

# Tests
SMRITI_LIVE_API=                      # e.g. http://127.0.0.1:8000 runs test/live against apps/api
SMRITI_LIVE_REVENUECAT_AUTH=          # overrides the local webhook header in live runs
