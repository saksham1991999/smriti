{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": { "node": "22.21.1", "pnpm": "10.28.0", "env": { "EXPO_PUBLIC_APP_ENV": "local" } },
    "development": {
      "extends": "base",
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": { "EXPO_PUBLIC_APP_ENV": "local", "EXPO_PUBLIC_AUTH_MODE": "dev" }
    },
    "preview": {
      "extends": "base",
      "environment": "preview",
      "distribution": "internal",
      "channel": "preview",
      "env": { "EXPO_PUBLIC_APP_ENV": "preview", "EXPO_PUBLIC_AUTH_MODE": "supabase" }
    },
    "staging": {
      "extends": "base",
      "environment": "preview",
      "distribution": "store",
      "autoIncrement": true,
      "channel": "staging",
      "env": { "EXPO_PUBLIC_APP_ENV": "staging", "EXPO_PUBLIC_AUTH_MODE": "supabase" }
    },
    "production": {
      "extends": "base",
      "environment": "production",
      "distribution": "store",
      "autoIncrement": true,
      "channel": "production",
      "env": { "EXPO_PUBLIC_APP_ENV": "production", "EXPO_PUBLIC_AUTH_MODE": "supabase" }
    },
    "development-all": { "extends": "development", "env": { "APP_VARIANT": "all" } },
    "development-jee": { "extends": "development", "env": { "APP_VARIANT": "jee" } },
    "development-neet": { "extends": "development", "env": { "APP_VARIANT": "neet" } },
    "development-upsc": { "extends": "development", "env": { "APP_VARIANT": "upsc" } },
    "development-ssc": { "extends": "development", "env": { "APP_VARIANT": "ssc" } },
    "preview-all": {
      "extends": "preview",
      "channel": "preview-all",
      "env": { "APP_VARIANT": "all" }
    },
    "preview-jee": {
      "extends": "preview",
      "channel": "preview-jee",
      "env": { "APP_VARIANT": "jee" }
    },
    "preview-neet": {
      "extends": "preview",
      "channel": "preview-neet",
      "env": { "APP_VARIANT": "neet" }
    },
    "preview-upsc": {
      "extends": "preview",
      "channel": "preview-upsc",
      "env": { "APP_VARIANT": "upsc" }
    },
    "preview-ssc": {
      "extends": "preview",
      "channel": "preview-ssc",
      "env": { "APP_VARIANT": "ssc" }
    },
    "staging-all": {
      "extends": "staging",
      "channel": "staging-all",
      "env": { "APP_VARIANT": "all" }
    },
    "staging-jee": {
      "extends": "staging",
      "channel": "staging-jee",
      "env": { "APP_VARIANT": "jee" }
    },
    "staging-neet": {
      "extends": "staging",
      "channel": "staging-neet",
      "env": { "APP_VARIANT": "neet" }
    },
    "staging-upsc": {
      "extends": "staging",
      "channel": "staging-upsc",
      "env": { "APP_VARIANT": "upsc" }
    },
    "staging-ssc": {
      "extends": "staging",
      "channel": "staging-ssc",
      "env": { "APP_VARIANT": "ssc" }
    },
    "production-all": {
      "extends": "production",
      "channel": "production-all",
      "env": { "APP_VARIANT": "all" }
    },
    "production-jee": {
      "extends": "production",
      "channel": "production-jee",
      "env": { "APP_VARIANT": "jee" }
    },
    "production-neet": {
      "extends": "production",
      "channel": "production-neet",
      "env": { "APP_VARIANT": "neet" }
    },
    "production-upsc": {
      "extends": "production",
      "channel": "production-upsc",
      "env": { "APP_VARIANT": "upsc" }
    },
    "production-ssc": {
      "extends": "production",
      "channel": "production-ssc",
      "env": { "APP_VARIANT": "ssc" }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "serviceAccountKeyPath": "$GOOGLE_SERVICE_ACCOUNT_KEY_PATH"
      },
      "ios": {
        "ascApiKeyPath": "$ASC_API_KEY_PATH",
        "ascApiKeyId": "$ASC_API_KEY_ID",
        "ascApiKeyIssuerId": "$ASC_API_KEY_ISSUER_ID"
      }
    },
    "production-all": {
      "extends": "production",
      "android": { "applicationId": "app.smriti.all" },
      "ios": { "bundleIdentifier": "app.smriti.all" }
    },
    "production-jee": {
      "extends": "production",
      "android": { "applicationId": "app.smriti.jee" },
      "ios": { "bundleIdentifier": "app.smriti.jee" }
    },
    "production-neet": {
      "extends": "production",
      "android": { "applicationId": "app.smriti.neet" },
      "ios": { "bundleIdentifier": "app.smriti.neet" }
    },
    "production-upsc": {
      "extends": "production",
      "android": { "applicationId": "app.smriti.upsc" },
      "ios": { "bundleIdentifier": "app.smriti.upsc" }
    },
    "production-ssc": {
      "extends": "production",
      "android": { "applicationId": "app.smriti.ssc" },
      "ios": { "bundleIdentifier": "app.smriti.ssc" }
    },
    "staging-all": { "extends": "production-all" },
    "staging-jee": { "extends": "production-jee" },
    "staging-neet": { "extends": "production-neet" },
    "staging-upsc": { "extends": "production-upsc" },
    "staging-ssc": { "extends": "production-ssc" }
  }
}
