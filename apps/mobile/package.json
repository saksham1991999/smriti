{
  "name": "@smriti/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Smriti Expo app for iOS and Android, one build per exam variant (APP_VARIANT).",
  "main": "expo-router/entry",
  "scripts": {
    "seed": "node scripts/seed-pack.mjs",
    "dev": "node scripts/seed-pack.mjs && expo start",
    "web": "node scripts/seed-pack.mjs && expo start --web",
    "export:ios": "node scripts/seed-pack.mjs && expo export --platform ios --output-dir dist-ios",
    "export:android": "node scripts/seed-pack.mjs && expo export --platform android --output-dir dist-android",
    "export:web": "node scripts/seed-pack.mjs && expo export --platform web --output-dir dist-web",
    "typecheck": "node scripts/seed-pack.mjs && tsc --noEmit -p .",
    "lint": "node scripts/seed-pack.mjs && tsc --noEmit -p . && node scripts/lint-rules.mjs",
    "test": "node scripts/seed-pack.mjs && jest",
    "test:live": "node scripts/seed-pack.mjs && jest test/live"
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans-devanagari": "0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "0.4.2",
    "@expo/metro-runtime": "57.0.17",
    "@react-native-community/netinfo": "12.0.1",
    "@smriti/analytics": "workspace:*",
    "@smriti/api-client": "workspace:*",
    "@smriti/app-core": "workspace:*",
    "@smriti/config": "workspace:*",
    "@smriti/content-schema": "workspace:*",
    "@smriti/i18n": "workspace:*",
    "@smriti/lesson-core": "workspace:*",
    "@smriti/lesson-player-native": "workspace:*",
    "@smriti/sim-bridge": "workspace:*",
    "@smriti/tokens": "workspace:*",
    "@smriti/ui-native": "workspace:*",
    "@tanstack/react-query": "5.104.2",
    "expo": "57.0.29",
    "expo-apple-authentication": "57.0.2",
    "expo-asset": "57.0.20",
    "expo-constants": "57.0.22",
    "expo-crypto": "57.0.4",
    "expo-font": "57.0.4",
    "expo-haptics": "57.0.3",
    "expo-linking": "57.0.13",
    "expo-localization": "57.0.2",
    "expo-notifications": "57.0.23",
    "expo-router": "57.0.27",
    "expo-secure-store": "57.0.4",
    "expo-splash-screen": "57.0.10",
    "expo-sqlite": "57.0.4",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.4",
    "phosphor-react-native": "3.0.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "29.5.14",
    "@types/node": "24.19.2",
    "@types/react": "19.2.17",
    "jest": "29.7.0",
    "jest-expo": "57.0.6",
    "test-renderer": "1.2.0",
    "typescript": "5.9.3"
  }
}
