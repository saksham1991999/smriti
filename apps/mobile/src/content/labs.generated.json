  {
    "id": "motion-graphs",
    "version": "1.0.0",
    "title": {
      "en": "Motion graphs",
      "hi": "गति के ग्राफ़"
    },
    "subject": "phy",
    "concepts": [
      "phy.motion-straight-line.acceleration.core.acceleration-graphs",
      "phy.motion-straight-line.kinematic-equations.core.equations-of-motion"
    ],
    "tasks": 4,
    "taskSpecs": [
      {
        "id": "stop-time",
        "prompt": {
          "en": "With u = 10 m/s and a = −2 m/s², stop the clock when the velocity reads zero.",
          "hi": "u = 10 m/s और a = −2 m/s² के साथ, जब वेग शून्य दिखे तब घड़ी रोकिए।"
        },
        "hint": {
          "en": "Near the end, use Step to move 0.1 s at a time.",
          "hi": "अंत के पास, 0.1 s करके आगे बढ़ने के लिए एक कदम दबाइए।"
        },
        "check": {
          "kind": "all",
          "of": [
            {
              "kind": "target",
              "quantity": "initial_velocity",
              "value": 10,
              "tolerance": 0.01
            },
            {
              "kind": "target",
              "quantity": "acceleration",
              "value": -2,
              "tolerance": 0.01
            },
            {
              "kind": "target",
              "quantity": "velocity",
              "value": 0,
              "tolerance": 0.05
            },
            {
              "kind": "target",
              "quantity": "time",
              "value": 5,
              "tolerance": 0.1
            }
          ]
        }
      },
      {
        "id": "farthest",
        "prompt": {
          "en": "Leave the clock where the velocity is zero: the cart is farthest from the start.",
          "hi": "घड़ी वहीं रहने दीजिए जहाँ वेग शून्य है: गाड़ी आरंभ से सबसे दूर है।"
        },
        "hint": {
          "en": "The x-t curve is at its top where the v-t line crosses zero.",
          "hi": "जहाँ v-t रेखा शून्य को काटती है, वहाँ x-t वक्र सबसे ऊपर होता है।"
        },
        "check": {
          "kind": "all",
          "of": [
            {
              "kind": "target",
              "quantity": "initial_velocity",
              "value": 10,
              "tolerance": 0.01
            },
            {
              "kind": "target",
              "quantity": "acceleration",
              "value": -2,
              "tolerance": 0.01
            },
            {
              "kind": "target",
              "quantity": "velocity",
              "value": 0,
              "tolerance": 0.05
            },
            {
              "kind": "target",
              "quantity": "position",
              "value": 25,
              "tolerance": 0.5
            }
          ]
        }
      },
      {
        "id": "back-home",
        "prompt": {
          "en": "Run on to t = 10 s and read the position.",
          "hi": "t = 10 s तक चलाइए और स्थिति पढ़िए।"
        },
        "hint": {
          "en": "Move the time slider to the end, or press Play.",
          "hi": "समय स्लाइडर को अंत तक ले जाइए, या चलाएँ दबाइए।"
        },
        "check": {
          "kind": "all",
          "of": [
            {
              "kind": "target",
              "quantity": "initial_velocity",
              "value": 10,
              "tolerance": 0.01
            },
            {
              "kind": "target",
              "quantity": "acceleration",
              "value": -2,
              "tolerance": 0.01
            },
            {
              "kind": "target",
              "quantity": "time",
              "value": 10,
              "tolerance": 0.1
            },
            {
              "kind": "target",
              "quantity": "position",
              "value": 0,
              "tolerance": 0.5
            }
          ]
        }
      },
      {
        "id": "path",
        "prompt": {
          "en": "At t = 10 s, compare the displacement with the path length.",
          "hi": "t = 10 s पर विस्थापन की तुलना पथ-लंबाई से कीजिए।"
        },
        "hint": {
          "en": "Path length adds both shaded areas; displacement adds them with their signs.",
          "hi": "पथ-लंबाई दोनों छायांकित क्षेत्रफल जोड़ती है; विस्थापन उन्हें चिह्न सहित जोड़ता है।"
        },
        "check": {
          "kind": "all",
          "of": [
            {
              "kind": "target",
              "quantity": "initial_velocity",
              "value": 10,
              "tolerance": 0.01
            },
            {
              "kind": "target",
              "quantity": "acceleration",
              "value": -2,
              "tolerance": 0.01
            },
            {
              "kind": "target",
              "quantity": "time",
              "value": 10,
