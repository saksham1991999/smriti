  {
    "id": "ohms-law-circuit",
    "version": "1.0.1",
    "title": {
      "en": "Ohm's law: simple circuit",
      "hi": "ओम का नियम: सरल परिपथ"
    },
    "subject": "phy",
    "concepts": [
      "phy.current-electricity.ohms-law.core.ohms-law-def",
      "phy.current-electricity.resistor-combinations.core.resistors-series-parallel",
      "phy.current-electricity.cells.core.emf-internal-resistance"
    ],
    "tasks": 4,
    "taskSpecs": [
      {
        "id": "current-half-amp",
        "prompt": {
          "en": "Make the ammeter read 0.5 A.",
          "hi": "ऐमीटर में 0.5 A की रीडिंग लाएँ।"
        },
        "hint": {
          "en": "Change the battery voltage or the resistance, and watch the ammeter.",
          "hi": "बैटरी का विभवांतर या प्रतिरोध बदलें और ऐमीटर देखें।"
        },
        "check": {
          "kind": "all",
          "of": [
            {
              "kind": "condition",
              "rule": "switch_on"
            },
            {
              "kind": "target",
              "quantity": "current",
              "value": 0.5,
              "tolerance": 0.01
            }
          ]
        }
      },
      {
        "id": "double-current",
        "prompt": {
          "en": "Keep the battery voltage the same. Change the resistance so the current doubles.",
          "hi": "बैटरी का विभवांतर वही रखें। प्रतिरोध ऐसे बदलें कि धारा दोगुनी हो जाए।"
        },
        "hint": {
          "en": "Try making the resistance smaller.",
          "hi": "प्रतिरोध कम करके देखें।"
        },
        "check": {
          "kind": "ratio",
          "quantity": "current",
          "ratio": 2,
          "tolerance": 0.03,
          "hold": [
            "voltage"
          ]
        }
      },
      {
        "id": "three-readings",
        "prompt": {
          "en": "Keep the resistance fixed. Record the current at three different battery voltages.",
          "hi": "प्रतिरोध एक जैसा रखें। तीन अलग-अलग विभवांतर पर धारा की रीडिंग दर्ज करें।"
        },
        "hint": {
          "en": "Change only the battery voltage, then tap Record reading each time.",
          "hi": "केवल बैटरी का विभवांतर बदलें, फिर हर बार रीडिंग दर्ज करें दबाएँ।"
        },
        "check": {
          "kind": "readings",
          "quantity": "current",
          "count": 3,
          "distinctBy": "voltage",
          "sameBy": [
            "resistance"
          ]
        }
      },
      {
        "id": "parallel-one-amp",
        "prompt": {
          "en": "Connect the two resistors in parallel and make the current 1 A.",
          "hi": "दोनों प्रतिरोधकों को पार्श्वक्रम में जोड़ें और धारा 1 A कीजिए।"
        },
        "hint": {
          "en": "Two resistors in parallel have a smaller total resistance than either one.",
          "hi": "पार्श्वक्रम में जुड़े दो प्रतिरोधकों का कुल प्रतिरोध हर एक से कम होता है।"
        },
        "check": {
          "kind": "all",
          "of": [
            {
              "kind": "condition",
              "rule": "arrangement",
              "args": {
                "is": "parallel"
              }
            },
            {
              "kind": "condition",
              "rule": "switch_on"
            },
            {
              "kind": "target",
              "quantity": "current",
              "value": 1,
              "tolerance": 0.01
            }
          ]
        }
      }
    ],
    "readings": [
      {
        "name": "voltage",
        "unit": "V",
        "label": {
          "en": "Battery voltage",
          "hi": "बैटरी का विभवांतर"
        }
      },
      {
        "name": "resistance",
        "unit": "Ω",
        "label": {
