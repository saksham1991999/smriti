<?xml version="1.0" encoding="utf-8"?>
<!-- Shown before the app has written a payload (or after sign-out). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/smriti_widget_placeholder"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:visibility="gone">

    <ImageView
        android:id="@+id/smriti_widget_placeholder_image"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:scaleType="fitCenter" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/smriti_widget_placeholder"
        android:textColor="@color/smriti_widget_ink"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
