<?xml version="1.0" encoding="utf-8"?>
<!-- The plant, the streak and the plant line: shared by the three widget sizes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/smriti_widget_plant_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/smriti_widget_streak"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/smriti_widget_streak_text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/smriti_widget_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/smriti_widget_ink_muted"
        android:textSize="12sp" />
</LinearLayout>
