<?xml version="1.0" encoding="utf-8"?>
<!-- NTF-09 medium widget: plant and streak, the pet, today's progress and one action. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/smriti_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/smriti_widget_background"
    android:padding="12dp">

    <include layout="@layout/smriti_widget_placeholder" />

    <LinearLayout
        android:id="@+id/smriti_widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <include layout="@layout/smriti_widget_plant_block" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/smriti_widget_pet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/smriti_widget_pet_image"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/smriti_widget_pet_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textColor="@color/smriti_widget_ink"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/smriti_widget_progress_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:maxLines="1"
                android:textColor="@color/smriti_widget_ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/smriti_widget_progress_bar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="4dp"
                android:importantForAccessibility="no"
                android:max="100"
                android:progressBackgroundTint="@color/smriti_widget_track"
                android:progressTint="@color/smriti_widget_accent" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/smriti_widget_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="32dp"
                android:background="@drawable/smriti_widget_pill"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/smriti_widget_on_accent"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
