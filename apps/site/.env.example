# Marketing site (apps/site). Build-time only; none of these are secrets.
# Values for each environment live in Cloudflare Pages settings.

# Canonical origin of this site, used for canonical, hreflang, sitemap and OG URLs.
# Empty: https://<domain> from packages/config/brand.json.
SITE_URL=
# Origin of the web app; CTAs hand off to $WEB_APP_URL/start and Sign in to /login.
# Empty: https://app.<domain> from packages/config/brand.json.
WEB_APP_URL=

# Store links for the "Get the app" section, once each app is published. Comma-separated
# variant=url pairs (variants: all, jee, neet, upsc, ssc). Play URLs must be the listing for the
# variant's androidPackage; App Store URLs an apps.apple.com app page. A variant without one
# shows "coming soon" as text.
STORE_URLS_PLAY=
STORE_URLS_IOS=

# Brand strings ("Smriti" is a working name).
BRAND_NAME_EN=
BRAND_NAME_HI=
BRAND_LEGAL_NAME=
BRAND_SUPPORT_EMAIL=

# Prices shown on the site, tax-inclusive rupees. Must match the billing plan config.
PRICE_PRO_MONTHLY_INR=
PRICE_PRO_INTRO_INR=

# Cookie-free analytics collector. Empty means the typed no-op transport.
SITE_ANALYTICS_ENDPOINT=

# 1 on previews: robots.txt disallows everything and pages carry noindex.
SITE_NOINDEX=

# Path to the published site-index@1 JSON from the content engine.
# Empty: the publisher's local output (tools/content-publish/out/site-index.json) when it
# exists, else the clearly marked local fixture (placeholder names and a banner).
# `fixture` forces the local fixture (the e2e smoke tests expect its pages).
# When the publish-report.json next to the index says "site_index": null (nothing released),
# the site builds with no exam pages and shows "coming soon" instead.
CONTENT_INDEX_PATH=
# 1 in production: the build fails if CONTENT_INDEX_PATH is missing or invalid.
SITE_REQUIRE_CONTENT_INDEX=

# App link files written into dist/.well-known by tools/deploy/src/app-links-cli.ts after the
# build (deploy-web.yml). APPLE_TEAM_ID (root .env.example) is needed for the iOS file.
# production | staging: production bundle ids, or the .preview ones
APP_LINKS_ENV=
# variant=SHA256|SHA256,... from Play Console > App integrity > App signing (public values)
ANDROID_APP_LINK_CERTS=
