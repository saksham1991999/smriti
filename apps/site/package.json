{
  "name": "@smriti/site",
  "private": true,
  "type": "module",
  "description": "Astro marketing and SEO site (static output): home, exam/subject/chapter/topic landing pages, legal drafts, React islands.",
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "dev": "node scripts/prepare-assets.mjs && astro dev",
    "build": "node scripts/prepare-assets.mjs && astro build",
    "preview": "node scripts/serve-dist.mjs 4321 dist",
    "typecheck": "astro check && tsc --noEmit -p .",
    "lint": "node scripts/lint.mjs",
    "test": "vitest run",
    "test:links": "node scripts/check-links.mjs dist",
    "test:e2e": "playwright test",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@astrojs/react": "7.0.1",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/noto-sans-devanagari": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@phosphor-icons/core": "2.1.1",
    "@phosphor-icons/react": "2.1.10",
    "astro": "7.3.8",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "sharp": "0.35.5",
    "typescript": "5.6.3",
    "vitest": "5.0.4"
  }
}
