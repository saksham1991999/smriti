---
// Inline Phosphor icon (MIT), read from @phosphor-icons/core at build time. No icon font, no
// runtime JS. Decorative by default; pass `label` when the icon carries meaning on its own.
import { readFileSync } from "node:fs";
import { createRequire } from "node:module";
import { join } from "node:path";

interface Props {
  name: string;
  weight?: "bold" | "fill" | "regular";
  size?: 16 | 20 | 24 | 32;
  label?: string;
  class?: string;
}

const { name, weight = "bold", size = 24, label, class: className } = Astro.props;
const req = createRequire(join(process.cwd(), "package.json"));
const file = weight === "regular" ? `${name}.svg` : `${name}-${weight}.svg`;
const svg = readFileSync(req.resolve(`@phosphor-icons/core/assets/${weight}/${file}`), "utf8");
const viewBox = svg.match(/viewBox="([^"]+)"/)?.[1] ?? "0 0 256 256";
const inner = svg.replace(/^[\s\S]*?<svg[^>]*>/, "").replace(/<\/svg>\s*$/, "");
---

<svg
  class:list={["ic", className]}
  width={size}
  height={size}
  viewBox={viewBox}
  fill="currentColor"
  aria-hidden={label ? undefined : "true"}
  role={label ? "img" : undefined}
  aria-label={label}
  focusable="false"
  set:html={inner}
/>
