---
// Honest pricing (R33, R38): price as live text, tax-inclusive, the ₹1 month only "for
// eligible new accounts" because only the app can check eligibility. No countdowns, no
// anchors, no "% off". Gold is used only for the ₹1 offer tag (R11).
import Art from "./Art.astro";
import Icon from "./Icon.astro";
import { site, type Locale } from "../config/site";
import { fmt, formatNumber, messages } from "../i18n";
import { startUrl } from "../lib/urls";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const m = messages(lang);
const p = m.pricing;
const brand = site.brand.name[lang];
const price = formatNumber(lang, site.pricing.monthlyInr);
const intro = formatNumber(lang, site.pricing.introInr);
const start = startUrl(site.webAppUrl, { lang, placement: "pricing" });
---

<section class="section pricing" id="pricing" aria-labelledby="pricing-title">
  <div class="wrap">
    <div class="pricing-head">
      <div class="section-head">
        <h2 id="pricing-title" class="t-display">{p.heading}</h2>
        <p class="t-lead muted">{p.sub}</p>
      </div>
      <Art name="cat-price-tag" lang={lang} decorative sizes="160px" class="price-art" />
    </div>
    <div class="plans-grid">
      <article class="plan card" aria-labelledby="plan-free">
        <h3 id="plan-free" class="t-heading">{p.freeName}</h3>
        <p class="price"><span class="amount num">{p.freePrice}</span></p>
        <p class="muted">{p.freeLine}</p>
        <a class="btn secondary" href={start} data-cta="start" data-placement="pricing">{p.cta}</a>
      </article>
      <article class="plan card pro" aria-labelledby="plan-pro">
        <h3 id="plan-pro" class="t-heading"><span class="chip pro"><Icon name="star" weight="fill" size={16} />{p.proName}</span></h3>
        <p class="price">
          <span class="amount num">{fmt(p.price, { price })}</span>
          <span class="per">{p.perMonth}</span>
        </p>
        <p class="tax t-label">{p.taxLine}</p>
        <p class="intro">
          <Icon name="tag" weight="fill" size={20} />
          <span>{fmt(p.introLine, { intro })}</span>
        </p>
        <ul class="facts" role="list">
          <li><Icon name="bell" size={20} /><span>{p.remindLine}</span></li>
          <li><Icon name="x-circle" size={20} /><span>{p.cancelLine}</span></li>
          <li><Icon name="credit-card" size={20} /><span>{p.payLine}</span></li>
          <li><Icon name="devices" size={20} /><span>{fmt(p.sharedLine, { brand })}</span></li>
        </ul>
        <a class="btn" href={start} data-cta="start" data-placement="pricing">{p.cta}</a>
      </article>
    </div>
  </div>
</section>

<style>
  .pricing {
    background: var(--surface);
    border-block: 1px solid var(--line);
  }
  .pricing-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
  }
  .pricing-head :global(.price-art) {
    width: 110px;
    flex: none;
    margin-bottom: 16px;
  }
  @media (min-width: 1024px) {
    .pricing-head :global(.price-art) {
      width: 160px;
    }
  }
  .plans-grid {
    display: grid;
    gap: 16px;
  }
  @media (min-width: 768px) {
    .plans-grid {
      grid-template-columns: 1fr 1.35fr;
      gap: 20px;
      align-items: start;
    }
  }
  .plan {
    display: grid;
    gap: 14px;
    padding: 24px;
    border-radius: var(--r-card-large);
    background: var(--bg);
  }
  .plan.pro {
    background: var(--surface);
    border: 2px solid var(--primary);
    box-shadow: var(--sh-raised);
  }
  .price {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .amount {
    font-size: 48px;
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .per {
    font-size: var(--fs-heading);
    font-weight: 700;
    color: var(--ink-muted);
  }
  .tax {
    color: var(--ink-muted);
    margin-top: -8px;
  }
  .intro {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 12px 14px;
    border-radius: var(--r-md);
    background: var(--streak-tint);
    color: var(--ink);
    font-weight: 600;
  }
  .intro :global(.ic) {
    color: var(--streak-text);
    margin-top: 2px;
  }
  .facts {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .facts li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    color: var(--ink);
  }
  .facts :global(.ic) {
    color: var(--primary-text);
    margin-top: 2px;
  }
  .plan .btn {
    justify-self: start;
  }
  @media (max-width: 599px) {
    .plan .btn {
      justify-self: stretch;
    }
  }
</style>
