# Public client config for apps/web (names only; values live in Cloudflare). See packages/config env.ts.
VITE_APP_ENV=local
VITE_APP_VARIANT=all
# dev = /v1/dev/auth/* on a local API; supabase = Supabase Auth (needs the two SUPABASE values)
VITE_AUTH_MODE=dev
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_CDN_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GOOGLE_WEB_CLIENT_ID=
VITE_TURNSTILE_SITE_KEY=
VITE_SENTRY_DSN=
VITE_ANALYTICS_URL=
# Billing needs no client config: the API's /v1/billing/razorpay/subscription returns the Razorpay
# key id, and "rzp_test_fake" (APP_ENV=local) switches the checkout to the API's FakeRazorpay.
# 1 = run against the in-process fake API (dev and e2e builds only; production builds refuse it)
VITE_FAKE_API=
