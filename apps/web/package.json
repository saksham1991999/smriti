{
  "name": "@smriti/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Smriti web app: React 19 + Vite SPA on the shared packages (TRD §4.2).",
  "scripts": {
    "predev": "pnpm --filter @smriti/tokens build && node scripts/copy-sims.mjs",
    "dev": "vite --mode fake",
    "dev:api": "vite",
    "prebuild": "pnpm --filter @smriti/tokens build && node scripts/copy-sims.mjs",
    "build": "tsc --noEmit -p . && vite build",
    "build:e2e": "pnpm --filter @smriti/tokens build && node scripts/copy-sims.mjs && vite build --mode e2e --outDir dist-e2e",
    "preview": "vite preview",
    "preview:e2e": "vite preview --mode e2e --outDir dist-e2e --port 4317 --strictPort",
    "size": "node scripts/bundle-size.mjs",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "pnpm run build:e2e && playwright test"
  },
  "dependencies": {
    "@smriti/analytics": "workspace:*",
    "@smriti/api-client": "workspace:*",
    "@smriti/app-core": "workspace:*",
    "@smriti/config": "workspace:*",
    "@smriti/content-schema": "workspace:*",
    "@smriti/i18n": "workspace:*",
    "@smriti/lesson-core": "workspace:*",
    "@smriti/lesson-player-web": "workspace:*",
    "@smriti/sim-bridge": "workspace:*",
    "@smriti/tokens": "workspace:*",
    "@smriti/ui-web": "workspace:*",
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-router": "1.170.44",
    "dexie": "4.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "msw": "3.0.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.4"
  }
}
