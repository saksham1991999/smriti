    {
      "locale": "en",
      "audio": "audio.mango-treat.song-en",
      "lines": [
        {
          "text": "Plop! A mango on the ground,"
        },
        {
          "text": "One little squirrel, look what she found! One!",
          "action": "count"
        },
        {
          "text": "One more comes, a myna. Two!",
          "action": "count"
        },
        {
          "text": "One more comes, a parrot. Three!",
          "action": "count"
        },
        {
          "text": "One more comes, a sparrow. Four!",
          "action": "count"
        },
        {
          "text": "One more comes, a crow. Five!",
          "action": "count"
        },
        {
          "text": "One more comes, a pigeon. Six!",
          "action": "count"
        },
        {
          "text": "One more comes, a koel. Seven!",
          "action": "count"
        },
        {
          "text": "One more comes, a kingfisher. Eight!",
          "action": "count"
        },
        {
          "text": "One more comes, a peacock. Nine!",
          "action": "count"
        },
        {
          "text": "Count with me and clap with me:",
          "action": "clap"
        },
        {
          "text": "One, two, three, four, five,",
          "action": "count"
        },
        {
          "text": "Six, seven, eight and nine!",
          "action": "count"
        },
        {
          "text": "Nine good friends, and mangoes fine!",
          "action": "clap"
        }
      ]
    },
    {
      "locale": "hi",
      "audio": "audio.mango-treat.song-hi",
      "lines": [
        {
          "text": "टप! गिरा एक आम रसीला,"
        },
        {
          "text": "एक गिलहरी ने उसे पाया। एक!",
          "action": "count"
        },
        {
          "text": "एक और आई, मैना। दो!",
          "action": "count"
        },
        {
          "text": "एक और आया, तोता। तीन!",
          "action": "count"
        },
        {
          "text": "एक और आई, गौरैया। चार!",
          "action": "count"
        },
        {
          "text": "एक और आया, कौआ। पाँच!",
          "action": "count"
        },
        {
          "text": "एक और आया, कबूतर। छह!",
          "action": "count"
        },
        {
          "text": "एक और आई, कोयल। सात!",
          "action": "count"
        },
        {
          "text": "एक और आया, किलकिला। आठ!",
          "action": "count"
        },
        {
          "text": "एक और आया, मोर। नौ!",
          "action": "count"
        },
        {
          "text": "गिनो मेरे साथ, ताली बजाओ:",
          "action": "clap"
        },
        {
          "text": "एक, दो, तीन, चार, पाँच,",
          "action": "count"
        },
        {
          "text": "छह, सात, आठ और नौ!",
          "action": "count"
        },
        {
          "text": "नौ दोस्त और मीठे आम!",
          "action": "clap"
        }
