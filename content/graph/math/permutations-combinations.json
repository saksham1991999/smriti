      "id": "math.permutations-combinations.counting-principle",
      "name": {
        "en": "Fundamental Principle of Counting",
        "hi": "गणना का आधारभूत सिद्धांत"
      },
      "hi_source": "ncert",
      "ncert_refs": [
        "NCERT Class 11 Mathematics, Ch 6 §6.2"
      ],
      "subtopics": [
        {
          "id": "math.permutations-combinations.counting-principle.core",
          "name": {
            "en": "Fundamental Principle of Counting",
            "hi": "गणना का आधारभूत सिद्धांत"
          },
          "concepts": [
            {
              "id": "math.permutations-combinations.counting-principle.core.fundamental-counting",
              "name": {
                "en": "Fundamental principle of counting",
                "hi": "गणना का आधारभूत सिद्धांत"
              },
              "kind": "formula",
              "intrinsic_depth": 2,
              "summary": {
                "en": "If one event can occur in m ways and, after it, another in n ways, the two can occur together in m × n ways; the rule extends to any number of events.",
                "hi": "यदि एक घटना m प्रकार से और उसके बाद दूसरी n प्रकार से घटित हो सकती है, तो दोनों मिलकर m × n प्रकार से घटित हो सकती हैं; यह नियम कितनी भी घटनाओं पर लागू होता है।"
              },
              "key_points": [
                {
                  "en": "Count arrangements with and without repetition using the principle.",
                  "hi": "इस सिद्धांत से पुनरावृत्ति सहित और रहित विन्यास गिनिए।"
                },
                {
                  "en": "Recognise when cases must be added rather than multiplied.",
                  "hi": "पहचानिए कि कब स्थितियों को गुणा करने के बजाय जोड़ना है।"
                }
              ],
              "prerequisites": [],
              "related": [],
