      "subtopics": [
        {
          "id": "math.permutations-combinations.combinations.core",
          "name": {
            "en": "Combinations",
            "hi": "संचय"
          },
          "concepts": [
            {
              "id": "math.permutations-combinations.combinations.core.combinations-ncr",
              "name": {
                "en": "Combinations and C(n, r)",
                "hi": "संचय तथा C(n, r)"
              },
              "kind": "formula",
              "intrinsic_depth": 3,
              "summary": {
                "en": "The number of selections of r objects from n distinct objects is C(n, r) = n!/(r!(n − r)!), with C(n, r) = C(n, n − r) and C(n, r) + C(n, r − 1) = C(n + 1, r).",
                "hi": "n भिन्न वस्तुओं में से r वस्तुओं के चयनों की संख्या C(n, r) = n!/(r!(n − r)!) है, जहाँ C(n, r) = C(n, n − r) और C(n, r) + C(n, r − 1) = C(n + 1, r)।"
              },
              "key_points": [
                {
                  "en": "Decide whether a problem needs arrangement or selection.",
                  "hi": "तय कीजिए कि प्रश्न में विन्यास चाहिए या चयन।"
                },
                {
                  "en": "Solve committee and selection problems with conditions.",
                  "hi": "शर्तों वाले समिति और चयन प्रश्न हल कीजिए।"
                }
              ],
              "prerequisites": [
