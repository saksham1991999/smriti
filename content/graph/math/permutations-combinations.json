                "jee-main-2027:mathematics:unit-4:item-1"
              ],
              "ncert_refs": [
                "NCERT Class 11 Mathematics, Ch 6 §6.2"
              ],
              "hi_source": "translated"
            }
          ]
        }
      ]
    },
    {
      "id": "math.permutations-combinations.permutations",
      "name": {
        "en": "Permutations",
        "hi": "क्रमचय"
      },
      "hi_source": "ncert",
      "ncert_refs": [
        "NCERT Class 11 Mathematics, Ch 6 §6.3"
      ],
      "subtopics": [
        {
          "id": "math.permutations-combinations.permutations.core",
          "name": {
            "en": "Permutations",
            "hi": "क्रमचय"
          },
          "concepts": [
            {
              "id": "math.permutations-combinations.permutations.core.permutations-npr",
              "name": {
                "en": "Permutations, factorial notation and P(n, r)",
                "hi": "क्रमचय, क्रमगुणित संकेतन तथा P(n, r)"
              },
              "kind": "formula",
              "intrinsic_depth": 3,
              "summary": {
                "en": "The number of arrangements of r objects chosen from n distinct objects is P(n, r) = n!/(n − r)!; when some objects repeat, n! is divided by the factorials of the repeat counts.",
                "hi": "n भिन्न वस्तुओं में से r वस्तुओं के विन्यासों की संख्या P(n, r) = n!/(n − r)! है; जब कुछ वस्तुएँ दोहराती हों, तो n! को पुनरावृत्ति-संख्याओं के क्रमगुणितों से भाग दिया जाता है।"
              },
              "key_points": [
                {
                  "en": "Count arrangements of letters of a word with repeated letters.",
                  "hi": "दोहराए गए अक्षरों वाले शब्द के अक्षरों के विन्यास गिनिए।"
                },
                {
                  "en": "Handle restrictions such as objects that must stay together.",
                  "hi": "साथ रहने वाली वस्तुओं जैसे प्रतिबंधों को सँभालिए।"
                }
              ],
              "prerequisites": [
                "math.permutations-combinations.counting-principle.core.fundamental-counting"
              ],
              "related": [],
              "syllabus_refs": [
                "jee-main-2027:mathematics:unit-4:item-2"
              ],
              "ncert_refs": [
                "NCERT Class 11 Mathematics, Ch 6 §6.3"
              ],
              "hi_source": "translated"
            }
          ]
        }
      ]
    },
    {
      "id": "math.permutations-combinations.combinations",
