    {
      "id": "math.relations-functions-intro.cartesian-product:qr:06",
      "type": "summary",
      "concepts": [
        "math.relations-functions-intro.cartesian-product.core.cartesian-product-sets"
      ],
      "depth": 1,
      "points": [
        {
          "en": "$A \\times B$: all ordered pairs from A then B; $n(A \\times B) = n(A) \\cdot n(B)$.",
          "hi": "$A \\times B$: पहले A फिर B से सभी क्रमित युग्म; $n(A \\times B) = n(A) \\cdot n(B)$।"
        }
      ]
    },
    {
      "id": "math.relations-functions-intro.cartesian-product:qr:07",
      "type": "common_traps",
      "concepts": [
        "math.relations-functions-intro.cartesian-product.core.cartesian-product-sets"
      ],
      "depth": 1,
      "title": {
        "en": "Common traps",
        "hi": "आम गलतियाँ"
      },
      "traps": [
        {
          "mistake": {
            "en": "$A \\times B$ and $B \\times A$ are the same set.",
            "hi": "$A \\times B$ और $B \\times A$ एक ही समुच्चय हैं।"
          },
          "correct": {
            "en": "They have the same number of elements, but $(a, b) \\ne (b, a)$ in general.",
            "hi": "इनमें अवयवों की संख्या समान है, पर सामान्यतः $(a, b) \\ne (b, a)$।"
          }
        },
        {
          "mistake": {
            "en": "$n(A \\times B) = n(A) + n(B)$.",
            "hi": "$n(A \\times B) = n(A) + n(B)$।"
          },
          "correct": {
            "en": "The counts multiply: $n(A \\times B) = n(A) \\cdot n(B)$.",
            "hi": "गिनतियों का गुणा होता है: $n(A \\times B) = n(A) \\cdot n(B)$।"
          }
        },
        {
          "mistake": {
            "en": "A product with the empty set keeps the other set.",
            "hi": "रिक्त समुच्चय के साथ गुणन दूसरा समुच्चय बचा रखता है।"
          },
          "correct": {
            "en": "There is nothing to pair with: $A \\times \\phi = \\phi$.",
            "hi": "जोड़ने के लिए कुछ नहीं है: $A \\times \\phi = \\phi$।"
          }
        }
      ]
    }
  ],
