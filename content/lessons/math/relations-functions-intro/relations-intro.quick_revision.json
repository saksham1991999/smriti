    {
      "id": "math.relations-functions-intro.relations-intro:qr:07",
      "type": "summary",
      "concepts": [
        "math.relations-functions-intro.relations-intro.core.relation-domain-range"
      ],
      "depth": 1,
      "points": [
        {
          "en": "Relation: a subset of $A \\times B$; range is a subset of codomain; $2^{pq}$ relations in all.",
          "hi": "संबंध: $A \\times B$ का उपसमुच्चय; परिसर सहप्रांत का उपसमुच्चय है; कुल $2^{pq}$ संबंध।"
        }
      ]
    },
    {
      "id": "math.relations-functions-intro.relations-intro:qr:08",
      "type": "common_traps",
      "concepts": [
        "math.relations-functions-intro.relations-intro.core.relation-domain-range"
      ],
      "depth": 1,
      "title": {
        "en": "Common traps",
        "hi": "आम गलतियाँ"
      },
      "traps": [
        {
          "mistake": {
            "en": "The range of a relation is the codomain.",
            "hi": "संबंध का परिसर उसका सहप्रांत है।"
          },
          "correct": {
            "en": "The range holds only the images actually used; it is a subset of the codomain.",
            "hi": "परिसर में केवल वास्तव में प्रयुक्त प्रतिबिंब होते हैं; यह सहप्रांत का उपसमुच्चय है।"
          }
        },
        {
          "mistake": {
            "en": "The domain of a relation from A to B is always A.",
            "hi": "A से B तक संबंध का प्रांत सदा A होता है।"
          },
          "correct": {
            "en": "Elements of A with no image are left out of the domain.",
            "hi": "जिन अवयवों का कोई प्रतिबिंब नहीं, वे प्रांत से बाहर रहते हैं।"
          }
        },
        {
          "mistake": {
            "en": "The number of relations is $pq$.",
            "hi": "संबंधों की संख्या $pq$ है।"
          },
          "correct": {
            "en": "$pq$ is the number of pairs; the number of relations is $2^{pq}$.",
            "hi": "$pq$ युग्मों की संख्या है; संबंधों की संख्या $2^{pq}$ है।"
          }
        }
      ]
    }
  ],
