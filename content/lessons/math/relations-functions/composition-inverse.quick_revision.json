    {
      "id": "math.relations-functions.composition-inverse:qr:09",
      "type": "summary",
      "concepts": [
        "math.relations-functions.composition-inverse.core.composition-functions",
        "math.relations-functions.composition-inverse.core.invertible-function"
      ],
      "depth": 1,
      "points": [
        {
          "en": "$g \\circ f$: f then g. Invertible = bijective; $f^{-1}$ by solving $y = f(x)$.",
          "hi": "$g \\circ f$: पहले f फिर g। व्युत्क्रमणीय = एकैकी आच्छादी; $f^{-1}$, $y = f(x)$ हल करके।"
        }
      ]
    },
    {
      "id": "math.relations-functions.composition-inverse:qr:10",
      "type": "common_traps",
      "concepts": [
        "math.relations-functions.composition-inverse.core.composition-functions",
        "math.relations-functions.composition-inverse.core.invertible-function"
      ],
      "depth": 1,
      "title": {
        "en": "Common traps",
        "hi": "आम गलतियाँ"
      },
      "traps": [
        {
          "mistake": {
            "en": "$g \\circ f$ means apply g first.",
            "hi": "$g \\circ f$ का अर्थ है पहले g लगाना।"
          },
          "correct": {
            "en": "f acts first: $(g \\circ f)(x) = g(f(x))$.",
            "hi": "पहले f लगता है: $(g \\circ f)(x) = g(f(x))$।"
          }
        },
        {
          "mistake": {
            "en": "$f^{-1}(x) = \\frac{1}{f(x)}$.",
            "hi": "$f^{-1}(x) = \\frac{1}{f(x)}$।"
          },
          "correct": {
            "en": "$f^{-1}$ undoes f; it is not the reciprocal.",
            "hi": "$f^{-1}$, f को उलटता है; यह व्युत्क्रम संख्या नहीं।"
          }
        },
        {
          "mistake": {
            "en": "$f(x) = x^2$ on $\\mathbf{R}$ has an inverse.",
            "hi": "$f(x) = x^2$ का, $\\mathbf{R}$ पर, प्रतिलोम है।"
          },
          "correct": {
            "en": "It is neither one-one nor onto, so it is not invertible.",
            "hi": "यह न एकैकी है न आच्छादक, इसलिए व्युत्क्रमणीय नहीं।"
          }
        }
      ]
    }
  ],
