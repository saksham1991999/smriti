    {
      "id": "math.relations-functions.function-types:qr:08",
      "type": "summary",
      "concepts": [
        "math.relations-functions.function-types.core.one-one-onto"
      ],
      "depth": 1,
      "points": [
        {
          "en": "Injective: no shared images. Surjective: no missed images. Bijective: both.",
          "hi": "अंतःक्षेपी: कोई साझा प्रतिबिंब नहीं। आच्छादी: कोई छूटा प्रतिबिंब नहीं। एकैकी आच्छादी: दोनों।"
        }
      ]
    },
    {
      "id": "math.relations-functions.function-types:qr:09",
      "type": "common_traps",
      "concepts": [
        "math.relations-functions.function-types.core.one-one-onto"
      ],
      "depth": 1,
      "title": {
        "en": "Common traps",
        "hi": "आम गलतियाँ"
      },
      "traps": [
        {
          "mistake": {
            "en": "A one-one function is always onto.",
            "hi": "एकैकी फलन सदा आच्छादक होता है।"
          },
          "correct": {
            "en": "Only for $f : X \\to X$ with X finite; $2x$ on $\\mathbf{N}$ is one-one but not onto.",
            "hi": "केवल परिमित X के लिए $f : X \\to X$ में; $2x$, $\\mathbf{N}$ पर, एकैकी है पर आच्छादक नहीं।"
          }
        },
        {
          "mistake": {
            "en": "Onto depends only on the rule.",
            "hi": "आच्छादकता केवल नियम पर निर्भर है।"
          },
          "correct": {
            "en": "It depends on the codomain too.",
            "hi": "यह सहप्रांत पर भी निर्भर है।"
          }
        },
        {
          "mistake": {
            "en": "$x^2$ is one-one on $\\mathbf{R}$.",
            "hi": "$x^2$, $\\mathbf{R}$ पर, एकैकी है।"
          },
          "correct": {
            "en": "$f(-1) = f(1) = 1$.",
            "hi": "$f(-1) = f(1) = 1$।"
          }
        }
      ]
    }
  ],
