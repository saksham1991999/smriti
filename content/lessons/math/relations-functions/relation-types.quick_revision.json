    {
      "id": "math.relations-functions.relation-types:qr:08",
      "type": "summary",
      "concepts": [
        "math.relations-functions.relation-types.core.relation-types-equivalence"
      ],
      "depth": 1,
      "points": [
        {
          "en": "Equivalence = reflexive + symmetric + transitive; its classes partition the set.",
          "hi": "तुल्यता = स्वतुल्य + सममित + संक्रामक; इसके वर्ग समुच्चय का विभाजन करते हैं।"
        }
      ]
    },
    {
      "id": "math.relations-functions.relation-types:qr:09",
      "type": "common_traps",
      "concepts": [
        "math.relations-functions.relation-types.core.relation-types-equivalence"
      ],
      "depth": 1,
      "title": {
        "en": "Common traps",
        "hi": "आम गलतियाँ"
      },
      "traps": [
        {
          "mistake": {
            "en": "A symmetric and transitive relation must be reflexive.",
            "hi": "सममित और संक्रामक संबंध अवश्य स्वतुल्य होगा।"
          },
          "correct": {
            "en": "Reflexive needs $(a, a)$ for every a; check it separately.",
            "hi": "स्वतुल्य के लिए हर a के लिए $(a, a)$ चाहिए; इसे अलग से जाँचिए।"
          }
        },
        {
          "mistake": {
            "en": "'Is perpendicular to' is transitive.",
            "hi": "'लंब है' संक्रामक है।"
          },
          "correct": {
            "en": "$L_1 \\perp L_2$ and $L_2 \\perp L_3$ make $L_1$ parallel to $L_3$.",
            "hi": "$L_1 \\perp L_2$ और $L_2 \\perp L_3$ से $L_1$, $L_3$ के समांतर होती है।"
          }
        },
        {
          "mistake": {
            "en": "Two different equivalence classes can share an element.",
            "hi": "दो भिन्न तुल्यता वर्गों में कोई अवयव साझा हो सकता है।"
          },
          "correct": {
            "en": "Equivalence classes are mutually disjoint.",
            "hi": "तुल्यता वर्ग परस्पर असंयुक्त होते हैं।"
          }
        }
      ]
    }
  ],
