      "points": [
        {
          "en": "$A \\cup B$, $A \\cap B$, $A - B$, $A'$; De Morgan swaps $\\cup$ and $\\cap$ under a complement.",
          "hi": "$A \\cup B$, $A \\cap B$, $A - B$, $A'$; डी मॉर्गन पूरक में $\\cup$ और $\\cap$ की अदला-बदली करता है।"
        }
      ]
    },
    {
      "id": "math.sets.set-operations:qr:07",
      "type": "common_traps",
      "concepts": [
        "math.sets.set-operations.core.venn-diagrams",
        "math.sets.set-operations.core.union-intersection-complement",
        "math.sets.set-operations.core.set-algebra-laws"
      ],
      "depth": 1,
      "title": {
        "en": "Common traps",
        "hi": "आम गलतियाँ"
      },
      "traps": [
        {
          "mistake": {
            "en": "$A - B$ and $B - A$ are the same set.",
            "hi": "$A - B$ और $B - A$ एक ही समुच्चय हैं।"
          },
          "correct": {
            "en": "They are different and disjoint: $A - B$ is in A only, $B - A$ in B only.",
            "hi": "वे भिन्न और असंयुक्त हैं: $A - B$ केवल A में, $B - A$ केवल B में।"
          }
        },
        {
          "mistake": {
            "en": "$(A \\cup B)' = A' \\cup B'$.",
            "hi": "$(A \\cup B)' = A' \\cup B'$।"
          },
          "correct": {
            "en": "The complement turns union into intersection: $(A \\cup B)' = A' \\cap B'$.",
            "hi": "पूरक सम्मिलन को सर्वनिष्ठ में बदलता है: $(A \\cup B)' = A' \\cap B'$।"
          }
        },
        {
          "mistake": {
            "en": "$n(A \\cup B) = n(A) + n(B)$ always.",
            "hi": "$n(A \\cup B) = n(A) + n(B)$ सदा।"
          },
          "correct": {
            "en": "Only for disjoint sets; otherwise subtract $n(A \\cap B)$.",
            "hi": "केवल असंयुक्त समुच्चयों के लिए; अन्यथा $n(A \\cap B)$ घटाइए।"
          }
        }
      ]
    }
  ],
