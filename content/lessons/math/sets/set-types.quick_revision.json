      "id": "math.sets.set-types:qr:04",
      "type": "summary",
      "concepts": [
        "math.sets.set-types.core.empty-finite-equal-sets"
      ],
      "depth": 1,
      "points": [
        {
          "en": "$\\phi$ has no element; $n(S)$ counts the distinct elements of a finite set.",
          "hi": "$\\phi$ में कोई अवयव नहीं; $n(S)$ परिमित समुच्चय के भिन्न अवयव गिनता है।"
        }
      ]
    },
    {
      "id": "math.sets.set-types:qr:05",
      "type": "common_traps",
      "concepts": [
        "math.sets.set-types.core.empty-finite-equal-sets"
      ],
      "depth": 1,
      "title": {
        "en": "Common traps",
        "hi": "आम गलतियाँ"
      },
      "traps": [
        {
          "mistake": {
            "en": "$\\{0\\}$ is the empty set.",
            "hi": "$\\{0\\}$ रिक्त समुच्चय है।"
          },
          "correct": {
            "en": "$\\{0\\}$ has one element, $0$; the empty set has none.",
            "hi": "$\\{0\\}$ में एक अवयव $0$ है; रिक्त समुच्चय में कोई नहीं।"
          }
        },
        {
          "mistake": {
            "en": "Every infinite set can be written in roster form with dots.",
            "hi": "हर अपरिमित समुच्चय बिंदुओं के साथ सूचीरूप में लिखा जा सकता है।"
          },
          "correct": {
            "en": "The set of real numbers cannot be written in roster form.",
            "hi": "वास्तविक संख्याओं का समुच्चय सूचीरूप में नहीं लिखा जा सकता।"
          }
        },
        {
          "mistake": {
            "en": "Repeating an element makes the set bigger.",
            "hi": "अवयव दोहराने से समुच्चय बड़ा हो जाता है।"
          },
          "correct": {
            "en": "$\\{1, 1, 2\\} = \\{1, 2\\}$: $n$ counts distinct elements.",
            "hi": "$\\{1, 1, 2\\} = \\{1, 2\\}$: $n$ भिन्न अवयव गिनता है।"
          }
        }
      ]
    }
