    {
      "id": "phy.current-electricity.energy-power:dd:07",
      "type": "summary",
      "concepts": [
        "phy.current-electricity.energy-power.core.electrical-power"
      ],
      "depth": 2,
      "points": [
        {
          "en": "$P = IV = I^{2}R = V^{2}/R$; unit watt (W).",
          "hi": "$P = IV = I^{2}R = V^{2}/R$; मात्रक वाट (W)।"
        },
        {
          "en": "The energy is lost in collisions and heats the conductor (ohmic loss).",
          "hi": "ऊर्जा टक्करों में खोती है और चालक को गरम करती है (ओमी क्षय)।"
        }
      ]
    },
    {
      "id": "phy.current-electricity.energy-power:dd:08",
      "type": "explainer",
      "concepts": [
        "phy.current-electricity.energy-power.core.electrical-power"
      ],
      "depth": 1,
      "title": {
        "en": "The kilowatt hour",
        "hi": "किलोवाट घंटा"
      },
      "body": {
        "en": "Energy is power times time. The commercial unit of electrical energy is the kilowatt hour (kW h), commonly called a 'unit'. 1 kW h is the energy used when 1 kW is used for 1 hour: 1 kW h $= 3.6 \\times 10^{6}$ J.",
        "hi": "ऊर्जा = शक्ति × समय। विद्युत ऊर्जा का व्यापारिक मात्रक किलोवाट घंटा (kW h) है, जिसे आम तौर पर 'यूनिट' कहते हैं। 1 kW h वह ऊर्जा है जो 1 kW को 1 घंटे तक उपयोग करने पर खर्च होती है: 1 kW h $= 3.6 \\times 10^{6}$ J।"
      },
      "media": "img.current-electricity.toaster",
      "source": {
        "kind": "ncert",
        "ref": "NCERT Class 10 Science, Ch 11 Electricity (2026-27 reprint)",
        "url": "https://ncert.nic.in/textbook/pdf/jesc111.pdf",
        "retrieved": "2026-10-30",
        "pages": "§11.8"
      }
    },
    {
      "id": "phy.current-electricity.energy-power:dd:09",
      "type": "worked_example",
      "concepts": [
        "phy.current-electricity.energy-power.core.electrical-power"
      ],
      "depth": 2,
      "problem": {
        "en": "A 1.5 kW geyser runs for 2 hours a day for 30 days. How many units does it use?",
        "hi": "एक 1.5 kW का गीज़र 30 दिन तक रोज़ 2 घंटे चलता है। यह कितनी यूनिट खर्च करता है?"
      },
      "solution_steps": [
        {
          "en": "Energy $= 1.5 \\times 2 \\times 30$ kW h",
          "hi": "ऊर्जा $= 1.5 \\times 2 \\times 30$ kW h"
        },
        {
          "en": "$= 90$ kW h, that is 90 units",
          "hi": "$= 90$ kW h, यानी 90 यूनिट"
        }
      ],
      "answer": {
        "en": "90 units",
        "hi": "90 यूनिट"
      },
      "answer_value": {
        "value": 90,
        "unit": "kWh",
        "tolerance": {
          "abs": 0.01
        }
      },
      "common_trap": {
        "en": "Using watts instead of kilowatts gives 90000, which is in W h, not units.",
        "hi": "किलोवाट की जगह वाट लेने पर 90000 आता है, जो W h में है, यूनिट में नहीं।"
      }
    },
