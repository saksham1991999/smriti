    {
      "id": "phy.current-electricity.energy-power:dd:05",
      "type": "worked_example",
      "concepts": [
        "phy.current-electricity.energy-power.core.electrical-power"
      ],
      "depth": 2,
      "problem": {
        "en": "A heater is rated 1000 W on 230 V. Find the current it draws and its resistance when working.",
        "hi": "एक हीटर 230 V पर 1000 W का है। काम करते समय उसकी धारा और प्रतिरोध ज्ञात कीजिए।"
      },
      "solution_steps": [
        {
          "en": "$I = \\frac{P}{V} = \\frac{1000}{230} = 4.35$ A",
          "hi": "$I = \\frac{P}{V} = \\frac{1000}{230} = 4.35$ A"
        },
        {
          "en": "$R = \\frac{V^{2}}{P} = \\frac{230^{2}}{1000} = 52.9$ Ω",
          "hi": "$R = \\frac{V^{2}}{P} = \\frac{230^{2}}{1000} = 52.9$ Ω"
        }
      ],
      "answer": {
        "en": "4.35 A and 52.9 Ω",
        "hi": "4.35 A और 52.9 Ω"
      },
      "answer_value": {
        "value": 52.9,
        "unit": "Ω",
        "tolerance": {
          "abs": 0.2
        }
      }
    },
