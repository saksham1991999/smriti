  "cards": [
    {
      "id": "phy.current-electricity.energy-power:dd:01",
      "type": "story",
      "concepts": [
        "phy.current-electricity.energy-power.core.electrical-power"
      ],
      "depth": 1,
      "title": {
        "en": "Hot element, cool cable",
        "hi": "गरम तत्व, ठंडा तार"
      },
      "body": {
        "en": "The toaster's element glows, yet the cable feeding it stays cool. Both carry the same current. Where does the energy go, and why mostly into the element?",
        "hi": "टोस्टर का तत्व चमकता है, फिर भी उसे जोड़ने वाला तार ठंडा रहता है। दोनों में एक ही धारा है। ऊर्जा कहाँ जाती है, और ज़्यादातर तत्व में ही क्यों?"
      },
      "media": "img.current-electricity.toaster"
    },
    {
      "id": "phy.current-electricity.energy-power:dd:02",
      "type": "explainer",
      "concepts": [
        "phy.current-electricity.energy-power.core.electrical-power"
      ],
      "depth": 2,
      "title": {
        "en": "Energy lost in collisions",
        "hi": "टक्करों में खोई ऊर्जा"
      },
      "body": {
        "en": "When a charge $\\Delta Q$ moves through a potential drop $V$, its potential energy falls by $\\Delta Q\\,V$. In a conductor the charges do not speed up for long: they lose the energy in collisions with the ions, and it heats the conductor.\n\nThe energy dissipated per unit time is the power, $P = IV$. In a resistor this heating is called ohmic loss.",
        "hi": "जब आवेश $\\Delta Q$ विभव-पतन $V$ से गुज़रता है, उसकी स्थितिज ऊर्जा $\\Delta Q\\,V$ घटती है। चालक में आवेश लंबे समय तक तेज़ नहीं होते: वे आयनों से टक्कर में यह ऊर्जा खो देते हैं, और चालक गरम होता है।\n\nप्रति एकांक समय क्षयित ऊर्जा शक्ति है, $P = IV$। प्रतिरोधक में इस तापन को ओमी क्षय कहते हैं।"
      },
      "media": "img.current-electricity.toaster",
      "source": {
        "kind": "ncert",
        "ref": "NCERT Class 12 Physics Part I, Ch 3 Current Electricity (2026-27 reprint)",
        "url": "https://ncert.nic.in/textbook/pdf/leph103.pdf",
        "retrieved": "2026-10-29",
        "pages": "§3.9"
      }
    },
    {
      "id": "phy.current-electricity.energy-power:dd:03",
      "type": "derivation",
      "concepts": [
        "phy.current-electricity.energy-power.core.electrical-power"
      ],
      "depth": 2,
      "title": {
        "en": "Three forms of power",
        "hi": "शक्ति के तीन रूप"
      },
      "steps": [
        {
          "latex": "\\Delta W = (I\\Delta t)V",
          "say": {
            "en": "Charge $I\\Delta t$ falls through potential $V$.",
            "hi": "आवेश $I\\Delta t$ विभव $V$ से गिरता है।"
          },
          "why": null
        },
        {
          "latex": "P = \\frac{\\Delta W}{\\Delta t} = IV",
          "say": {
            "en": "Divide by time.",
            "hi": "समय से भाग दें।"
          },
          "why": null
        },
        {
          "latex": "P = I^{2}R = \\frac{V^{2}}{R}",
          "say": {
            "en": "Use $V = IR$ to write it two more ways.",
            "hi": "$V = IR$ से इसे दो और तरह लिखें।"
          },
          "why": null
        }
      ],
      "source": {
        "kind": "ncert",
        "ref": "NCERT Class 12 Physics Part I, Ch 3 Current Electricity (2026-27 reprint)",
        "url": "https://ncert.nic.in/textbook/pdf/leph103.pdf",
        "retrieved": "2026-10-29",
        "pages": "§3.9"
      }
    },
