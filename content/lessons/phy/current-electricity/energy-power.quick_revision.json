        "phy.current-electricity.energy-power.core.electrical-power"
      ],
      "depth": 1,
      "points": [
        {
          "en": "$P = IV = I^{2}R = V^{2}/R$.",
          "hi": "$P = IV = I^{2}R = V^{2}/R$।"
        },
        {
          "en": "Energy in units: kW × hours.",
          "hi": "यूनिट में ऊर्जा: kW × घंटे।"
        },
        {
          "en": "Higher transmission voltage, smaller line loss ($\\propto 1/V^{2}$).",
          "hi": "उच्च संचरण वोल्टता, कम लाइन क्षय ($\\propto 1/V^{2}$)।"
        }
      ]
    },
    {
      "id": "phy.current-electricity.energy-power:qr:04",
      "type": "common_traps",
      "concepts": [
        "phy.current-electricity.energy-power.core.electrical-power"
      ],
      "depth": 1,
      "title": {
        "en": "Common traps",
        "hi": "आम गलतियाँ"
      },
      "traps": [
        {
          "mistake": {
            "en": "Multiplying watts by hours and calling it units.",
            "hi": "वाट को घंटों से गुणा करके यूनिट कहना।"
          },
          "correct": {
            "en": "Units are kilowatt hours; convert W to kW first.",
            "hi": "यूनिट किलोवाट घंटे हैं; पहले W को kW में बदलिए।"
          }
        },
        {
          "mistake": {
            "en": "Line loss falls in proportion to the voltage.",
            "hi": "लाइन क्षय वोल्टता के अनुपात में घटता है।"
          },
          "correct": {
            "en": "It falls as $1/V^{2}$: ten times the voltage, one hundredth the loss.",
            "hi": "यह $1/V^{2}$ के अनुसार घटता है: दस गुनी वोल्टता, सौवाँ भाग क्षय।"
          }
        }
      ]
    }
