        {
          "en": "$\\Sigma I_{in} = \\Sigma I_{out}$ at a junction.",
          "hi": "संधि पर $\\Sigma I_{in} = \\Sigma I_{out}$।"
        },
        {
          "en": "$\\Sigma \\Delta V = 0$ round any closed loop.",
          "hi": "किसी भी बंद पाश में $\\Sigma \\Delta V = 0$।"
        }
      ]
