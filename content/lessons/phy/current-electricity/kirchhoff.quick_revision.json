      ],
      "depth": 1,
      "title": {
        "en": "Common traps",
        "hi": "आम गलतियाँ"
      },
      "traps": [
        {
          "mistake": {
            "en": "Changing the assumed direction of a current halfway through.",
            "hi": "बीच में ही किसी धारा की मानी गई दिशा बदल देना।"
          },
          "correct": {
            "en": "Keep each assumed direction for all equations.",
            "hi": "हर मानी गई दिशा सभी समीकरणों में वही रखें।"
          }
        },
        {
          "mistake": {
            "en": "Adding $+IR$ when going through a resistor along the current.",
            "hi": "धारा की दिशा में प्रतिरोधक पार करते समय $+IR$ जोड़ना।"
          },
          "correct": {
            "en": "Along the current the potential falls: write $-IR$.",
            "hi": "धारा की दिशा में विभव घटता है: $-IR$ लिखें।"
          }
        }
      ]
