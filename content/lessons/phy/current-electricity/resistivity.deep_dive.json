  "cards": [
    {
      "id": "phy.current-electricity.resistivity:dd:01",
      "type": "explainer",
      "concepts": [
        "phy.current-electricity.resistivity.core.resistivity-conductivity"
      ],
      "depth": 2,
      "title": {
        "en": "Longer wire, more resistance; thicker wire, less",
        "hi": "लंबा तार, अधिक प्रतिरोध; मोटा तार, कम"
      },
      "body": {
        "en": "Compare the short thin wire with the long thin one: the same current must flow through twice the length, so the potential difference doubles and the resistance doubles: $R \\propto l$.\n\nNow compare the long thin wire with the long thick one: a larger cross-section is like several thin strips side by side, each carrying part of the current, so $R \\propto 1/A$. Together $R = \\rho l/A$, where $\\rho$, the resistivity, depends only on the material (and its temperature).",
        "hi": "छोटे पतले तार की तुलना लंबे पतले तार से कीजिए: उतनी ही धारा को दोगुनी लंबाई से गुज़रना है, इसलिए विभवांतर दोगुना और प्रतिरोध दोगुना होता है: $R \\propto l$।\n\nअब लंबे पतले तार की तुलना लंबे मोटे तार से कीजिए: बड़ी अनुप्रस्थ काट कई पतली पट्टियों के साथ-साथ रखे होने जैसी है, हर एक धारा का कुछ भाग ले जाती है, इसलिए $R \\propto 1/A$। दोनों मिलाकर $R = \\rho l/A$, जहाँ प्रतिरोधकता $\\rho$ केवल पदार्थ (और उसके ताप) पर निर्भर है।"
      },
      "media": "img.current-electricity.slabs",
      "source": {
        "kind": "ncert",
        "ref": "NCERT Class 12 Physics Part I, Ch 3 Current Electricity (2026-27 reprint)",
        "url": "https://ncert.nic.in/textbook/pdf/leph103.pdf",
        "retrieved": "2026-10-29",
        "pages": "§3.4"
      }
    },
    {
      "id": "phy.current-electricity.resistivity:dd:02",
      "type": "formula",
      "concepts": [
        "phy.current-electricity.resistivity.core.resistivity-conductivity"
      ],
      "depth": 2,
      "title": {
        "en": "Resistance of a wire",
        "hi": "तार का प्रतिरोध"
      },
      "latex": "R = \\rho \\frac{l}{A}",
      "symbols": [
        {
          "symbol": "R",
          "meaning": {
            "en": "resistance",
            "hi": "प्रतिरोध"
          },
          "unit": "Ω"
        },
        {
          "symbol": "\\rho",
          "meaning": {
            "en": "resistivity",
            "hi": "प्रतिरोधकता"
          },
          "unit": "Ω m"
        },
        {
          "symbol": "l",
          "meaning": {
            "en": "length",
            "hi": "लंबाई"
          },
          "unit": "m"
        },
        {
          "symbol": "A",
          "meaning": {
            "en": "area of cross-section",
            "hi": "अनुप्रस्थ काट का क्षेत्रफल"
          },
          "unit": "m^2"
        }
      ],
      "source": {
        "kind": "ncert",
        "ref": "NCERT Class 12 Physics Part I, Ch 3 Current Electricity (2026-27 reprint)",
        "url": "https://ncert.nic.in/textbook/pdf/leph103.pdf",
        "retrieved": "2026-10-29",
        "pages": "§3.4"
      }
    },
    {
      "id": "phy.current-electricity.resistivity:dd:03",
      "type": "explainer",
      "concepts": [
        "phy.current-electricity.resistivity.core.resistivity-conductivity"
      ],
      "depth": 2,
      "title": {
        "en": "Current density and conductivity",
        "hi": "धारा घनत्व और चालकता"
      },
      "body": {
        "en": "Current per unit area normal to the current is the current density $j = I/A$, in A/m². Since $V = El$ and $V = I\\rho l/A$, we get $E = j\\rho$, or $j = \\sigma E$, where $\\sigma = 1/\\rho$ is the conductivity. This is Ohm's law written for a point in the material.",
        "hi": "धारा के अभिलंब प्रति एकांक क्षेत्रफल धारा, धारा घनत्व $j = I/A$ है, मात्रक A/m²। चूँकि $V = El$ और $V = I\\rho l/A$, इसलिए $E = j\\rho$, या $j = \\sigma E$, जहाँ $\\sigma = 1/\\rho$ चालकता है। यह पदार्थ के किसी बिंदु के लिए लिखा गया ओम का नियम है।"
      },
      "media": "img.current-electricity.electron-drift",
      "source": {
        "kind": "ncert",
        "ref": "NCERT Class 12 Physics Part I, Ch 3 Current Electricity (2026-27 reprint)",
        "url": "https://ncert.nic.in/textbook/pdf/leph103.pdf",
        "retrieved": "2026-10-29",
        "pages": "§3.4"
      }
    },
    {
      "id": "phy.current-electricity.resistivity:dd:04",
      "type": "formula",
      "concepts": [
        "phy.current-electricity.resistivity.core.resistivity-conductivity"
      ],
      "depth": 2,
      "title": {
        "en": "Ohm's law at a point",
        "hi": "बिंदु पर ओम का नियम"
      },
      "latex": "\\mathbf{j} = \\sigma \\mathbf{E}, \\quad \\sigma = \\frac{1}{\\rho}",
      "symbols": [
        {
          "symbol": "j",
          "meaning": {
            "en": "current density",
            "hi": "धारा घनत्व"
          },
          "unit": "A/m^2"
        },
        {
          "symbol": "\\sigma",
          "meaning": {
            "en": "conductivity",
            "hi": "चालकता"
          },
          "unit": "S/m"
        },
        {
          "symbol": "E",
          "meaning": {
            "en": "electric field",
            "hi": "विद्युत क्षेत्र"
          },
          "unit": "V/m"
        }
      ],
      "source": {
        "kind": "ncert",
        "ref": "NCERT Class 12 Physics Part I, Ch 3 Current Electricity (2026-27 reprint)",
        "url": "https://ncert.nic.in/textbook/pdf/leph103.pdf",
        "retrieved": "2026-10-29",
        "pages": "§3.4"
      }
    },
    {
      "id": "phy.current-electricity.resistivity:dd:05",
      "type": "derivation",
      "concepts": [
        "phy.current-electricity.resistivity.core.resistivity-conductivity"
      ],
      "depth": 3,
      "title": {
        "en": "Resistivity from electron drift",
        "hi": "इलेक्ट्रॉन अपवाह से प्रतिरोधकता"
      },
      "steps": [
        {
          "latex": "I = neA|v_d|, \\quad |v_d| = \\frac{eE\\tau}{m}",
          "say": {
            "en": "Start from the drift picture.",
            "hi": "अपवाह के चित्र से शुरू करें।"
          },
          "why": null
        },
        {
          "latex": "I = \\frac{ne^{2}\\tau A}{m} E",
          "say": {
            "en": "Substitute the drift velocity.",
            "hi": "अपवाह वेग रखें।"
          },
          "why": null
        },
        {
          "latex": "j = \\frac{I}{A} = \\frac{ne^{2}\\tau}{m} E",
          "say": {
            "en": "Divide by the area.",
            "hi": "क्षेत्रफल से भाग दें।"
          },
          "why": null
        },
        {
          "latex": "\\sigma = \\frac{ne^{2}\\tau}{m}, \\quad \\rho = \\frac{m}{ne^{2}\\tau}",
          "say": {
            "en": "Compare with $j = \\sigma E$.",
            "hi": "$j = \\sigma E$ से तुलना करें।"
          },
          "why": {
            "en": "So resistivity is small when there are many free electrons and long relaxation times.",
            "hi": "इसलिए अधिक मुक्त इलेक्ट्रॉनों और लंबे विश्रांति काल पर प्रतिरोधकता कम होती है।"
          }
        }
      ],
      "source": {
        "kind": "ncert",
        "ref": "NCERT Class 12 Physics Part I, Ch 3 Current Electricity (2026-27 reprint)",
        "url": "https://ncert.nic.in/textbook/pdf/leph103.pdf",
        "retrieved": "2026-10-29",
        "pages": "§3.5"
      }
    },
    {
      "id": "phy.current-electricity.resistivity:dd:06",
      "type": "worked_example",
      "concepts": [
        "phy.current-electricity.resistivity.core.resistivity-conductivity"
      ],
      "depth": 3,
      "problem": {
        "en": "A wire of resistance 4 Ω is stretched uniformly to twice its length. Its volume does not change. Find the new resistance.",
        "hi": "4 Ω प्रतिरोध वाले तार को समान रूप से खींचकर उसकी लंबाई दोगुनी की जाती है। उसका आयतन नहीं बदलता। नया प्रतिरोध ज्ञात कीजिए।"
      },
      "solution_steps": [
        {
          "en": "Volume $Al$ fixed, so $l \\to 2l$ gives $A \\to A/2$.",
          "hi": "आयतन $Al$ नियत है, इसलिए $l \\to 2l$ होने पर $A \\to A/2$।"
        },
        {
          "en": "$R' = \\rho \\frac{2l}{A/2} = 4\\rho\\frac{l}{A} = 4R$",
          "hi": "$R' = \\rho \\frac{2l}{A/2} = 4\\rho\\frac{l}{A} = 4R$"
        },
        {
          "en": "$R' = 4 \\times 4 = 16$ Ω",
          "hi": "$R' = 4 \\times 4 = 16$ Ω"
        }
      ],
      "answer": {
        "en": "16 Ω",
        "hi": "16 Ω"
      },
      "answer_value": {
        "value": 16,
        "unit": "Ω",
        "tolerance": {
          "abs": 0.01
        }
      },
      "shortcut": {
        "en": "Stretching by a factor $n$ at constant volume multiplies $R$ by $n^{2}$.",
        "hi": "नियत आयतन पर $n$ गुना खींचने से $R$, $n^{2}$ गुना हो जाता है।"
      },
      "common_trap": {
        "en": "Doubling only the length and forgetting that the area halves gives 8 Ω.",
        "hi": "केवल लंबाई दोगुनी करना और क्षेत्रफल का आधा होना भूलना 8 Ω देता है।"
      }
    },
