    {
      "id": "phy.current-electricity.resistivity:qr:04",
      "type": "common_traps",
      "concepts": [
        "phy.current-electricity.resistivity.core.resistivity-conductivity"
      ],
      "depth": 1,
      "title": {
        "en": "Common traps",
        "hi": "आम गलतियाँ"
      },
      "traps": [
        {
          "mistake": {
            "en": "A longer wire of the same metal has a higher resistivity.",
            "hi": "उसी धातु के लंबे तार की प्रतिरोधकता अधिक होती है।"
          },
          "correct": {
            "en": "Its resistance is higher; resistivity is a property of the material.",
            "hi": "उसका प्रतिरोध अधिक है; प्रतिरोधकता पदार्थ का गुण है।"
          }
        },
        {
          "mistake": {
            "en": "Stretching a wire to twice its length doubles its resistance.",
            "hi": "तार को दोगुनी लंबाई तक खींचने पर प्रतिरोध दोगुना होता है।"
          },
          "correct": {
            "en": "The area also halves, so the resistance becomes four times.",
            "hi": "क्षेत्रफल भी आधा होता है, इसलिए प्रतिरोध चार गुना होता है।"
          }
        }
      ]
    }
