        {
          "en": "$R = \\rho l/A$, $j = \\sigma E$, $\\sigma = 1/\\rho$.",
          "hi": "$R = \\rho l/A$, $j = \\sigma E$, $\\sigma = 1/\\rho$।"
        },
        {
          "en": "Stretch $n$ times at constant volume: $R \\to n^{2}R$.",
          "hi": "नियत आयतन पर $n$ गुना खींचें: $R \\to n^{2}R$।"
        }
      ]
