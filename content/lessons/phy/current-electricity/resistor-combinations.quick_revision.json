      "id": "phy.current-electricity.resistor-combinations:qr:03",
      "type": "summary",
      "concepts": [
        "phy.current-electricity.resistor-combinations.core.resistors-series-parallel"
      ],
      "depth": 1,
      "points": [
        {
          "en": "Series: $R_s = \\Sigma R_i$, same $I$.",
          "hi": "श्रेणी: $R_s = \\Sigma R_i$, एक ही $I$।"
        },
        {
          "en": "Parallel: $1/R_p = \\Sigma 1/R_i$, same $V$.",
          "hi": "पार्श्व: $1/R_p = \\Sigma 1/R_i$, एक ही $V$।"
        }
      ]
    },
    {
      "id": "phy.current-electricity.resistor-combinations:qr:04",
      "type": "common_traps",
      "concepts": [
        "phy.current-electricity.resistor-combinations.core.resistors-series-parallel"
      ],
      "depth": 1,
      "title": {
        "en": "Common traps",
        "hi": "आम गलतियाँ"
      },
      "traps": [
        {
          "mistake": {
            "en": "Adding resistances that are in parallel.",
            "hi": "पार्श्वक्रम के प्रतिरोधों को जोड़ देना।"
          },
          "correct": {
            "en": "In parallel the reciprocals add.",
            "hi": "पार्श्वक्रम में व्युत्क्रम जुड़ते हैं।"
          }
        },
        {
          "mistake": {
            "en": "Stopping at $1/R_p$ and reporting it as the resistance.",
            "hi": "$1/R_p$ पर रुककर उसे ही प्रतिरोध बता देना।"
          },
          "correct": {
            "en": "Take the reciprocal at the end.",
            "hi": "अंत में व्युत्क्रम लीजिए।"
          }
        }
      ]
    }
