        "phy.current-electricity.temperature-dependence.core.resistance-temperature"
      ],
      "depth": 1,
      "points": [
        {
          "en": "$R_T = R_0[1 + \\alpha(T - T_0)]$; $\\alpha > 0$ for metals.",
          "hi": "$R_T = R_0[1 + \\alpha(T - T_0)]$; धातुओं के लिए $\\alpha > 0$।"
        },
        {
          "en": "Semiconductor resistivity falls with temperature.",
          "hi": "अर्धचालक की प्रतिरोधकता ताप के साथ घटती है।"
        }
      ]
    },
    {
      "id": "phy.current-electricity.temperature-dependence:qr:04",
      "type": "common_traps",
      "concepts": [
        "phy.current-electricity.temperature-dependence.core.resistance-temperature"
      ],
      "depth": 1,
      "title": {
        "en": "Common traps",
        "hi": "आम गलतियाँ"
      },
      "traps": [
        {
          "mistake": {
            "en": "Replacing $T - T_0$ by $T$ in the formula.",
            "hi": "सूत्र में $T - T_0$ की जगह $T$ रखना।"
          },
          "correct": {
            "en": "The formula uses the temperature difference from the reference.",
            "hi": "सूत्र संदर्भ ताप से ताप-अंतर का उपयोग करता है।"
          }
        },
        {
          "mistake": {
            "en": "All materials conduct worse when hot.",
            "hi": "गरम होने पर सभी पदार्थ कम चालन करते हैं।"
          },
          "correct": {
            "en": "Semiconductors conduct better when hot: their carrier density rises.",
            "hi": "अर्धचालक गरम होने पर बेहतर चालन करते हैं: उनका वाहक घनत्व बढ़ता है।"
          }
        }
      ]
    }
