      "type": "summary",
      "concepts": [
        "phy.current-electricity.wheatstone.core.wheatstone-bridge"
      ],
      "depth": 1,
      "points": [
        {
          "en": "Balance: $R_2/R_1 = R_4/R_3$, galvanometer current zero.",
          "hi": "संतुलन: $R_2/R_1 = R_4/R_3$, गैल्वेनोमीटर धारा शून्य।"
        },
        {
          "en": "Metre bridge: $S = R\\,l/(100 - l)$.",
          "hi": "मीटर सेतु: $S = R\\,l/(100 - l)$।"
        }
      ]
    },
    {
      "id": "phy.current-electricity.wheatstone:qr:04",
      "type": "common_traps",
      "concepts": [
        "phy.current-electricity.wheatstone.core.wheatstone-bridge"
      ],
      "depth": 1,
      "title": {
        "en": "Common traps",
        "hi": "आम गलतियाँ"
      },
      "traps": [
        {
          "mistake": {
            "en": "At balance no current flows anywhere in the bridge.",
            "hi": "संतुलन पर सेतु में कहीं भी धारा नहीं बहती।"
          },
          "correct": {
            "en": "Only the galvanometer arm carries no current; the four arms still carry current.",
            "hi": "केवल गैल्वेनोमीटर भुजा में धारा नहीं; चारों भुजाओं में धारा बहती है।"
          }
        },
        {
          "mistake": {
            "en": "Using $l/(100 - l)$ with $l$ measured from the far end.",
            "hi": "$l/(100 - l)$ में $l$ को दूर वाले सिरे से मापना।"
          },
          "correct": {
            "en": "Measure $l$ from the end next to the unknown $S$.",
            "hi": "$l$ को अज्ञात $S$ वाले सिरे से मापिए।"
          }
        }
      ]
    }
