      "points": [
        {
          "en": "$f_s \\le \\mu_s N$, $f_k = \\mu_k N$; angle of repose $\\tan\\theta = \\mu_s$.",
          "hi": "$f_s \\le \\mu_s N$, $f_k = \\mu_k N$; विराम कोण $\\tan\\theta = \\mu_s$।"
        },
        {
          "en": "Rolling friction is far smaller than sliding friction.",
          "hi": "लोटनिक घर्षण सर्पी घर्षण से बहुत कम है।"
        }
      ]
    },
    {
      "id": "phy.laws-of-motion.friction:qr:06",
      "type": "common_traps",
      "concepts": [
        "phy.laws-of-motion.friction.core.static-kinetic-friction",
        "phy.laws-of-motion.friction.core.rolling-friction"
      ],
      "depth": 1,
      "title": {
        "en": "Common traps",
        "hi": "आम गलतियाँ"
      },
      "traps": [
        {
          "mistake": {
            "en": "Static friction is always $\\mu_s N$.",
            "hi": "स्थैतिक घर्षण सदा $\\mu_s N$ होता है।"
          },
          "correct": {
            "en": "It equals the applied push, up to a maximum of $\\mu_s N$.",
            "hi": "यह लगाए गए धक्के के बराबर है, अधिकतम $\\mu_s N$ तक।"
          }
        },
        {
          "mistake": {
            "en": "Friction always opposes motion.",
            "hi": "घर्षण सदा गति का विरोध करता है।"
          },
          "correct": {
            "en": "It opposes relative motion; it can drive a body forward.",
            "hi": "यह आपेक्षिक गति का विरोध करता है; यह पिंड को आगे भी ले जा सकता है।"
          }
        },
        {
          "mistake": {
            "en": "A larger contact area gives more friction.",
            "hi": "अधिक संपर्क क्षेत्रफल से अधिक घर्षण।"
          },
          "correct": {
            "en": "Friction is independent of the area of contact.",
            "hi": "घर्षण संपर्क क्षेत्रफल पर निर्भर नहीं।"
          }
        }
      ]
    }
