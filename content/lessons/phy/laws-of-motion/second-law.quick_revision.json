      "points": [
        {
          "en": "$\\vec{F} = d\\vec{p}/dt = m\\vec{a}$; 1 N = 1 kg m/s².",
          "hi": "$\\vec{F} = d\\vec{p}/dt = m\\vec{a}$; 1 N = 1 kg m/s²।"
        },
        {
          "en": "Impulse $= F\\,\\Delta t = \\Delta p$.",
          "hi": "आवेग $= F\\,\\Delta t = \\Delta p$।"
        },
        {
          "en": "Free-body diagram: one body, all external forces on it.",
          "hi": "बल निर्देशक आरेख: एक पिंड, उस पर सभी बाह्य बल।"
        }
      ]
    },
    {
      "id": "phy.laws-of-motion.second-law:qr:06",
      "type": "common_traps",
      "concepts": [
        "phy.laws-of-motion.second-law.core.momentum-second-law",
        "phy.laws-of-motion.second-law.core.impulse",
        "phy.laws-of-motion.second-law.core.free-body-diagrams"
      ],
      "depth": 1,
      "title": {
        "en": "Common traps",
        "hi": "आम गलतियाँ"
      },
      "traps": [
        {
          "mistake": {
            "en": "$m\\vec{a}$ is a force that acts along with the others.",
            "hi": "$m\\vec{a}$ एक बल है जो दूसरों के साथ लगता है।"
          },
          "correct": {
            "en": "It is the effect of the net force, not another force.",
            "hi": "यह नेट बल का प्रभाव है, कोई और बल नहीं।"
          }
        },
        {
          "mistake": {
            "en": "Same change in momentum means the same force.",
            "hi": "समान संवेग परिवर्तन का अर्थ समान बल।"
          },
          "correct": {
            "en": "The force also depends on how quickly the change happens.",
            "hi": "बल इस पर भी निर्भर है कि परिवर्तन कितनी जल्दी होता है।"
          }
        },
        {
          "mistake": {
            "en": "Normal force always equals weight.",
            "hi": "अभिलंब बल सदा भार के बराबर होता है।"
          },
          "correct": {
            "en": "Only in equilibrium; in an accelerating lift they differ.",
            "hi": "केवल संतुलन में; त्वरित लिफ़्ट में वे भिन्न होते हैं।"
          }
        }
      ]
    }
