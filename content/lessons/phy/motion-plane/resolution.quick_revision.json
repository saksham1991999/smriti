    {
      "id": "phy.motion-plane.resolution:qr:04",
      "type": "summary",
      "concepts": [
        "phy.motion-plane.resolution.core.unit-vector-resolution"
      ],
      "depth": 1,
      "points": [
        {
          "en": "Unit vectors $\\hat{i}$, $\\hat{j}$, $\\hat{k}$ point along the axes.",
          "hi": "एकांक सदिश $\\hat{i}$, $\\hat{j}$, $\\hat{k}$ अक्षों के अनुदिश हैं।"
        },
        {
          "en": "$\\tan\\theta = A_y / A_x$ gives the direction.",
          "hi": "$\\tan\\theta = A_y / A_x$ दिशा देता है।"
        },
        {
          "en": "$R_x = A_x + B_x$, $R_y = A_y + B_y$.",
          "hi": "$R_x = A_x + B_x$, $R_y = A_y + B_y$।"
        }
      ]
    },
    {
      "id": "phy.motion-plane.resolution:qr:05",
      "type": "common_traps",
      "concepts": [
        "phy.motion-plane.resolution.core.unit-vector-resolution"
      ],
      "depth": 1,
      "title": {
        "en": "Common traps",
        "hi": "आम गलतियाँ"
      },
      "traps": [
        {
          "mistake": {
            "en": "A unit vector has the unit of the quantity, such as metres.",
            "hi": "एकांक सदिश का मात्रक राशि वाला होता है, जैसे मीटर।"
          },
          "correct": {
            "en": "A unit vector has no dimension and no unit.",
            "hi": "एकांक सदिश की न विमा होती है, न मात्रक।"
          }
        },
        {
          "mistake": {
            "en": "$A_x = A\\sin\\theta$ when $\\theta$ is measured from the x-axis.",
            "hi": "$A_x = A\\sin\\theta$, जब $\\theta$ x-अक्ष से मापा हो।"
          },
          "correct": {
            "en": "From the x-axis, $A_x = A\\cos\\theta$.",
            "hi": "x-अक्ष से मापने पर $A_x = A\\cos\\theta$।"
          }
        },
        {
          "mistake": {
            "en": "Components are always positive.",
            "hi": "घटक सदा धनात्मक होते हैं।"
          },
          "correct": {
            "en": "A component can be positive, negative or zero.",
            "hi": "घटक धनात्मक, ऋणात्मक या शून्य हो सकता है।"
          }
        }
      ]
    }
  ],
