      "concepts": [
        "phy.motion-straight-line.relative-velocity-1d.core.relative-velocity"
      ],
      "depth": 2,
      "points": [
        {
          "en": "Relative velocity $v_{12} = v_1 - v_2$; $v_{21} = -v_{12}$.",
          "hi": "आपेक्षिक वेग $v_{12} = v_1 - v_2$; $v_{21} = -v_{12}$।"
        },
        {
          "en": "Meeting or overtaking time = gap / relative speed.",
          "hi": "मिलने या पार करने का समय = दूरी / आपेक्षिक चाल।"
        }
      ]
    },
    {
      "id": "phy.motion-straight-line.relative-velocity-1d:qr:05",
      "type": "common_traps",
      "concepts": [
        "phy.motion-straight-line.relative-velocity-1d.core.relative-velocity"
      ],
      "depth": 2,
      "title": {
        "en": "Common traps",
        "hi": "आम गलतियाँ"
      },
      "traps": [
        {
          "mistake": {
            "en": "Relative velocity of approaching trains is the difference of speeds.",
            "hi": "पास आती रेलगाड़ियों का आपेक्षिक वेग चालों का अंतर है।"
          },
          "correct": {
            "en": "Opposite directions: the speeds add.",
            "hi": "विपरीत दिशाएँ: चालें जुड़ती हैं।"
          }
        },
        {
          "mistake": {
            "en": "$v_{12}$ and $v_{21}$ are equal.",
            "hi": "$v_{12}$ और $v_{21}$ बराबर हैं।"
          },
          "correct": {
            "en": "Equal in size, opposite in sign.",
            "hi": "परिमाण में बराबर, चिह्न में विपरीत।"
          }
        },
        {
          "mistake": {
            "en": "Mixing a velocity from the ground with one from a train.",
            "hi": "धरती से मापे वेग को रेलगाड़ी से मापे वेग से मिलाना।"
          },
          "correct": {
            "en": "Bring both to the same frame first.",
            "hi": "पहले दोनों को एक ही तंत्र में लाइए।"
          }
        }
      ]
    }
