  "chapter": "bio.cell-unit-of-life",
  "items": [
    {
      "id": "m.bio.cell-unit-of-life.cell-theory.core.cell-theory.1",
      "concept": "bio.cell-unit-of-life.cell-theory.core.cell-theory",
      "technique": "chunking",
      "origin": "system",
      "taught_in": null,
      "locale": "en",
      "text": "38, 39, 55: plants, then animals, then the answer. Schleiden 1838 (plants are made of cells), Schwann 1839 (animals too), Virchow 1855 (every cell comes from a cell).",
      "decodes_to": [
        "Schleiden, 1838: all plants are made of cells",
        "Schwann, 1839: animal cells; bodies made of cells and products of cells",
        "Virchow, 1855: new cells form from pre-existing cells"
      ],
      "exam_style": "neet-ug",
      "media": null,
      "audio": null,
      "notes": "NCERT Class 11 Biology §8.2."
    },
    {
      "id": "m.bio.cell-unit-of-life.cell-theory.core.cell-theory.2",
      "concept": "bio.cell-unit-of-life.cell-theory.core.cell-theory",
      "technique": "chunking",
      "origin": "system",
      "taught_in": null,
      "locale": "hi",
      "text": "अड़तीस में पौधे, उनतालीस में जंतु, पचपन में जवाब: श्लाइडेन 1838, श्वान 1839, विर्चो 1855।",
      "decodes_to": [
        "श्लाइडेन, 1838: सभी पौधे कोशिकाओं से बने हैं",
        "श्वान, 1839: जंतु कोशिकाएँ; शरीर कोशिकाओं और उनके उत्पादों से बना",
        "विर्चो, 1855: नई कोशिकाएँ पूर्व स्थित कोशिकाओं से बनती हैं"
      ],
      "exam_style": "neet-ug",
      "media": null,
      "audio": null,
      "notes": "NCERT कक्षा 11 जीव विज्ञान §8.2।"
    },
    {
      "id": "m.bio.cell-unit-of-life.prokaryotic.core.prokaryotic-cell.1",
      "concept": "bio.cell-unit-of-life.prokaryotic.core.prokaryotic-cell",
      "technique": "acrostic",
      "origin": "system",
      "taught_in": null,
      "locale": "en",
      "text": "Big Cats Very Sleepy: Bacillus, Coccus, Vibrio, Spirillum.",
      "decodes_to": [
        "Bacillus (rod-like)",
        "Coccus (spherical)",
        "Vibrio (comma-shaped)",
        "Spirillum (spiral)"
      ],
      "exam_style": "neet-ug",
      "media": null,
      "audio": null,
      "notes": "NCERT Class 11 Biology §8.4: the four basic shapes of bacteria, in the textbook's order."
    },
    {
      "id": "m.bio.cell-unit-of-life.prokaryotic.core.prokaryotic-cell.2",
      "concept": "bio.cell-unit-of-life.prokaryotic.core.prokaryotic-cell",
      "technique": "acrostic",
      "origin": "system",
      "taught_in": null,
      "locale": "hi",
      "text": "दंगल में गोलू को सर्प ने काटा: दंड, गोला, कोमा, सर्पिल।",
      "decodes_to": [
        "दंडाकार (बेसिलस)",
        "गोलाकार (कोकस)",
        "कोमाकार (विब्रो)",
        "सर्पिल (स्पाइरल)"
      ],
      "exam_style": "neet-ug",
      "media": null,
      "audio": null,
      "notes": "NCERT कक्षा 11 जीव विज्ञान §8.4: जीवाणु के चार मूल आकार, पुस्तक के क्रम में।"
    },
    {
      "id": "m.bio.cell-unit-of-life.prokaryotic.core.prokaryotic-cell.3",
      "concept": "bio.cell-unit-of-life.prokaryotic.core.prokaryotic-cell",
      "technique": "acrostic",
      "origin": "system",
      "taught_in": null,
      "locale": "en",
      "text": "Good Cats Purr, from the outside in: Glycocalyx, Cell wall, Plasma membrane.",
      "decodes_to": [
        "Glycocalyx",
        "Cell wall",
        "Plasma membrane"
      ],
      "exam_style": "neet-ug",
      "media": null,
      "audio": null,
      "notes": "NCERT Class 11 Biology §8.4.1: the three layers of the bacterial cell envelope, outermost first."
    },
    {
      "id": "m.bio.cell-unit-of-life.prokaryotic.core.prokaryotic-cell.4",
      "concept": "bio.cell-unit-of-life.prokaryotic.core.prokaryotic-cell",
      "technique": "acrostic",
      "origin": "system",
      "taught_in": null,
      "locale": "hi",
      "text": "ग्लास में कोक, फिर जीरा, बाहर से भीतर: ग्लाइकोकैलिक्स, कोशिका भित्ति, जीवद्रव्य झिल्ली।",
      "decodes_to": [
        "ग्लाइकोकैलिक्स",
        "कोशिका भित्ति",
        "जीवद्रव्य झिल्ली"
      ],
      "exam_style": "neet-ug",
      "media": null,
      "audio": null,
      "notes": "NCERT कक्षा 11 जीव विज्ञान §8.4.1: जीवाणु कोशिका आवरण की तीन परतें, सबसे बाहरी पहले।"
    },
    {
      "id": "m.bio.cell-unit-of-life.eukaryotic.core.endomembrane-system.1",
      "concept": "bio.cell-unit-of-life.eukaryotic.core.endomembrane-system",
      "technique": "acrostic",
      "origin": "system",
      "taught_in": null,
      "locale": "en",
      "text": "Every Good Lunch Vanishes: ER, Golgi complex, Lysosomes, Vacuoles. Mitochondria never get lunch.",
      "decodes_to": [
        "Endoplasmic reticulum",
        "Golgi complex",
        "Lysosomes",
        "Vacuoles"
      ],
      "exam_style": "neet-ug",
      "media": null,
      "audio": null,
      "notes": "NCERT Class 11 Biology §8.5.3: the endomembrane system; mitochondria, chloroplasts and peroxisomes are not part of it."
    },
    {
      "id": "m.bio.cell-unit-of-life.eukaryotic.core.endomembrane-system.2",
      "concept": "bio.cell-unit-of-life.eukaryotic.core.endomembrane-system",
      "technique": "acrostic",
      "origin": "system",
      "taught_in": null,
      "locale": "hi",
      "text": "अमन गया लस्सी रखने: अंतर्द्रव्यी जालिका, गॉल्जीकाय, लयनकाय, रसधानी।",
      "decodes_to": [
        "अंतर्द्रव्यी जालिका",
        "गॉल्जीकाय",
        "लयनकाय",
        "रसधानी"
      ],
      "exam_style": "neet-ug",
      "media": null,
      "audio": null,
      "notes": "NCERT कक्षा 11 जीव विज्ञान §8.5.3: अंतः झिल्लिका तंत्र।"
    },
    {
      "id": "m.bio.cell-unit-of-life.eukaryotic.core.mitochondria-plastids.1",
      "concept": "bio.cell-unit-of-life.eukaryotic.core.mitochondria-plastids",
      "technique": "chunking",
      "origin": "system",
      "taught_in": null,
      "locale": "en",
      "text": "Eighty splits sixty-forty; seventy splits fifty-thirty. The S numbers never add up, and that is the trap.",
      "decodes_to": [
        "80S = 60S + 40S (eukaryotic)",
        "70S = 50S + 30S (prokaryotic, mitochondria, chloroplasts)"
      ],
      "exam_style": "neet-ug",
      "media": null,
      "audio": null,
      "notes": "NCERT Class 11 Biology §8.5.6; 70S in mitochondria §8.5.4 and chloroplasts §8.5.5."
    },
    {
      "id": "m.bio.cell-unit-of-life.eukaryotic.core.mitochondria-plastids.2",
      "concept": "bio.cell-unit-of-life.eukaryotic.core.mitochondria-plastids",
      "technique": "chunking",
      "origin": "system",
      "taught_in": null,
      "locale": "hi",
      "text": "अस्सी में साठ-चालीस, सत्तर में पचास-तीस; जोड़ो तो मेल नहीं, यही है पेंच।",
      "decodes_to": [
        "80S = 60S + 40S (यूकैरियोटी)",
        "70S = 50S + 30S (प्रोकैरियोटी, सूत्रकणिका, हरितलवक)"
      ],
      "exam_style": "neet-ug",
      "media": null,
      "audio": null,
      "notes": "NCERT कक्षा 11 जीव विज्ञान §8.5.6।"
    },
    {
      "id": "m.bio.cell-unit-of-life.eukaryotic.core.mitochondria-plastids.3",
      "concept": "bio.cell-unit-of-life.eukaryotic.core.mitochondria-plastids",
      "technique": "acrostic",
      "origin": "system",
      "taught_in": null,
      "locale": "en",
      "text": "Amy Eats Apples: Amyloplasts store starch, Elaioplasts store oils and fats, Aleuroplasts store proteins (starch, oil, protein, in that order).",
      "decodes_to": [
        "Amyloplasts: starch",
        "Elaioplasts: oils and fats",
        "Aleuroplasts: proteins"
      ],
      "exam_style": "neet-ug",
      "media": null,
      "audio": null,
      "notes": "NCERT Class 11 Biology §8.5.5: the three kinds of leucoplasts."
    },
    {
      "id": "m.bio.cell-unit-of-life.eukaryotic.core.mitochondria-plastids.4",
      "concept": "bio.cell-unit-of-life.eukaryotic.core.mitochondria-plastids",
      "technique": "chunking",
      "origin": "system",
      "taught_in": null,
      "locale": "hi",
      "text": "मंड, तेल, प्रोटीन: नाम में ही भंडार। मंडलवक में मंड, तेल लवक में तेल और वसा, प्रोटीन लवक में प्रोटीन।",
      "decodes_to": [
        "मंडलवक: मंड",
        "तेल लवक: तेल और वसा",
        "प्रोटीन लवक: प्रोटीन"
      ],
      "exam_style": "neet-ug",
      "media": null,
      "audio": null,
      "notes": "NCERT कक्षा 11 जीव विज्ञान §8.5.5: अवर्णीलवक के तीन प्रकार। हिंदी नाम स्वयं संचित पदार्थ बताते हैं।"
    },
    {
      "id": "m.bio.cell-unit-of-life.eukaryotic.core.nucleus.1",
      "concept": "bio.cell-unit-of-life.eukaryotic.core.nucleus",
      "technique": "acrostic",
      "origin": "system",
      "taught_in": null,
      "locale": "en",
      "text": "My Sweet Aunt Talks, as the centromere slides from the middle to the tip: Metacentric, Sub-metacentric, Acrocentric, Telocentric.",
      "decodes_to": [
        "Metacentric (middle)",
        "Sub-metacentric (slightly away from the middle)",
        "Acrocentric (close to the end)",
        "Telocentric (terminal)"
      ],
      "exam_style": "neet-ug",
      "media": null,
      "audio": null,
      "notes": "NCERT Class 11 Biology §8.5.10, Figure 8.13."
    },
    {
      "id": "m.bio.cell-unit-of-life.eukaryotic.core.nucleus.2",
      "concept": "bio.cell-unit-of-life.eukaryotic.core.nucleus",
      "technique": "acrostic",
      "origin": "system",
      "taught_in": null,
      "locale": "hi",
      "text": "मटर उबले, अचार अंत में: मध्यकेंद्री, उपमध्यकेंद्री, अग्रबिंदु, अंतकेंद्री।",
      "decodes_to": [
        "मध्यकेंद्री (बीच में)",
        "उपमध्यकेंद्री (बीच से थोड़ा हटकर)",
        "अग्रबिंदु (किनारे के पास)",
        "अंतकेंद्री (शीर्ष पर)"
      ],
      "exam_style": "neet-ug",
      "media": null,
      "audio": null,
      "notes": "NCERT कक्षा 11 जीव विज्ञान §8.5.10, चित्र 8.13।"
    }
  ]
