      "stem": {
        "en": "Which one is a nucleoside?",
        "hi": "इनमें से कौन न्यूक्लिओसाइड है?"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "Adenylic acid",
            "hi": "ऐडेनिलिक अम्ल"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "Uridine",
            "hi": "यूरिडीन"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "Cytidylic acid",
            "hi": "साइटिडिलिक अम्ल"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "Adenine",
            "hi": "ऐडेनीन"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "b"
        ]
      },
      "hints": [
        {
          "en": "Base plus sugar, nothing more.",
          "hi": "क्षारक और शर्करा, बस।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Names ending in -idine or -osine are nucleosides; '-ylic acid' names carry the phosphate, so they are nucleotides.",
          "hi": "-इडीन या -ओसीन पर समाप्त नाम न्यूक्लिओसाइड हैं; '-इलिक अम्ल' वाले नामों में फॉस्फेट है, इसलिए वे न्यूक्लियोटाइड हैं।"
        },
        "steps": [
          {
            "en": "NCERT §9.1: adenosine, guanosine, thymidine, uridine and cytidine are nucleosides; adenylic, thymidylic, guanylic, uridylic and cytidylic acid are nucleotides.",
            "hi": "NCERT §9.1: ऐडिनोसीन, ग्वानोसीन, थाइमिडीन, यूरिडीन और साइटिडीन न्यूक्लिओसाइड हैं; ऐडेनिलिक, थाइमिडिलिक, ग्वानिलिक, यूरिडिलिक और साइटिडिलिक अम्ल न्यूक्लियोटाइड हैं।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "a",
            "why": {
              "en": "Adenylic acid is a nucleotide.",
              "hi": "ऐडेनिलिक अम्ल न्यूक्लियोटाइड है।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "Cytidylic acid is a nucleotide.",
              "hi": "साइटिडिलिक अम्ल न्यूक्लियोटाइड है।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "Adenine is a nitrogen base alone.",
              "hi": "ऐडेनीन केवल नाइट्रोजनी क्षारक है।"
            }
          }
        ]
      },
