    {
      "id": "q.bio.biomolecules.nucleic-acids.0004",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "bio.biomolecules.nucleic-acids.core.nucleic-acids-bio",
          "weight": 1
        }
      ],
      "depth": 3,
      "exam_styles": [
        "neet-ug"
      ],
      "stem": {
        "en": "A nucleic acid contains 2'-deoxyribose and the bases adenine, guanine, cytosine and thymine. It is",
        "hi": "एक न्यूक्लिक अम्ल में 2'-डीऑक्सीराइबोज़ और ऐडेनीन, ग्वानीन, साइटोसीन तथा थाइमीन क्षारक हैं। यह है"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "RNA",
            "hi": "RNA"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "DNA",
            "hi": "DNA"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "a polysaccharide",
            "hi": "एक बहुशर्कराइड"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "a nucleoside",
            "hi": "एक न्यूक्लिओसाइड"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "b"
        ]
      },
      "hints": [
        {
          "en": "Look at the sugar.",
          "hi": "शर्करा देखिए।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "The sugar decides the name: deoxyribose makes it deoxyribonucleic acid.",
          "hi": "शर्करा नाम तय करती है: डीऑक्सीराइबोज़ इसे डीऑक्सीराइबोन्यूक्लिक अम्ल बनाती है।"
        },
        "steps": [
          {
            "en": "NCERT §9.6: a nucleic acid containing deoxyribose is DNA; one containing ribose is RNA.",
            "hi": "NCERT §9.6: डीऑक्सीराइबोज़ वाला न्यूक्लिक अम्ल DNA है; राइबोज़ वाला RNA।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "a",
            "why": {
              "en": "RNA has ribose.",
              "hi": "RNA में राइबोज़ होता है।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "It is a polynucleotide, not a chain of sugars alone.",
              "hi": "यह बहुन्यूक्लियोटाइड है, केवल शर्कराओं की शृंखला नहीं।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "A nucleoside is one base and one sugar, not a polymer.",
              "hi": "न्यूक्लिओसाइड एक क्षारक और एक शर्करा है, बहुलक नहीं।"
            }
          }
        ]
      },
