      "id": "q.chem.chemical-bonding.hybridisation.0005",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "chem.chemical-bonding.hybridisation.core.hybridisation-spd",
          "weight": 1
        }
      ],
      "depth": 3,
      "exam_styles": [
        "jee-main",
        "neet-ug"
      ],
      "stem": {
        "en": "The hybridisation and shape of $\\ce{SF6}$ are",
        "hi": "$\\ce{SF6}$ का संकरण और आकृति हैं"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "$sp^3d$, trigonal bipyramidal",
            "hi": "$sp^3d$, त्रिकोणीय द्विपिरामिडी"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "$sp^3d^2$, octahedral",
            "hi": "$sp^3d^2$, अष्टफलकीय"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "$dsp^2$, square planar",
            "hi": "$dsp^2$, वर्ग समतलीय"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "$sp^3$, tetrahedral",
            "hi": "$sp^3$, चतुष्फलकीय"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "b"
        ]
      },
      "hints": [
        {
          "en": "Six bonds.",
          "hi": "छह आबंध।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Six S-F bonds need six hybrid orbitals: one s, three p and two d.",
          "hi": "छह S-F आबंधों के लिए छह संकर कक्षक चाहिए: एक s, तीन p और दो d।"
        },
        "steps": [
          {
            "en": "NCERT §4.6.3: S uses six $sp^3d^2$ orbitals; $\\ce{SF6}$ is a regular octahedron.",
            "hi": "NCERT §4.6.3: S छह $sp^3d^2$ कक्षक प्रयोग करता है; $\\ce{SF6}$ नियमित अष्टफलक है।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "a",
            "why": {
              "en": "That is $\\ce{PCl5}$, with five bonds.",
              "hi": "वह $\\ce{PCl5}$ है, पाँच आबंधों वाला।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "Square planar $dsp^2$ is for complexes like $\\ce{[Ni(CN)4]^2-}$.",
              "hi": "वर्ग समतलीय $dsp^2$, $\\ce{[Ni(CN)4]^2-}$ जैसे संकुलों के लिए है।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "Four orbitals cannot hold six bonds.",
              "hi": "चार कक्षक छह आबंध नहीं रख सकते।"
            }
          }
        ]
      },
      "ideal_time_s": 40,
      "difficulty_estimate": "easy",
