    {
      "id": "q.chem.chemical-bonding.hybridisation.0001",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "chem.chemical-bonding.hybridisation.core.hybridisation-spd",
          "weight": 1
        }
      ],
      "depth": 2,
      "exam_styles": [
        "jee-main",
        "neet-ug"
      ],
      "stem": {
        "en": "The hybridisation of boron in $\\ce{BCl3}$ is",
        "hi": "$\\ce{BCl3}$ में बोरॉन का संकरण है"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "$sp$",
            "hi": "$sp$"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "$sp^2$",
            "hi": "$sp^2$"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "$sp^3$",
            "hi": "$sp^3$"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "$dsp^2$",
            "hi": "$dsp^2$"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "b"
        ]
      },
      "hints": [
        {
          "en": "Three bonds, no lone pair.",
          "hi": "तीन आबंध, कोई एकाकी युग्म नहीं।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Boron makes three bonds and has no lone pair, so it needs three equivalent orbitals in a plane.",
          "hi": "बोरॉन तीन आबंध बनाता है और उस पर कोई एकाकी युग्म नहीं है, इसलिए उसे एक तल में तीन तुल्य कक्षक चाहिए।"
        },
        "steps": [
          {
            "en": "NCERT §4.6.1: one 2s and two 2p orbitals of B form three $sp^2$ orbitals; $\\ce{BCl3}$ is trigonal planar at $120^\\circ$.",
            "hi": "NCERT §4.6.1: B के एक 2s और दो 2p कक्षक तीन $sp^2$ कक्षक बनाते हैं; $\\ce{BCl3}$ $120^\\circ$ पर त्रिकोणीय समतलीय है।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "a",
            "why": {
              "en": "$sp$ gives two orbitals, as in $\\ce{BeCl2}$.",
              "hi": "$sp$ दो कक्षक देता है, जैसे $\\ce{BeCl2}$ में।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "$sp^3$ gives four orbitals.",
              "hi": "$sp^3$ चार कक्षक देता है।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "$dsp^2$ is for square planar complexes.",
              "hi": "$dsp^2$ वर्ग समतलीय संकुलों के लिए है।"
            }
          }
        ]
      },
      "ideal_time_s": 30,
      "difficulty_estimate": "easy",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
    {
      "id": "q.chem.chemical-bonding.hybridisation.0002",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "chem.chemical-bonding.hybridisation.core.hybridisation-spd",
          "weight": 1
        }
      ],
      "depth": 3,
      "exam_styles": [
        "jee-main",
        "neet-ug"
      ],
      "stem": {
        "en": "Which statement about $\\ce{PCl5}$ is correct?",
        "hi": "$\\ce{PCl5}$ के बारे में कौन-सा कथन सही है?"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "All five P-Cl bonds have the same length.",
            "hi": "पाँचों P-Cl आबंधों की लंबाई समान है।"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "The axial bonds are slightly longer and weaker than the equatorial bonds.",
            "hi": "अक्षीय आबंध विषुवतीय आबंधों से थोड़े लंबे और कमज़ोर हैं।"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "Phosphorus is $sp^3$ hybridised.",
            "hi": "फ़ॉस्फ़ोरस $sp^3$ संकरित है।"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "The molecule is square pyramidal.",
            "hi": "अणु वर्ग पिरामिडी है।"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "b"
        ]
      },
      "hints": [
        {
          "en": "Compare the neighbours of an axial and an equatorial bond.",
          "hi": "अक्षीय और विषुवतीय आबंध के पड़ोसियों की तुलना कीजिए।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "The two axial bonds each face three equatorial bond pairs at $90^\\circ$, so they are pushed harder and end up longer and weaker.",
          "hi": "दोनों अक्षीय आबंध $90^\\circ$ पर तीन विषुवतीय आबंधी युग्मों का सामना करते हैं, इसलिए उन पर अधिक धक्का पड़ता है और वे लंबे व कमज़ोर हो जाते हैं।"
        },
        "steps": [
          {
            "en": "NCERT §4.6.3: the axial bond pairs suffer more repulsive interaction, so axial bonds are slightly longer and weaker; this makes $\\ce{PCl5}$ more reactive.",
            "hi": "NCERT §4.6.3: अक्षीय आबंधी युग्मों पर अधिक प्रतिकर्षण होता है, इसलिए अक्षीय आबंध थोड़े लंबे और कमज़ोर हैं; इससे $\\ce{PCl5}$ अधिक क्रियाशील होता है।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "a",
            "why": {
              "en": "The bonds are not all equivalent in a trigonal bipyramid.",
              "hi": "त्रिकोणीय द्विपिरामिड में सभी आबंध तुल्य नहीं होते।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "Five bonds need five hybrid orbitals: $sp^3d$.",
              "hi": "पाँच आबंधों के लिए पाँच संकर कक्षक चाहिए: $sp^3d$।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "$\\ce{PCl5}$ is trigonal bipyramidal.",
              "hi": "$\\ce{PCl5}$ त्रिकोणीय द्विपिरामिडी है।"
            }
          }
        ]
      },
      "ideal_time_s": 50,
      "difficulty_estimate": "medium",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
    {
      "id": "q.chem.chemical-bonding.hybridisation.0003",
      "type": "integer",
      "concepts": [
        {
          "id": "chem.chemical-bonding.hybridisation.core.hybridisation-spd",
          "weight": 1
        }
      ],
      "depth": 3,
      "exam_styles": [
        "jee-main"
      ],
      "stem": {
        "en": "What is the percentage of s character in an $sp^3$ hybrid orbital?",
        "hi": "$sp^3$ संकर कक्षक में s गुण का प्रतिशत क्या है?"
      },
      "answer": {
        "value": 25,
        "unit": "%"
      },
      "hints": [
        {
          "en": "How many orbitals share the single s orbital?",
          "hi": "एक s कक्षक को कितने कक्षक बाँटते हैं?"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Four hybrid orbitals share one s orbital equally.",
          "hi": "चार संकर कक्षक एक s कक्षक को बराबर बाँटते हैं।"
        },
        "steps": [
          {
            "en": "One s orbital and three p orbitals mix: s character $= \\frac{1}{4} \\times 100 = 25$ (NCERT §4.6.1).",
            "hi": "एक s और तीन p कक्षक मिलते हैं: s गुण $= \\frac{1}{4} \\times 100 = 25$ (NCERT §4.6.1)।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "why": {
              "en": "50 is the s character of an $sp$ orbital.",
              "hi": "50 एक $sp$ कक्षक का s गुण है।"
            }
          }
        ]
      },
      "ideal_time_s": 30,
      "difficulty_estimate": "easy",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
    {
      "id": "q.chem.chemical-bonding.hybridisation.0004",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "chem.chemical-bonding.hybridisation.core.hybridisation-spd",
          "weight": 1
