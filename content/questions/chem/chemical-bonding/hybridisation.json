      "stem": {
        "en": "The H-C-H bond angle in ethene is",
        "hi": "एथीन में H-C-H आबंध कोण है"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "$109.5^\\circ$",
            "hi": "$109.5^\\circ$"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "$117.6^\\circ$",
            "hi": "$117.6^\\circ$"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "$180^\\circ$",
            "hi": "$180^\\circ$"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "$90^\\circ$",
            "hi": "$90^\\circ$"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "b"
        ]
      },
      "hints": [
        {
          "en": "Ethene carbon is $sp^2$.",
          "hi": "एथीन का कार्बन $sp^2$ है।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Each carbon in ethene is $sp^2$, so the angles are close to $120^\\circ$; the measured H-C-H angle is a little less.",
          "hi": "एथीन में हर कार्बन $sp^2$ है, इसलिए कोण $120^\\circ$ के पास हैं; मापा गया H-C-H कोण थोड़ा कम है।"
        },
        "steps": [
          {
            "en": "NCERT §4.6.2: in ethene the H-C-H angle is $117.6^\\circ$ and the H-C-C angle is $121^\\circ$.",
            "hi": "NCERT §4.6.2: एथीन में H-C-H कोण $117.6^\\circ$ और H-C-C कोण $121^\\circ$ है।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "a",
            "why": {
              "en": "$109.5^\\circ$ is the tetrahedral angle of $sp^3$ carbon, as in ethane.",
              "hi": "$109.5^\\circ$ $sp^3$ कार्बन का चतुष्फलकीय कोण है, जैसे एथेन में।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "$180^\\circ$ belongs to $sp$ carbon in ethyne.",
              "hi": "$180^\\circ$ एथाइन के $sp$ कार्बन का है।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "$90^\\circ$ would come from unhybridised p orbitals.",
              "hi": "$90^\\circ$ असंकरित p कक्षकों से आता।"
            }
          }
        ]
      },
      "ideal_time_s": 40,
      "difficulty_estimate": "medium",
      "media": null,
      "use": [
