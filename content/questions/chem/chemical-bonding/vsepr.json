    {
      "id": "q.chem.chemical-bonding.vsepr.0003",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "chem.chemical-bonding.vsepr.core.vsepr-shapes",
          "weight": 1
        }
      ],
      "depth": 3,
      "exam_styles": [
        "jee-main",
        "neet-ug"
      ],
      "stem": {
        "en": "The correct order of bond angles is",
        "hi": "आबंध कोणों का सही क्रम है"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "$\\ce{H2O} > \\ce{NH3} > \\ce{CH4}$",
            "hi": "$\\ce{H2O} > \\ce{NH3} > \\ce{CH4}$"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "$\\ce{CH4} > \\ce{NH3} > \\ce{H2O}$",
            "hi": "$\\ce{CH4} > \\ce{NH3} > \\ce{H2O}$"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "$\\ce{NH3} > \\ce{CH4} > \\ce{H2O}$",
            "hi": "$\\ce{NH3} > \\ce{CH4} > \\ce{H2O}$"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "$\\ce{CH4} = \\ce{NH3} = \\ce{H2O}$",
            "hi": "$\\ce{CH4} = \\ce{NH3} = \\ce{H2O}$"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "b"
        ]
      },
      "hints": [
        {
          "en": "Count lone pairs: 0, 1, 2.",
          "hi": "एकाकी युग्म गिनिए: 0, 1, 2।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "All three have four electron pairs. Every lone pair squeezes the bond pairs a little more.",
          "hi": "तीनों में चार इलेक्ट्रॉन युग्म हैं। हर एकाकी युग्म आबंधी युग्मों को थोड़ा और दबाता है।"
        },
        "steps": [
          {
            "en": "NCERT §4.4: $109.5^\\circ$ ($\\ce{CH4}$), $107^\\circ$ ($\\ce{NH3}$), $104.5^\\circ$ ($\\ce{H2O}$).",
            "hi": "NCERT §4.4: $109.5^\\circ$ ($\\ce{CH4}$), $107^\\circ$ ($\\ce{NH3}$), $104.5^\\circ$ ($\\ce{H2O}$)।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "a",
            "why": {
              "en": "This is reversed: more lone pairs means a smaller angle.",
              "hi": "यह उल्टा है: अधिक एकाकी युग्म का अर्थ छोटा कोण।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "$\\ce{CH4}$ has no lone pair, so it has the largest angle.",
              "hi": "$\\ce{CH4}$ में कोई एकाकी युग्म नहीं है, इसलिए उसका कोण सबसे बड़ा है।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "Lone pairs change the angles.",
              "hi": "एकाकी युग्म कोण बदलते हैं।"
            }
          }
        ]
      },
      "ideal_time_s": 45,
      "difficulty_estimate": "easy",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
