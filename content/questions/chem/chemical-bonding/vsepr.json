    {
      "id": "q.chem.chemical-bonding.vsepr.0002",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "chem.chemical-bonding.vsepr.core.vsepr-shapes",
          "weight": 1
        }
      ],
      "depth": 3,
      "exam_styles": [
        "jee-main",
        "neet-ug"
      ],
      "stem": {
        "en": "The shape of $\\ce{XeF4}$ is",
        "hi": "$\\ce{XeF4}$ की आकृति है"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "tetrahedral",
            "hi": "चतुष्फलकीय"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "see-saw",
            "hi": "ढेंकुली"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "square planar",
            "hi": "वर्ग समतलीय"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "square pyramidal",
            "hi": "वर्ग पिरामिडी"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "c"
        ]
      },
      "hints": [
        {
          "en": "Xe has 8 valence electrons; 4 go into bonds.",
          "hi": "Xe के 8 संयोजकता इलेक्ट्रॉन हैं; 4 आबंधों में जाते हैं।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Xe has 4 bond pairs and 2 lone pairs: six pairs in an octahedron. The two lone pairs sit opposite each other, leaving the four F atoms in a square.",
          "hi": "Xe में 4 आबंधी युग्म और 2 एकाकी युग्म हैं: अष्टफलक में छह युग्म। दोनों एकाकी युग्म आमने-सामने होते हैं, और चारों F परमाणु एक वर्ग में रह जाते हैं।"
        },
        "steps": [
          {
            "en": "NCERT Table 4.7: $\\ce{AB4E2}$, $\\ce{XeF4}$, square planar.",
            "hi": "NCERT सारणी 4.7: $\\ce{AB4E2}$, $\\ce{XeF4}$, वर्ग समतलीय।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "a",
            "why": {
              "en": "Tetrahedral is four bond pairs with no lone pair.",
              "hi": "चतुष्फलकीय में चार आबंधी युग्म होते हैं, एकाकी युग्म नहीं।"
            }
          },
          {
            "option_id": "b",
            "why": {
              "en": "See-saw is $\\ce{AB4E}$, like $\\ce{SF4}$, with one lone pair.",
              "hi": "ढेंकुली $\\ce{AB4E}$ है, जैसे $\\ce{SF4}$, एक एकाकी युग्म के साथ।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "Square pyramidal is $\\ce{AB5E}$, like $\\ce{BrF5}$.",
              "hi": "वर्ग पिरामिडी $\\ce{AB5E}$ है, जैसे $\\ce{BrF5}$।"
            }
          }
        ]
      },
      "ideal_time_s": 60,
      "difficulty_estimate": "medium",
