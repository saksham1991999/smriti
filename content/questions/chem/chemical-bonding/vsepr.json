        "neet-ug"
      ],
      "stem": {
        "en": "Which molecule is see-saw shaped?",
        "hi": "कौन-सा अणु ढेंकुली आकार का है?"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "$\\ce{SF4}$",
            "hi": "$\\ce{SF4}$"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "$\\ce{CH4}$",
            "hi": "$\\ce{CH4}$"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "$\\ce{XeF4}$",
            "hi": "$\\ce{XeF4}$"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "$\\ce{BF3}$",
            "hi": "$\\ce{BF3}$"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Look for 4 bond pairs plus 1 lone pair.",
          "hi": "4 आबंधी युग्म और 1 एकाकी युग्म खोजिए।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "S has 4 bond pairs and 1 lone pair. The lone pair takes an equatorial position of the trigonal bipyramid, and the four F atoms make a see-saw.",
          "hi": "S में 4 आबंधी युग्म और 1 एकाकी युग्म हैं। एकाकी युग्म त्रिकोणीय द्विपिरामिड की विषुवतीय स्थिति लेता है, और चारों F परमाणु ढेंकुली बनाते हैं।"
        },
        "steps": [
          {
            "en": "NCERT Tables 4.7 and 4.8: $\\ce{SF4}$, $\\ce{AB4E}$, see-saw.",
            "hi": "NCERT सारणी 4.7 और 4.8: $\\ce{SF4}$, $\\ce{AB4E}$, ढेंकुली।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "$\\ce{CH4}$ is tetrahedral.",
              "hi": "$\\ce{CH4}$ चतुष्फलकीय है।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "$\\ce{XeF4}$ is square planar.",
              "hi": "$\\ce{XeF4}$ वर्ग समतलीय है।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "$\\ce{BF3}$ is trigonal planar.",
              "hi": "$\\ce{BF3}$ त्रिकोणीय समतलीय है।"
            }
          }
        ]
      },
