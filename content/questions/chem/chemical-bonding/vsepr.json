          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "a",
            "why": {
              "en": "That would need five pairs and no lone pair, like $\\ce{PCl5}$.",
              "hi": "इसके लिए पाँच युग्म और कोई एकाकी युग्म नहीं चाहिए, जैसे $\\ce{PCl5}$।"
            }
          },
          {
            "option_id": "b",
            "why": {
              "en": "Octahedral is the arrangement of the six pairs, not the shape of the atoms.",
              "hi": "अष्टफलकीय छह युग्मों की व्यवस्था है, परमाणुओं की आकृति नहीं।"
            }
          },
          {
