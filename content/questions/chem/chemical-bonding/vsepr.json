      "id": "q.chem.chemical-bonding.vsepr.0001",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "chem.chemical-bonding.vsepr.core.vsepr-shapes",
          "weight": 1
        }
      ],
      "depth": 2,
      "exam_styles": [
        "jee-main",
        "neet-ug"
      ],
      "stem": {
        "en": "A molecule $\\ce{AB3}$ has no lone pair on the central atom A. Its shape is",
        "hi": "अणु $\\ce{AB3}$ के केंद्रीय परमाणु A पर कोई एकाकी युग्म नहीं है। इसकी आकृति है"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "trigonal pyramidal",
            "hi": "त्रिकोणीय पिरामिडी"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "trigonal planar",
            "hi": "त्रिकोणीय समतलीय"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "T-shaped",
            "hi": "T-आकार"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "tetrahedral",
            "hi": "चतुष्फलकीय"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "b"
        ]
      },
      "hints": [
        {
          "en": "Three pairs only.",
          "hi": "केवल तीन युग्म।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Three pairs and nothing else push each other into a flat triangle, $120^\\circ$ apart, like $\\ce{BF3}$.",
          "hi": "केवल तीन युग्म एक-दूसरे को समतल त्रिभुज में, $120^\\circ$ पर, धकेल देते हैं, जैसे $\\ce{BF3}$।"
        },
        "steps": [
          {
            "en": "NCERT §4.4, Table 4.6: 3 electron pairs, no lone pair: trigonal planar ($\\ce{BF3}$).",
            "hi": "NCERT §4.4, सारणी 4.6: 3 इलेक्ट्रॉन युग्म, कोई एकाकी युग्म नहीं: त्रिकोणीय समतलीय ($\\ce{BF3}$)।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "a",
            "why": {
              "en": "Trigonal pyramidal needs one lone pair as well, as in $\\ce{NH3}$.",
              "hi": "त्रिकोणीय पिरामिडी के लिए एक एकाकी युग्म भी चाहिए, जैसे $\\ce{NH3}$ में।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "T-shape needs two lone pairs, as in $\\ce{ClF3}$.",
              "hi": "T-आकार के लिए दो एकाकी युग्म चाहिए, जैसे $\\ce{ClF3}$ में।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "Tetrahedral needs four pairs.",
              "hi": "चतुष्फलकीय के लिए चार युग्म चाहिए।"
            }
          }
        ]
      },
      "ideal_time_s": 40,
      "difficulty_estimate": "easy",
      "media": null,
