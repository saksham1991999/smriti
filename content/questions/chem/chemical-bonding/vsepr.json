        }
      ],
      "depth": 3,
      "exam_styles": [
        "jee-main"
      ],
      "stem": {
        "en": "How many lone pairs are there on the central atom of $\\ce{ClF3}$?",
        "hi": "$\\ce{ClF3}$ के केंद्रीय परमाणु पर कितने एकाकी युग्म हैं?"
      },
      "answer": {
        "value": 2,
        "unit": null
      },
      "hints": [
        {
          "en": "Pairs, not electrons.",
          "hi": "युग्म, इलेक्ट्रॉन नहीं।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Chlorine has seven valence electrons; three are used in the Cl-F bonds and the remaining four pair up.",
          "hi": "क्लोरीन के सात संयोजकता इलेक्ट्रॉन हैं; तीन Cl-F आबंधों में लगते हैं और बचे चार युग्म बनाते हैं।"
        },
        "steps": [
          {
            "en": "$7 - 3 = 4$ non-bonding electrons, which form $4 / 2 = 2$ lone pairs ($\\ce{AB3E2}$, NCERT Table 4.7).",
            "hi": "$7 - 3 = 4$ अनाबंधी इलेक्ट्रॉन, जो $4 / 2 = 2$ एकाकी युग्म बनाते हैं ($\\ce{AB3E2}$, NCERT सारणी 4.7)।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "why": {
              "en": "Answering 4 counts electrons, not pairs.",
              "hi": "4 उत्तर देना इलेक्ट्रॉन गिनता है, युग्म नहीं।"
            }
          }
        ]
      },
      "ideal_time_s": 45,
      "difficulty_estimate": "easy",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
    {
      "id": "q.chem.chemical-bonding.vsepr.0005",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "chem.chemical-bonding.vsepr.core.vsepr-shapes",
          "weight": 1
        }
      ],
      "depth": 3,
      "exam_styles": [
