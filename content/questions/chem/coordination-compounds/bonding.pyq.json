      "solution": {
        "feynman": {
          "en": "For the same metal ion, the splitting $\\Delta_0$ follows the spectrochemical series of the ligands: $\\ce{CN-} > en > \\ce{H2O} > \\ce{F-}$.",
          "hi": "एक ही धातु आयन के लिए विपाटन $\\Delta_0$ लिगंडों की स्पेक्ट्रमी रासायनिक श्रेणी का पालन करता है: $\\ce{CN-} > en > \\ce{H2O} > \\ce{F-}$।"
        },
        "steps": [
          {
            "en": "Largest to smallest: $\\ce{CN-}$ $26{,}600$, $en$ $22{,}300$, $\\ce{H2O}$ $17{,}400$, $\\ce{F-}$ $15{,}060$.",
            "hi": "बड़े से छोटे: $\\ce{CN-}$ $26{,}600$, $en$ $22{,}300$, $\\ce{H2O}$ $17{,}400$, $\\ce{F-}$ $15{,}060$।"
          },
          {
            "en": "So A-IV, B-I, C-II, D-III.",
            "hi": "अतः A-IV, B-I, C-II, D-III।"
          }
        ],
