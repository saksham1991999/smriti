      "id": "q.math.integrals.definite-properties.9001",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "math.integrals.definite-properties.core.definite-properties",
          "weight": 1
        }
      ],
      "depth": 3,
      "exam_styles": [
        "jee-main"
      ],
      "stem": {
        "en": "Let $[\\cdot]$ denote the greatest integer function. Then the value of $\\int_0^3\\left(\\frac{e^x+e^{-x}}{[x]!}\\right)dx$ is :",
        "hi": "माना $[\\cdot]$ महत्तम पूर्णांक फलन को दर्शाता है। तब $\\int_0^3\\left(\\frac{e^x+e^{-x}}{[x]!}\\right)dx$ का मान है :"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "$e^2+e^3-\\frac{1}{e^2}-\\frac{1}{e^3}$",
            "hi": "$e^2+e^3-\\frac{1}{e^2}-\\frac{1}{e^3}$"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "$\\frac12\\left(e^2+e^3-\\frac{1}{e^2}-\\frac{1}{e^3}\\right)$",
            "hi": "$\\frac12\\left(e^2+e^3-\\frac{1}{e^2}-\\frac{1}{e^3}\\right)$"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "$e^2+e^3-\\frac{1}{2e^2}-\\frac{1}{2e^3}$",
            "hi": "$e^2+e^3-\\frac{1}{2e^2}-\\frac{1}{2e^3}$"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "$\\frac12\\left(e^2+e^3\\right)-\\frac{1}{e^2}-\\frac{1}{e^3}$",
            "hi": "$\\frac12\\left(e^2+e^3\\right)-\\frac{1}{e^2}-\\frac{1}{e^3}$"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "b"
        ]
      },
      "solution": {
        "feynman": {
          "en": "Split the interval where $[x]$ jumps: on $[0,1)$, $[1,2)$ and $[2,3)$ the factorial is $1$, $1$ and $2$.",
          "hi": "अंतराल को वहाँ बाँटिए जहाँ $[x]$ उछलता है: $[0,1)$, $[1,2)$ और $[2,3)$ पर क्रमगुणित $1$, $1$ और $2$ है।"
        },
        "steps": [
          {
            "en": "$\\int_0^2\\left(e^x+e^{-x}\\right)dx=e^2-e^{-2}$.",
            "hi": "$\\int_0^2\\left(e^x+e^{-x}\\right)dx=e^2-e^{-2}$।"
          },
          {
            "en": "$\\frac12\\int_2^3\\left(e^x+e^{-x}\\right)dx=\\frac12\\left(e^3-e^2+e^{-2}-e^{-3}\\right)$.",
            "hi": "$\\frac12\\int_2^3\\left(e^x+e^{-x}\\right)dx=\\frac12\\left(e^3-e^2+e^{-2}-e^{-3}\\right)$।"
          },
          {
            "en": "Sum $=\\frac12\\left(e^2+e^3-\\frac{1}{e^2}-\\frac{1}{e^3}\\right)$.",
            "hi": "योग $=\\frac12\\left(e^2+e^3-\\frac{1}{e^2}-\\frac{1}{e^3}\\right)$।"
          }
        ],
