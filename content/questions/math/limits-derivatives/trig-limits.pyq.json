  "questions": [
    {
      "id": "q.math.limits-derivatives.trig-limits.9001",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "math.limits-derivatives.trig-limits.core.trig-limits-standard",
          "weight": 0.6
        },
        {
          "id": "math.limits-derivatives.limits-intro.core.limit-definition",
          "weight": 0.4
        }
      ],
      "depth": 3,
      "exam_styles": [
        "jee-main"
      ],
      "stem": {
        "en": "If $\\lim\\limits_{x\\to2}\\frac{\\sin\\left(x^3-5x^2+ax+b\\right)}{\\left(\\sqrt{x-1}-1\\right)\\log_e(x-1)}=m$, then $a+b+m$ is equal to :",
        "hi": "यदि $\\lim\\limits_{x\\to2}\\frac{\\sin\\left(x^3-5x^2+ax+b\\right)}{\\left(\\sqrt{x-1}-1\\right)\\log_e(x-1)}=m$ है, तो $a+b+m$ बराबर है :"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "$5$",
            "hi": "$5$"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "$6$",
            "hi": "$6$"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "$8$",
            "hi": "$8$"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "$10$",
            "hi": "$10$"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "b"
        ]
      },
      "solution": {
        "feynman": {
          "en": "Near $x=2$ the denominator behaves like $\\frac{(x-2)^2}{2}$. For a finite limit the cubic inside the sine must vanish to second order at $x=2$, which fixes $a$ and $b$.",
          "hi": "$x=2$ के पास हर $\\frac{(x-2)^2}{2}$ की तरह व्यवहार करता है। सीमित सीमा के लिए ज्या के भीतर का त्रिघात $x=2$ पर दूसरे क्रम तक शून्य होना चाहिए, जिससे $a$ और $b$ मिलते हैं।"
        },
        "steps": [
          {
            "en": "$\\sqrt{x-1}-1 \\approx \\frac{x-2}{2}$ and $\\log_e(x-1) \\approx x-2$.",
            "hi": "$\\sqrt{x-1}-1 \\approx \\frac{x-2}{2}$ और $\\log_e(x-1) \\approx x-2$।"
          },
          {
            "en": "Let $p(x)=x^3-5x^2+ax+b$. Need $p(2)=2a+b-12=0$ and $p'(2)=a-8=0$: $a=8$, $b=-4$, and $p(x)=(x-2)^2(x-1)$.",
            "hi": "माना $p(x)=x^3-5x^2+ax+b$। आवश्यक: $p(2)=2a+b-12=0$ और $p'(2)=a-8=0$: $a=8$, $b=-4$, और $p(x)=(x-2)^2(x-1)$।"
          },
          {
            "en": "$m=\\lim\\frac{(x-2)^2(x-1)}{(x-2)^2/2}=2$, so $a+b+m=6$.",
            "hi": "$m=\\lim\\frac{(x-2)^2(x-1)}{(x-2)^2/2}=2$, अतः $a+b+m=6$।"
          }
        ],
