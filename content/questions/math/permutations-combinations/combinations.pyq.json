  "questions": [
    {
      "id": "q.math.permutations-combinations.combinations.9001",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "math.permutations-combinations.combinations.core.combinations-ncr",
          "weight": 0.6
        },
        {
          "id": "math.permutations-combinations.counting-principle.core.fundamental-counting",
          "weight": 0.4
        }
      ],
      "depth": 3,
      "exam_styles": [
        "jee-main"
      ],
      "stem": {
        "en": "The number of seven-digit numbers, that can be formed by using the digits $1, 2, 3, 5$ and $7$ such that each digit is used at least once, is :",
        "hi": "अंकों $1, 2, 3, 5$ और $7$ का उपयोग करके बनने वाली ऐसी सात-अंकीय संख्याओं की संख्या, जिनमें प्रत्येक अंक कम से कम एक बार प्रयुक्त हो, है :"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "$15400$",
            "hi": "$15400$"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "$17800$",
            "hi": "$17800$"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "$16800$",
            "hi": "$16800$"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "$29400$",
            "hi": "$29400$"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "c"
        ]
      },
      "solution": {
        "feynman": {
          "en": "Seven places, five digits, each digit at least once: so the extra two places either repeat one digit three times, or two different digits twice each. Count both patterns.",
          "hi": "सात स्थान, पाँच अंक, प्रत्येक अंक कम से कम एक बार: अतः शेष दो स्थानों में या तो एक अंक तीन बार आता है, या दो अलग अंक दो-दो बार। दोनों प्रतिरूप गिनिए।"
        },
        "steps": [
          {
            "en": "Pattern $3,1,1,1,1$: choose the tripled digit in $5$ ways, arrange in $\\frac{7!}{3!}=840$ ways: $4200$.",
            "hi": "प्रतिरूप $3,1,1,1,1$: तीन बार आने वाला अंक $5$ प्रकार से, व्यवस्था $\\frac{7!}{3!}=840$ प्रकार से: $4200$।"
          },
          {
            "en": "Pattern $2,2,1,1,1$: choose the two doubled digits in $\\binom{5}{2}=10$ ways, arrange in $\\frac{7!}{2!\\,2!}=1260$ ways: $12600$.",
            "hi": "प्रतिरूप $2,2,1,1,1$: दो बार आने वाले दो अंक $\\binom{5}{2}=10$ प्रकार से, व्यवस्था $\\frac{7!}{2!\\,2!}=1260$ प्रकार से: $12600$।"
          },
          {
            "en": "Total $4200+12600=16800$.",
            "hi": "कुल $4200+12600=16800$।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": []
      },
