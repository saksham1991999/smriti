          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Read down the pairs.",
          "hi": "युग्मों को एक-एक कर पढ़िए।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Collect the first elements for A and the second elements for B.",
          "hi": "A के लिए पहले अवयव और B के लिए दूसरे अवयव इकट्ठा कीजिए।"
        },
        "steps": [
          {
            "en": "First elements: $1, 2, 3$. Second elements: $p, q$. Check: $3 \\times 2 = 6$ pairs (NCERT §2.2, Example 6).",
