      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "If A is infinite, then $A \\times \\phi$ is infinite.",
            "hi": "यदि A अपरिमित है, तो $A \\times \\phi$ अपरिमित है।"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "If $n(A) = 2$, then $A \\times A \\times A$ has $8$ elements.",
            "hi": "यदि $n(A) = 2$, तो $A \\times A \\times A$ में $8$ अवयव हैं।"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "$\\mathbf{R} \\times \\mathbf{R}$ is the set of coordinates of the points of a plane.",
            "hi": "$\\mathbf{R} \\times \\mathbf{R}$ किसी तल के बिंदुओं के निर्देशांकों का समुच्चय है।"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "If $a \\ne b$, then $(a, b) \\ne (b, a)$.",
            "hi": "यदि $a \\ne b$, तो $(a, b) \\ne (b, a)$।"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Look for the empty set.",
          "hi": "रिक्त समुच्चय खोजिए।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "A product needs an element from each set; the empty set has none to offer.",
          "hi": "गुणन के लिए हर समुच्चय से एक अवयव चाहिए; रिक्त समुच्चय के पास देने को कुछ नहीं।"
        },
        "steps": [
          {
            "en": "$A \\times \\phi = \\phi$ whatever A is; the infinite case needs both sets non-empty (NCERT §2.2, Remark (iii)).",
            "hi": "A कुछ भी हो, $A \\times \\phi = \\phi$; अपरिमित वाली स्थिति में दोनों समुच्चय अरिक्त होने चाहिए (NCERT §2.2, Remark (iii))।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "True: $2 \\times 2 \\times 2 = 8$ ordered triplets.",
              "hi": "सत्य: $2 \\times 2 \\times 2 = 8$ क्रमित त्रिक।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "True: NCERT Example 5.",
              "hi": "सत्य: NCERT Example 5।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "True: the first elements differ.",
              "hi": "सत्य: पहले अवयव भिन्न हैं।"
            }
          }
        ]
