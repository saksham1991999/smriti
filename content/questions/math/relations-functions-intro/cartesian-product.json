  "questions": [
    {
      "id": "q.math.relations-functions-intro.cartesian-product.0001",
      "type": "integer",
      "concepts": [
        {
          "id": "math.relations-functions-intro.cartesian-product.core.cartesian-product-sets",
          "weight": 1
        }
      ],
      "depth": 1,
      "exam_styles": [
        "jee-main"
      ],
      "stem": {
        "en": "If $n(A) = 4$ and $n(B) = 3$, find $n(A \\times B)$.",
        "hi": "यदि $n(A) = 4$ और $n(B) = 3$, तो $n(A \\times B)$ ज्ञात कीजिए।"
      },
      "answer": {
        "value": 12,
        "unit": null
      },
      "hints": [
        {
          "en": "Multiply, do not add.",
          "hi": "गुणा कीजिए, जोड़िए नहीं।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Each of the 4 first elements pairs with each of the 3 second elements.",
          "hi": "4 पहले अवयवों में से हर एक, 3 दूसरे अवयवों में से हर एक के साथ जुड़ता है।"
        },
        "steps": [
          {
            "en": "$n(A \\times B) = 4 \\times 3 = 12$ (NCERT §2.2, Remark (ii)).",
            "hi": "$n(A \\times B) = 4 \\times 3 = 12$ (NCERT §2.2, Remark (ii))।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "why": {
              "en": "Adding the counts gives $7$; the counts multiply.",
              "hi": "गिनतियाँ जोड़ने से $7$ मिलता है; गिनतियों का गुणा होता है।"
            }
          }
        ]
      },
      "ideal_time_s": 20,
      "difficulty_estimate": "easy",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
    {
      "id": "q.math.relations-functions-intro.cartesian-product.0002",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "math.relations-functions-intro.cartesian-product.core.cartesian-product-sets",
          "weight": 1
        }
      ],
      "depth": 2,
      "exam_styles": [
        "jee-main"
      ],
      "stem": {
        "en": "If $(x - 1, y + 2) = (4, 7)$, then $(x, y)$ is",
        "hi": "यदि $(x - 1, y + 2) = (4, 7)$, तो $(x, y)$ है"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "$(5, 5)$",
            "hi": "$(5, 5)$"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "$(3, 5)$",
            "hi": "$(3, 5)$"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "$(5, 9)$",
            "hi": "$(5, 9)$"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "$(4, 7)$",
            "hi": "$(4, 7)$"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Write two equations.",
          "hi": "दो समीकरण लिखिए।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Equal pairs: first equals first, second equals second.",
          "hi": "समान युग्म: पहला पहले के बराबर, दूसरा दूसरे के बराबर।"
        },
        "steps": [
          {
            "en": "$x - 1 = 4$ gives $x = 5$ and $y + 2 = 7$ gives $y = 5$ (NCERT §2.2, Example 1).",
            "hi": "$x - 1 = 4$ से $x = 5$ और $y + 2 = 7$ से $y = 5$ (NCERT §2.2, Example 1)।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "$x = 3$ comes from subtracting 1 instead of adding it.",
              "hi": "$x = 3$, 1 जोड़ने के बजाय घटाने से आता है।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "$y = 9$ comes from adding 2 instead of subtracting it.",
              "hi": "$y = 9$, 2 घटाने के बजाय जोड़ने से आता है।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "These are the values of $x - 1$ and $y + 2$, not of x and y.",
              "hi": "ये $x - 1$ और $y + 2$ के मान हैं, x और y के नहीं।"
            }
          }
        ]
      },
      "ideal_time_s": 30,
      "difficulty_estimate": "easy",
      "media": null,
      "use": [
        "practice",
