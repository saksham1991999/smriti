      ],
      "stem": {
        "en": "Let $A = \\{1, 2, 3\\}$, $B = \\{3, 4\\}$ and $C = \\{4, 5\\}$. Find $n\\big(A \\times (B \\cap C)\\big)$.",
        "hi": "मान लीजिए $A = \\{1, 2, 3\\}$, $B = \\{3, 4\\}$ और $C = \\{4, 5\\}$। $n\\big(A \\times (B \\cap C)\\big)$ ज्ञात कीजिए।"
      },
      "answer": {
        "value": 3,
        "unit": null
      },
      "hints": [
        {
          "en": "What do B and C have in common?",
          "hi": "B और C में साझा क्या है?"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Find the bracket first, then multiply the counts.",
          "hi": "पहले कोष्ठक निकालिए, फिर गिनतियों का गुणा कीजिए।"
        },
        "steps": [
          {
            "en": "$B \\cap C = \\{4\\}$, so $n\\big(A \\times (B \\cap C)\\big) = 3 \\times 1 = 3$ (NCERT §2.2, Example 3).",
            "hi": "$B \\cap C = \\{4\\}$, अतः $n\\big(A \\times (B \\cap C)\\big) = 3 \\times 1 = 3$ (NCERT §2.2, Example 3)।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "why": {
              "en": "Instead of $B \\cap C$, using $B \\cup C$ gives $9$.",
              "hi": "$B \\cap C$ के बजाय $B \\cup C$ लेने से $9$ मिलता है।"
            }
          }
        ]
      },
      "ideal_time_s": 30,
      "difficulty_estimate": "easy",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
