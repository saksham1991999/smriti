    {
      "id": "q.math.relations-functions-intro.cartesian-product.0003",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "math.relations-functions-intro.cartesian-product.core.cartesian-product-sets",
          "weight": 1
        }
      ],
      "depth": 2,
      "exam_styles": [
        "jee-main"
      ],
      "stem": {
        "en": "Let $P = \\{a, b\\}$ and $Q = \\{1\\}$. Which statement is true?",
        "hi": "मान लीजिए $P = \\{a, b\\}$ और $Q = \\{1\\}$। कौन-सा कथन सत्य है?"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "$P \\times Q = \\{(a, 1), (b, 1)\\}$",
            "hi": "$P \\times Q = \\{(a, 1), (b, 1)\\}$"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "$Q \\times P = \\{(a, 1), (b, 1)\\}$",
            "hi": "$Q \\times P = \\{(a, 1), (b, 1)\\}$"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "$P \\times Q = Q \\times P$",
            "hi": "$P \\times Q = Q \\times P$"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "$n(P \\times Q) \\ne n(Q \\times P)$",
            "hi": "$n(P \\times Q) \\ne n(Q \\times P)$"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Which set supplies the first element?",
          "hi": "पहला अवयव कौन-सा समुच्चय देता है?"
        }
      ],
      "solution": {
        "feynman": {
          "en": "In $P \\times Q$ the first element of every pair comes from P.",
          "hi": "$P \\times Q$ में हर युग्म का पहला अवयव P से आता है।"
        },
        "steps": [
          {
            "en": "$P \\times Q = \\{(a, 1), (b, 1)\\}$ while $Q \\times P = \\{(1, a), (1, b)\\}$ (NCERT §2.2, Example 2).",
            "hi": "$P \\times Q = \\{(a, 1), (b, 1)\\}$ जबकि $Q \\times P = \\{(1, a), (1, b)\\}$ (NCERT §2.2, Example 2)।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "In $Q \\times P$ the first element comes from Q, so the pairs start with 1.",
              "hi": "$Q \\times P$ में पहला अवयव Q से आता है, इसलिए युग्म 1 से शुरू होते हैं।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "$(a, 1) \\ne (1, a)$, so the products differ.",
              "hi": "$(a, 1) \\ne (1, a)$, इसलिए गुणन भिन्न हैं।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "Both products have $2 \\times 1 = 2$ elements.",
              "hi": "दोनों गुणनों में $2 \\times 1 = 2$ अवयव हैं।"
            }
          }
        ]
      },
      "ideal_time_s": 30,
      "difficulty_estimate": "easy",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
    {
