      ],
      "depth": 3,
      "exam_styles": [
        "jee-main"
      ],
      "stem": {
        "en": "$A \\times A$ has $9$ elements, and $(-1, 0)$ and $(0, 1)$ are two of them. How many elements of $A \\times A$ have both coordinates equal?",
        "hi": "$A \\times A$ में $9$ अवयव हैं, और $(-1, 0)$ तथा $(0, 1)$ उनमें से दो हैं। $A \\times A$ के कितने अवयवों के दोनों निर्देशांक समान हैं?"
      },
      "answer": {
        "value": 3,
        "unit": null
      },
      "hints": [
        {
          "en": "$n(A \\times A) = n(A)^2$.",
          "hi": "$n(A \\times A) = n(A)^2$।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "First find A: its size and some of its elements are hidden in the data.",
          "hi": "पहले A ज्ञात कीजिए: उसका आकार और कुछ अवयव दिए गए आँकड़ों में छिपे हैं।"
        },
        "steps": [
          {
            "en": "$n(A)^2 = 9$, so $n(A) = 3$. The given pairs show $-1, 0, 1 \\in A$, so $A = \\{-1, 0, 1\\}$.",
            "hi": "$n(A)^2 = 9$, अतः $n(A) = 3$। दिए गए युग्म दिखाते हैं कि $-1, 0, 1 \\in A$, अतः $A = \\{-1, 0, 1\\}$।"
          },
          {
            "en": "The pairs with equal coordinates are $(-1, -1)$, $(0, 0)$, $(1, 1)$: three of them (NCERT §2.2).",
            "hi": "समान निर्देशांकों वाले युग्म $(-1, -1)$, $(0, 0)$, $(1, 1)$ हैं: तीन (NCERT §2.2)।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "why": {
              "en": "Answering $9$ counts every pair, not only those with equal coordinates.",
              "hi": "$9$ उत्तर देने में हर युग्म गिना गया, केवल समान निर्देशांकों वाले नहीं।"
            }
          }
        ]
      },
      "ideal_time_s": 60,
      "difficulty_estimate": "medium",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
