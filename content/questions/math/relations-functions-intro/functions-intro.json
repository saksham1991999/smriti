      ],
      "stem": {
        "en": "Let $f(x) = 2x + 1$ and $g(x) = x - 1$. Then $(fg)(x)$ is",
        "hi": "मान लीजिए $f(x) = 2x + 1$ और $g(x) = x - 1$। तब $(fg)(x)$ है"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "$2x^2 - x - 1$",
            "hi": "$2x^2 - x - 1$"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "$2x^2 - 1$",
            "hi": "$2x^2 - 1$"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "$3x$",
            "hi": "$3x$"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "$2x^2 + x - 1$",
            "hi": "$2x^2 + x - 1$"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Expand carefully.",
          "hi": "सावधानी से विस्तार कीजिए।"
