  "topic": "math.relations-functions-intro.functions-intro",
  "questions": [
    {
      "id": "q.math.relations-functions-intro.functions-intro.0001",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "math.relations-functions-intro.functions-intro.core.function-definition",
          "weight": 1
        }
      ],
      "depth": 1,
      "exam_styles": [
        "jee-main"
      ],
      "stem": {
        "en": "Which relation from $\\{1, 2, 3\\}$ to $\\{4, 5\\}$ is a function?",
        "hi": "$\\{1, 2, 3\\}$ से $\\{4, 5\\}$ तक कौन-सा संबंध फलन है?"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "$\\{(1, 4), (2, 4), (3, 5)\\}$",
            "hi": "$\\{(1, 4), (2, 4), (3, 5)\\}$"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "$\\{(1, 4), (1, 5), (2, 4), (3, 5)\\}$",
            "hi": "$\\{(1, 4), (1, 5), (2, 4), (3, 5)\\}$"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "$\\{(1, 4), (2, 5)\\}$",
            "hi": "$\\{(1, 4), (2, 5)\\}$"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "$\\{(4, 1), (5, 2)\\}$",
            "hi": "$\\{(4, 1), (5, 2)\\}$"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Check every element of the first set.",
          "hi": "पहले समुच्चय के हर अवयव को जाँचिए।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Each of 1, 2 and 3 needs exactly one image.",
          "hi": "1, 2 और 3 में से हर एक का ठीक एक प्रतिबिंब चाहिए।"
        },
        "steps": [
          {
            "en": "In the first relation 1, 2 and 3 each appear once as a first element (NCERT §2.4, Definition 5).",
            "hi": "पहले संबंध में 1, 2 और 3 हर एक पहले अवयव के रूप में ठीक एक बार आते हैं (NCERT §2.4, Definition 5)।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "1 has two images, 4 and 5.",
              "hi": "1 के दो प्रतिबिंब हैं, 4 और 5।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "3 has no image.",
              "hi": "3 का कोई प्रतिबिंब नहीं है।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "These pairs start in the second set, so this is not a relation from the first set.",
              "hi": "ये युग्म दूसरे समुच्चय से शुरू होते हैं, इसलिए यह पहले समुच्चय से संबंध नहीं है।"
            }
          }
        ]
      },
      "ideal_time_s": 30,
      "difficulty_estimate": "easy",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
    {
      "id": "q.math.relations-functions-intro.functions-intro.0002",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "math.relations-functions-intro.functions-intro.core.function-definition",
          "weight": 1
        }
      ],
      "depth": 2,
      "exam_styles": [
        "jee-main"
      ],
      "stem": {
        "en": "The domain of $f(x) = \\frac{1}{x^2 - 7x + 10}$ is",
        "hi": "$f(x) = \\frac{1}{x^2 - 7x + 10}$ का प्रांत है"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "$\\mathbf{R} - \\{2, 5\\}$",
            "hi": "$\\mathbf{R} - \\{2, 5\\}$"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "$\\mathbf{R} - \\{-2, -5\\}$",
            "hi": "$\\mathbf{R} - \\{-2, -5\\}$"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "$\\mathbf{R} - \\{2\\}$",
            "hi": "$\\mathbf{R} - \\{2\\}$"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "$\\mathbf{R}$",
            "hi": "$\\mathbf{R}$"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Factorise the denominator.",
          "hi": "हर के गुणनखंड कीजिए।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Remove the values that make the denominator zero.",
          "hi": "वे मान हटाइए जो हर को शून्य कर दें।"
        },
        "steps": [
          {
            "en": "$x^2 - 7x + 10 = (x - 2)(x - 5)$, which is zero at $x = 2$ and $x = 5$ (NCERT §2.4, Example 21).",
            "hi": "$x^2 - 7x + 10 = (x - 2)(x - 5)$, जो $x = 2$ और $x = 5$ पर शून्य है (NCERT §2.4, Example 21)।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "The signs are reversed: $(x - 2)$ is zero at $x = 2$.",
              "hi": "चिह्न उलट गए हैं: $(x - 2)$, $x = 2$ पर शून्य है।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "$x = 5$ also makes the denominator zero.",
              "hi": "$x = 5$ भी हर को शून्य करता है।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "Division by zero is not defined.",
              "hi": "शून्य से भाग परिभाषित नहीं है।"
            }
          }
        ]
      },
      "ideal_time_s": 40,
      "difficulty_estimate": "easy",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
    {
      "id": "q.math.relations-functions-intro.functions-intro.0003",
      "type": "integer",
      "concepts": [
        {
          "id": "math.relations-functions-intro.functions-intro.core.function-definition",
          "weight": 1
        }
      ],
      "depth": 2,
      "exam_styles": [
        "jee-main"
      ],
      "stem": {
        "en": "If $f(x) = 3x - 4$, find $f(5) - f(2)$.",
        "hi": "यदि $f(x) = 3x - 4$, तो $f(5) - f(2)$ ज्ञात कीजिए।"
      },
      "answer": {
        "value": 9,
        "unit": null
      },
      "hints": [
        {
          "en": "Substitute 5, then 2.",
          "hi": "पहले 5, फिर 2 रखिए।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Find each image, then subtract.",
          "hi": "हर प्रतिबिंब निकालिए, फिर घटाइए।"
        },
        "steps": [
          {
            "en": "$f(5) = 11$ and $f(2) = 2$, so $f(5) - f(2) = 9$ (NCERT §2.4, Example 12).",
            "hi": "$f(5) = 11$ और $f(2) = 2$, अतः $f(5) - f(2) = 9$ (NCERT §2.4, Example 12)।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "why": {
              "en": "$f(5 - 2) = f(3) = 5$ is a different quantity.",
              "hi": "$f(5 - 2) = f(3) = 5$ एक अलग राशि है।"
            }
          }
        ]
      },
      "ideal_time_s": 30,
      "difficulty_estimate": "easy",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
    {
      "id": "q.math.relations-functions-intro.functions-intro.0004",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "math.relations-functions-intro.functions-intro.core.function-definition",
          "weight": 1
        }
      ],
      "depth": 3,
      "exam_styles": [
        "jee-main"
      ],
      "stem": {
        "en": "The domain and range of $f(x) = \\sqrt{16 - x^2}$ are",
        "hi": "$f(x) = \\sqrt{16 - x^2}$ के प्रांत और परिसर हैं"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "Domain $[-4, 4]$, range $[0, 4]$",
            "hi": "प्रांत $[-4, 4]$, परिसर $[0, 4]$"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "Domain $[-4, 4]$, range $[-4, 4]$",
            "hi": "प्रांत $[-4, 4]$, परिसर $[-4, 4]$"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "Domain $[0, 4]$, range $[0, 4]$",
            "hi": "प्रांत $[0, 4]$, परिसर $[0, 4]$"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "Domain $\\mathbf{R}$, range $[0, 4]$",
            "hi": "प्रांत $\\mathbf{R}$, परिसर $[0, 4]$"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Solve $16 - x^2 \\ge 0$ first.",
          "hi": "पहले $16 - x^2 \\ge 0$ हल कीजिए।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "The square root needs a non-negative number and gives a non-negative answer.",
          "hi": "वर्गमूल को अऋणात्मक संख्या चाहिए और वह अऋणात्मक उत्तर देता है।"
        },
        "steps": [
          {
            "en": "$16 - x^2 \\ge 0$ gives $-4 \\le x \\le 4$; then $16 - x^2$ runs over $[0, 16]$, so $f(x)$ runs over $[0, 4]$ (NCERT §2.4, Definition 6).",
            "hi": "$16 - x^2 \\ge 0$ से $-4 \\le x \\le 4$; तब $16 - x^2$ का मान $[0, 16]$ में रहता है, अतः $f(x)$ का मान $[0, 4]$ में (NCERT §2.4, Definition 6)।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "A square root is never negative.",
              "hi": "वर्गमूल कभी ऋणात्मक नहीं होता।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "Negative x such as $-3$ also work, since $(-3)^2 = 9$.",
              "hi": "$-3$ जैसे ऋण x भी चलते हैं, क्योंकि $(-3)^2 = 9$।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "For $|x| > 4$ the number under the root is negative.",
              "hi": "$|x| > 4$ के लिए मूल के नीचे की संख्या ऋणात्मक है।"
            }
          }
        ]
      },
      "ideal_time_s": 45,
      "difficulty_estimate": "medium",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
    {
      "id": "q.math.relations-functions-intro.functions-intro.0005",
      "type": "integer",
      "concepts": [
        {
          "id": "math.relations-functions-intro.functions-intro.core.function-definition",
          "weight": 1
        }
      ],
      "depth": 3,
      "exam_styles": [
        "jee-main"
      ],
      "stem": {
        "en": "f is a linear function from $\\mathbf{Z}$ to $\\mathbf{Z}$ with $f(0) = 3$ and $f(2) = 7$. Find $f(5)$.",
        "hi": "f, $\\mathbf{Z}$ से $\\mathbf{Z}$ तक एक रैखिक फलन है, जिसमें $f(0) = 3$ और $f(2) = 7$। $f(5)$ ज्ञात कीजिए।"
      },
      "answer": {
        "value": 13,
        "unit": null
      },
      "hints": [
        {
          "en": "Find c from $f(0)$.",
          "hi": "$f(0)$ से c निकालिए।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "A linear function is $f(x) = mx + c$; the two values fix m and c.",
          "hi": "रैखिक फलन $f(x) = mx + c$ है; दो मान m और c तय करते हैं।"
        },
        "steps": [
          {
            "en": "$f(0) = c = 3$ and $f(2) = 2m + 3 = 7$, so $m = 2$ and $f(x) = 2x + 3$ (NCERT §2.4, Example 20).",
            "hi": "$f(0) = c = 3$ और $f(2) = 2m + 3 = 7$, अतः $m = 2$ और $f(x) = 2x + 3$ (NCERT §2.4, Example 20)।"
          },
          {
            "en": "$f(5) = 2 \\times 5 + 3 = 13$.",
            "hi": "$f(5) = 2 \\times 5 + 3 = 13$।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "why": {
              "en": "Taking $m = 7 / 2$ by forgetting c gives a non-integer value.",
              "hi": "c भूलकर $m = 7 / 2$ लेने से अपूर्णांक मान आता है।"
            }
          }
        ]
      },
      "ideal_time_s": 45,
      "difficulty_estimate": "medium",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
    {
      "id": "q.math.relations-functions-intro.functions-intro.0006",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "math.relations-functions-intro.functions-intro.core.function-definition",
          "weight": 1
        }
      ],
      "depth": 4,
      "exam_styles": [
        "jee-main"
      ],
      "stem": {
        "en": "The domain of $f(x) = \\sqrt{x - 2} + \\frac{1}{x - 5}$ is",
        "hi": "$f(x) = \\sqrt{x - 2} + \\frac{1}{x - 5}$ का प्रांत है"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "$[2, 5) \\cup (5, \\infty)$",
            "hi": "$[2, 5) \\cup (5, \\infty)$"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "$[2, \\infty)$",
            "hi": "$[2, \\infty)$"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "$(2, 5) \\cup (5, \\infty)$",
            "hi": "$(2, 5) \\cup (5, \\infty)$"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "$\\mathbf{R} - \\{5\\}$",
            "hi": "$\\mathbf{R} - \\{5\\}$"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Intersect the two conditions.",
          "hi": "दोनों शर्तों का सर्वनिष्ठ लीजिए।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Both parts must be defined at once.",
          "hi": "दोनों भाग एक साथ परिभाषित होने चाहिए।"
        },
        "steps": [
          {
            "en": "The root needs $x \\ge 2$; the fraction needs $x \\ne 5$. Together: $[2, 5) \\cup (5, \\infty)$ (NCERT §2.4, Example 21).",
            "hi": "मूल के लिए $x \\ge 2$; भिन्न के लिए $x \\ne 5$। दोनों साथ: $[2, 5) \\cup (5, \\infty)$ (NCERT §2.4, Example 21)।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "$x = 5$ makes the fraction undefined.",
              "hi": "$x = 5$ पर भिन्न अपरिभाषित है।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "$x = 2$ is allowed: $\\sqrt{0} = 0$.",
              "hi": "$x = 2$ की अनुमति है: $\\sqrt{0} = 0$।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "Values below 2 put a negative number under the root.",
              "hi": "2 से कम मान मूल के नीचे ऋण संख्या रख देते हैं।"
            }
          }
        ]
      },
      "ideal_time_s": 50,
      "difficulty_estimate": "medium",
      "media": null,
      "use": [
        "mock"
      ],
      "source": "original"
    },
    {
      "id": "q.math.relations-functions-intro.functions-intro.0007",
      "type": "integer",
      "concepts": [
        {
