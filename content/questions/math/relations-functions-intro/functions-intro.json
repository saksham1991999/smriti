            "hi": "$f(x) = \\sqrt{x}$"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "$f(x) = x^2 + x^{-1}$",
            "hi": "$f(x) = x^2 + x^{-1}$"
          }
