          "text": {
            "en": "$\\mathbf{R} - \\{-2\\}$",
            "hi": "$\\mathbf{R} - \\{-2\\}$"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "$\\mathbf{R} - \\{-2, 2\\}$",
            "hi": "$\\mathbf{R} - \\{-2, 2\\}$"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Where is $g(x) = 0$?",
          "hi": "$g(x) = 0$ कहाँ है?"
        }
      ],
      "solution": {
        "feynman": {
          "en": "The quotient exists only where the divisor is not zero.",
          "hi": "भागफल केवल वहाँ है जहाँ भाजक शून्य न हो।"
        },
        "steps": [
          {
            "en": "$g(x) = 0$ at $x = 2$, so $\\frac{f}{g}$ is defined on $\\mathbf{R} - \\{2\\}$, where it equals $x + 2$ (NCERT §2.4.2 (v)).",
            "hi": "$g(x) = 0$, $x = 2$ पर, अतः $\\frac{f}{g}$, $\\mathbf{R} - \\{2\\}$ पर परिभाषित है, जहाँ यह $x + 2$ के बराबर है (NCERT §2.4.2 (v))।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "Cancelling $x - 2$ does not make $x = 2$ allowed.",
              "hi": "$x - 2$ काटने से $x = 2$ की अनुमति नहीं मिल जाती।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "$g(-2) = -4 \\ne 0$, so $-2$ is allowed.",
              "hi": "$g(-2) = -4 \\ne 0$, इसलिए $-2$ की अनुमति है।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "These are the zeros of f; only the zeros of g matter.",
              "hi": "ये f के शून्यक हैं; केवल g के शून्यक मायने रखते हैं।"
            }
          }
        ]
