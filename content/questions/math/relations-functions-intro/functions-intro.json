      ],
      "stem": {
        "en": "Let $f(x) = x^2 + 1$ and $g(x) = 2x$. Find the sum of all real x with $(f + g)(x) = 16$.",
        "hi": "मान लीजिए $f(x) = x^2 + 1$ और $g(x) = 2x$। उन सभी वास्तविक x का योग ज्ञात कीजिए जिनके लिए $(f + g)(x) = 16$।"
      },
      "answer": {
        "value": -2,
        "unit": null
      },
      "hints": [
        {
          "en": "Both signs of the square root count.",
          "hi": "वर्गमूल के दोनों चिह्न गिने जाते हैं।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Form $f + g$ first; it is a perfect square.",
          "hi": "पहले $f + g$ बनाइए; यह एक पूर्ण वर्ग है।"
        },
        "steps": [
          {
            "en": "$(f + g)(x) = x^2 + 2x + 1 = (x + 1)^2$ (NCERT §2.4.2 (i)).",
            "hi": "$(f + g)(x) = x^2 + 2x + 1 = (x + 1)^2$ (NCERT §2.4.2 (i))।"
          },
          {
            "en": "$(x + 1)^2 = 16$ gives $x + 1 = \\pm 4$, so $x = 3$ or $x = -5$, with sum $-2$.",
            "hi": "$(x + 1)^2 = 16$ से $x + 1 = \\pm 4$, अतः $x = 3$ या $x = -5$, जिनका योग $-2$ है।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "why": {
              "en": "Keeping only the positive root gives $3$.",
              "hi": "केवल धन मूल रखने से $3$ मिलता है।"
            }
          }
        ]
      },
