      "stem": {
        "en": "The range of $f(x) = |x| + 1$, $x \\in \\mathbf{R}$, is",
        "hi": "$f(x) = |x| + 1$, $x \\in \\mathbf{R}$, का परिसर है"
      },
      "options": [
