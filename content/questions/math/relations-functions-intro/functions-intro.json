          "id": "b",
          "text": {
            "en": "$x^{5/2}$",
            "hi": "$x^{5/2}$"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "$x^{1/2}$",
            "hi": "$x^{1/2}$"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "$x^{-3/2}$",
            "hi": "$x^{-3/2}$"
          }
        }
      ],
      "answer": {
