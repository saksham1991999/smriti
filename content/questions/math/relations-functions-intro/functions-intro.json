      ],
      "depth": 3,
      "exam_styles": [
        "jee-main"
      ],
      "stem": {
        "en": "How many integers are in the domain of $f(x) = \\sqrt{9 - x^2}$?",
        "hi": "$f(x) = \\sqrt{9 - x^2}$ के प्रांत में कितने पूर्णांक हैं?"
      },
      "answer": {
        "value": 7,
        "unit": null
      },
      "hints": [
        {
          "en": "Remember 0 and the negative integers.",
          "hi": "0 और ऋण पूर्णांकों को याद रखिए।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Find the domain, then count the integers in it.",
          "hi": "प्रांत ज्ञात कीजिए, फिर उसमें पूर्णांक गिनिए।"
        },
        "steps": [
          {
            "en": "$9 - x^2 \\ge 0$ gives $[-3, 3]$, which holds $-3, -2, -1, 0, 1, 2, 3$ (NCERT §2.4, Definition 6).",
            "hi": "$9 - x^2 \\ge 0$ से $[-3, 3]$ मिलता है, जिसमें $-3, -2, -1, 0, 1, 2, 3$ हैं (NCERT §2.4, Definition 6)।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "why": {
              "en": "Counting only $0$ to $3$ misses the negative integers.",
              "hi": "केवल $0$ से $3$ तक गिनने पर ऋण पूर्णांक छूट जाते हैं।"
            }
          }
        ]
      },
      "ideal_time_s": 40,
