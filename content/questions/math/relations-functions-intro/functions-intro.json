    {
      "id": "q.math.relations-functions-intro.functions-intro.0008",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "math.relations-functions-intro.functions-intro.core.standard-functions-graphs",
          "weight": 1
        }
      ],
      "depth": 2,
      "exam_styles": [
        "jee-main"
      ],
      "stem": {
        "en": "The range of the signum function is",
        "hi": "चिह्न फलन का परिसर है"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "$\\{-1, 0, 1\\}$",
            "hi": "$\\{-1, 0, 1\\}$"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "$\\mathbf{R}$",
            "hi": "$\\mathbf{R}$"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "$[-1, 1]$",
            "hi": "$[-1, 1]$"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "$\\{-1, 1\\}$",
            "hi": "$\\{-1, 1\\}$"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "What is the value at 0?",
          "hi": "0 पर मान क्या है?"
        }
      ],
      "solution": {
        "feynman": {
          "en": "The signum function only ever gives three values.",
