          "en": "What is the smallest value?",
          "hi": "सबसे छोटा मान क्या है?"
        }
      ],
      "solution": {
        "feynman": {
          "en": "$|x|$ takes every value from 0 upward; adding 1 shifts them up.",
          "hi": "$|x|$, 0 से ऊपर का हर मान लेता है; 1 जोड़ने से सब ऊपर खिसकते हैं।"
        },
        "steps": [
          {
            "en": "The range of $|x|$ is $[0, \\infty)$, so the range of $|x| + 1$ is $[1, \\infty)$ (NCERT §2.4.1 (v)).",
            "hi": "$|x|$ का परिसर $[0, \\infty)$ है, अतः $|x| + 1$ का परिसर $[1, \\infty)$ है (NCERT §2.4.1 (v))।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "$f(0) = 1$, so $1$ is in the range.",
              "hi": "$f(0) = 1$, इसलिए $1$ परिसर में है।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "That is the range of $|x|$ alone.",
              "hi": "वह केवल $|x|$ का परिसर है।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "The function never takes values below 1.",
              "hi": "फलन कभी 1 से कम मान नहीं लेता।"
            }
          }
        ]
