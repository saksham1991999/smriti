            "hi": "$(1, \\infty)$"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "$[0, \\infty)$",
            "hi": "$[0, \\infty)$"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "$\\mathbf{R}$",
            "hi": "$\\mathbf{R}$"
          }
        }
      ],
      "answer": {
