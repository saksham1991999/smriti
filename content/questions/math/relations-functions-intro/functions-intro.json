      ],
      "solution": {
        "feynman": {
          "en": "A polynomial uses only non-negative whole-number powers of x.",
          "hi": "बहुपद में x की केवल अऋणात्मक पूर्णांक घातें होती हैं।"
        },
        "steps": [
