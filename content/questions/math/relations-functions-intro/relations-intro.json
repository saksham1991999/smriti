      "exam_styles": [
        "jee-main"
      ],
      "stem": {
        "en": "If $n(A) = 2$ and $n(B) = 2$, how many non-empty relations are there from A to B?",
        "hi": "यदि $n(A) = 2$ और $n(B) = 2$, तो A से B तक कितने अरिक्त संबंध हैं?"
      },
      "answer": {
        "value": 15,
        "unit": null
      },
      "hints": [
        {
          "en": "$2^{pq}$ counts the empty relation too.",
          "hi": "$2^{pq}$ रिक्त संबंध को भी गिनता है।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Count all relations, then remove the empty one.",
          "hi": "सभी संबंध गिनिए, फिर रिक्त संबंध हटाइए।"
        },
        "steps": [
          {
            "en": "$n(A \\times B) = 4$, so there are $2^4 = 16$ relations; one of them is empty, leaving $15$ (NCERT §2.3, Note).",
            "hi": "$n(A \\times B) = 4$, अतः $2^4 = 16$ संबंध हैं; उनमें से एक रिक्त है, शेष $15$ (NCERT §2.3, Note)।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "why": {
              "en": "$16$ includes the empty relation.",
              "hi": "$16$ में रिक्त संबंध शामिल है।"
            }
          }
        ]
      },
      "ideal_time_s": 40,
      "difficulty_estimate": "medium",
