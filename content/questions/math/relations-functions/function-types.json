      ],
      "stem": {
        "en": "$f : \\mathbf{R} \\to \\mathbf{R}$, $f(x) = |x| + 2$ is",
        "hi": "$f : \\mathbf{R} \\to \\mathbf{R}$, $f(x) = |x| + 2$ है"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "neither one-one nor onto",
            "hi": "न एकैकी न आच्छादक"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "one-one but not onto",
            "hi": "एकैकी पर आच्छादक नहीं"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "onto but not one-one",
            "hi": "आच्छादक पर एकैकी नहीं"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "bijective",
            "hi": "एकैकी आच्छादी"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Try x = 1 and x = −1.",
          "hi": "x = 1 और x = −1 आज़माइए।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Opposite numbers share a value, and small values are never reached.",
          "hi": "विपरीत संख्याओं का मान एक होता है, और छोटे मान कभी नहीं मिलते।"
        },
        "steps": [
          {
            "en": "$f(-1) = f(1) = 3$, and $f(x) \\ge 2$, so $0$ is not an image (NCERT §1.3, Definitions 5 and 6).",
            "hi": "$f(-1) = f(1) = 3$, और $f(x) \\ge 2$, अतः $0$ प्रतिबिंब नहीं (NCERT §1.3, Definitions 5 तथा 6)।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "$0$ is never reached.",
              "hi": "$0$ तक कभी नहीं पहुँचते।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "It fails both tests.",
              "hi": "यह दोनों जाँचों में विफल है।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "$f(-1) = f(1)$.",
              "hi": "$f(-1) = f(1)$।"
            }
          }
        ]
      },
      "ideal_time_s": 30,
      "difficulty_estimate": "easy",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
