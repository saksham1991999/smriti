  "topic": "math.relations-functions.function-types",
  "questions": [
    {
      "id": "q.math.relations-functions.function-types.0001",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "math.relations-functions.function-types.core.one-one-onto",
          "weight": 1
        }
      ],
      "depth": 1,
      "exam_styles": [
        "jee-main"
      ],
      "stem": {
        "en": "A function $f : X \\to Y$ is one-one if",
        "hi": "फलन $f : X \\to Y$ एकैकी है यदि"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "$f(x_1) = f(x_2)$ implies $x_1 = x_2$",
            "hi": "$f(x_1) = f(x_2)$ से $x_1 = x_2$ मिले"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "every element of Y is an image",
            "hi": "Y का हर अवयव किसी का प्रतिबिंब हो"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "$x_1 = x_2$ implies $f(x_1) = f(x_2)$",
            "hi": "$x_1 = x_2$ से $f(x_1) = f(x_2)$ मिले"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "X and Y are equal",
            "hi": "X और Y समान हों"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Which direction is the test?",
          "hi": "जाँच किस दिशा में है?"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Equal outputs must come from equal inputs.",
          "hi": "समान आउटपुट समान इनपुट से ही आने चाहिए।"
        },
        "steps": [
          {
            "en": "NCERT §1.3, Definition 5.",
            "hi": "NCERT §1.3, Definition 5।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "That is onto.",
              "hi": "वह आच्छादक है।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "Every function does this; it is the definition of a function, reversed.",
              "hi": "हर फलन ऐसा करता है; यह फलन की परिभाषा है, उलटी नहीं।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "X and Y need not be equal.",
              "hi": "X और Y का समान होना आवश्यक नहीं।"
            }
          }
        ]
      },
      "ideal_time_s": 20,
      "difficulty_estimate": "easy",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
    {
      "id": "q.math.relations-functions.function-types.0002",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "math.relations-functions.function-types.core.one-one-onto",
          "weight": 1
        }
      ],
      "depth": 2,
      "exam_styles": [
        "jee-main"
      ],
      "stem": {
        "en": "$f : \\mathbf{N} \\to \\mathbf{N}$, $f(x) = 3x$ is",
        "hi": "$f : \\mathbf{N} \\to \\mathbf{N}$, $f(x) = 3x$ है"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "one-one but not onto",
            "hi": "एकैकी पर आच्छादक नहीं"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "onto but not one-one",
            "hi": "आच्छादक पर एकैकी नहीं"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "bijective",
            "hi": "एकैकी आच्छादी"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "neither one-one nor onto",
            "hi": "न एकैकी न आच्छादक"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Is 1 an image?",
          "hi": "क्या 1 एक प्रतिबिंब है?"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Distinct inputs give distinct multiples of 3, but not every natural number is a multiple of 3.",
          "hi": "भिन्न इनपुट 3 के भिन्न गुणज देते हैं, पर हर प्राकृत संख्या 3 का गुणज नहीं।"
        },
        "steps": [
          {
            "en": "$3x_1 = 3x_2$ gives $x_1 = x_2$; no natural x has $3x = 1$ (NCERT §1.3, Example 8).",
            "hi": "$3x_1 = 3x_2$ से $x_1 = x_2$; किसी प्राकृत x के लिए $3x = 1$ नहीं (NCERT §1.3, Example 8)।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "It is one-one.",
              "hi": "यह एकैकी है।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "$1$ and $2$ are not images.",
              "hi": "$1$ और $2$ प्रतिबिंब नहीं हैं।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "It is one-one.",
              "hi": "यह एकैकी है।"
            }
          }
        ]
      },
      "ideal_time_s": 30,
      "difficulty_estimate": "easy",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
    {
      "id": "q.math.relations-functions.function-types.0003",
      "type": "mcq_single",
      "concepts": [
