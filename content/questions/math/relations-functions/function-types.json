    {
      "id": "q.math.relations-functions.function-types.0005",
      "type": "integer",
      "concepts": [
        {
          "id": "math.relations-functions.function-types.core.one-one-onto",
          "weight": 1
        }
      ],
      "depth": 3,
      "exam_styles": [
        "jee-main"
      ],
      "stem": {
        "en": "How many one-one functions are there from $\\{1, 2, 3\\}$ to $\\{a, b, c, d\\}$?",
        "hi": "$\\{1, 2, 3\\}$ से $\\{a, b, c, d\\}$ तक कितने एकैकी फलन हैं?"
      },
      "answer": {
        "value": 24,
        "unit": null
      },
      "hints": [
        {
          "en": "No two inputs share an image.",
          "hi": "कोई दो इनपुट प्रतिबिंब साझा नहीं करते।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Choose images one by one, never repeating.",
          "hi": "प्रतिबिंब एक-एक कर चुनिए, बिना दोहराए।"
        },
        "steps": [
          {
            "en": "$1$ has $4$ choices, $2$ has $3$, $3$ has $2$: $4 \\times 3 \\times 2 = 24$ (NCERT §1.3; compare Example 22).",
            "hi": "$1$ के $4$ विकल्प, $2$ के $3$, $3$ के $2$: $4 \\times 3 \\times 2 = 24$ (NCERT §1.3; Example 22 देखिए)।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "why": {
              "en": "$64 = 4^3$ counts all functions, including many-one ones.",
              "hi": "$64 = 4^3$ सभी फलन गिनता है, बहुएक भी।"
            }
          }
        ]
      },
      "ideal_time_s": 40,
      "difficulty_estimate": "medium",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
    {
      "id": "q.math.relations-functions.function-types.0006",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "math.relations-functions.function-types.core.one-one-onto",
          "weight": 1
        }
      ],
      "depth": 3,
      "exam_styles": [
        "jee-main"
      ],
      "stem": {
        "en": "$f : \\{1, 2, 3\\} \\to \\{1, 2, 3\\}$ is onto. Then f",
        "hi": "$f : \\{1, 2, 3\\} \\to \\{1, 2, 3\\}$ आच्छादक है। तब f"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "is also one-one",
            "hi": "एकैकी भी है"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "may be many-one",
            "hi": "बहुएक हो सकता है"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "is a constant function",
            "hi": "अचर फलन है"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "must be the identity function",
            "hi": "अवश्य तत्समक फलन है"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Finite set to itself.",
          "hi": "परिमित समुच्चय से स्वयं तक।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Three images must be hit by three inputs.",
          "hi": "तीन प्रतिबिंबों तक तीन इनपुट से पहुँचना है।"
        },
        "steps": [
          {
            "en": "If two inputs shared an image, at most two images would be hit (NCERT §1.3, Example 13).",
            "hi": "यदि दो इनपुट प्रतिबिंब साझा करते, तो अधिकतम दो प्रतिबिंबों तक पहुँचते (NCERT §1.3, Example 13)।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "A many-one map on three elements misses an image.",
              "hi": "तीन अवयवों पर बहुएक फलन कोई प्रतिबिंब छोड़ देता है।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "A constant function hits only one value.",
              "hi": "अचर फलन केवल एक मान तक पहुँचता है।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "$f(1) = 2$, $f(2) = 1$, $f(3) = 3$ is onto but not the identity.",
              "hi": "$f(1) = 2$, $f(2) = 1$, $f(3) = 3$ आच्छादक है पर तत्समक नहीं।"
            }
          }
        ]
      },
      "ideal_time_s": 30,
      "difficulty_estimate": "easy",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
