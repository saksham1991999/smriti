    {
      "id": "q.math.sets.set-operations.0001",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "math.sets.set-operations.core.venn-diagrams",
          "weight": 1
        }
      ],
      "depth": 1,
      "exam_styles": [
        "jee-main"
      ],
      "stem": {
        "en": "In a Venn diagram, the universal set is usually drawn as",
        "hi": "वेन आरेख में सार्वत्रिक समुच्चय सामान्यतः किससे दिखाया जाता है?"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "a rectangle",
            "hi": "एक आयत"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "a circle",
            "hi": "एक वृत्त"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "a triangle",
            "hi": "एक त्रिभुज"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "a single point",
            "hi": "एक बिंदु"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "What shape frames the whole picture?",
          "hi": "पूरे चित्र को कौन-सी आकृति घेरती है?"
        }
      ],
      "solution": {
        "feynman": {
          "en": "The universal set is the frame that holds every other set.",
          "hi": "सार्वत्रिक समुच्चय वह ढाँचा है जिसमें बाकी सब समुच्चय हैं।"
        },
        "steps": [
          {
            "en": "NCERT §1.8: the universal set is represented by a rectangle and its subsets by circles.",
            "hi": "NCERT §1.8: सार्वत्रिक समुच्चय को आयत से और उसके उपसमुच्चयों को वृत्तों से दिखाया जाता है।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "Circles stand for the subsets.",
              "hi": "वृत्त उपसमुच्चयों के लिए हैं।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "Triangles are not the convention.",
              "hi": "त्रिभुज परिपाटी नहीं है।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "A point cannot hold other sets.",
              "hi": "बिंदु में अन्य समुच्चय नहीं समा सकते।"
            }
          }
        ]
      },
      "ideal_time_s": 20,
      "difficulty_estimate": "easy",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
    {
      "id": "q.math.sets.set-operations.0002",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "math.sets.set-operations.core.venn-diagrams",
          "weight": 1
        }
      ],
      "depth": 2,
      "exam_styles": [
        "jee-main"
      ],
      "stem": {
        "en": "In a Venn diagram of two sets A and B in U, the region inside A but outside B represents",
        "hi": "U में दो समुच्चयों A और B के वेन आरेख में, A के भीतर पर B के बाहर का क्षेत्र दर्शाता है"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "$A - B$",
            "hi": "$A - B$"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "$B - A$",
            "hi": "$B - A$"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "$A \\cap B$",
            "hi": "$A \\cap B$"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "$A'$",
            "hi": "$A'$"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Name the region in words first.",
          "hi": "पहले क्षेत्र का नाम शब्दों में बताइए।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Inside A, outside B: in A but not in B.",
          "hi": "A के भीतर, B के बाहर: A में पर B में नहीं।"
        },
        "steps": [
          {
            "en": "By definition $A - B = \\{x : x \\in A,\\ x \\notin B\\}$ (NCERT §1.9).",
            "hi": "परिभाषा से $A - B = \\{x : x \\in A,\\ x \\notin B\\}$ (NCERT §1.9)।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "$B - A$ lies inside B and outside A.",
              "hi": "$B - A$, B के भीतर और A के बाहर है।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "$A \\cap B$ is the overlap.",
              "hi": "$A \\cap B$ साझा भाग है।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "$A'$ lies outside A.",
              "hi": "$A'$, A के बाहर है।"
            }
          }
        ]
      },
      "ideal_time_s": 30,
      "difficulty_estimate": "easy",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
    {
      "id": "q.math.sets.set-operations.0003",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "math.sets.set-operations.core.venn-diagrams",
          "weight": 1
        }
      ],
      "depth": 2,
      "exam_styles": [
        "jee-main"
      ],
      "stem": {
        "en": "If $A \\subset B$, how are their circles drawn in a Venn diagram?",
        "hi": "यदि $A \\subset B$, तो वेन आरेख में उनके वृत्त कैसे बनाए जाते हैं?"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "The circle for A lies wholly inside the circle for B.",
            "hi": "A का वृत्त पूरी तरह B के वृत्त के भीतर है।"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "The two circles do not meet.",
            "hi": "दोनों वृत्त नहीं मिलते।"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "The two circles partly overlap.",
            "hi": "दोनों वृत्त आंशिक रूप से एक-दूसरे पर चढ़ते हैं।"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "The circle for B lies wholly inside the circle for A.",
            "hi": "B का वृत्त पूरी तरह A के वृत्त के भीतर है।"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Think of the nested bowls.",
          "hi": "एक-दूसरे में रखी कटोरियाँ सोचिए।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Every element of A is in B, so no part of A lies outside B.",
          "hi": "A का हर अवयव B में है, इसलिए A का कोई भाग B के बाहर नहीं।"
        },
        "steps": [
          {
            "en": "NCERT §1.8 draws a subset as a circle inside the circle of the larger set.",
            "hi": "NCERT §1.8 उपसमुच्चय को बड़े समुच्चय के वृत्त के भीतर एक वृत्त से दिखाता है।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "Separate circles show disjoint sets.",
              "hi": "अलग वृत्त असंयुक्त समुच्चय दिखाते हैं।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "A partial overlap leaves some of A outside B.",
              "hi": "आंशिक चढ़ाव में A का कुछ भाग B के बाहर रहता है।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "That shows $B \\subset A$.",
              "hi": "वह $B \\subset A$ दिखाता है।"
            }
          }
        ]
      },
      "ideal_time_s": 25,
      "difficulty_estimate": "easy",
      "media": null,
      "use": [
        "mock"
      ],
      "source": "original"
    },
    {
      "id": "q.math.sets.set-operations.0004",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "math.sets.set-operations.core.union-intersection-complement",
          "weight": 1
        }
      ],
      "depth": 2,
      "exam_styles": [
        "jee-main"
      ],
      "stem": {
        "en": "If $A = \\{1, 2, 3, 4, 5, 6\\}$ and $B = \\{2, 4, 6, 8\\}$, then $A - B$ is",
        "hi": "यदि $A = \\{1, 2, 3, 4, 5, 6\\}$ और $B = \\{2, 4, 6, 8\\}$, तो $A - B$ है"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "$\\{1, 3, 5\\}$",
            "hi": "$\\{1, 3, 5\\}$"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "$\\{8\\}$",
            "hi": "$\\{8\\}$"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "$\\{2, 4, 6\\}$",
            "hi": "$\\{2, 4, 6\\}$"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "$\\{1, 3, 5, 8\\}$",
            "hi": "$\\{1, 3, 5, 8\\}$"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Elements of A only.",
          "hi": "केवल A के अवयव।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Start with A and remove whatever is also in B.",
          "hi": "A से शुरू कीजिए और जो B में भी है उसे हटाइए।"
        },
        "steps": [
          {
            "en": "Removing $2, 4, 6$ from A leaves $\\{1, 3, 5\\}$ (NCERT §1.9).",
            "hi": "A में से $2, 4, 6$ हटाने पर $\\{1, 3, 5\\}$ बचता है (NCERT §1.9)।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "$\\{8\\}$ is $B - A$.",
              "hi": "$\\{8\\}$, $B - A$ है।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "$\\{2, 4, 6\\}$ is $A \\cap B$.",
              "hi": "$\\{2, 4, 6\\}$, $A \\cap B$ है।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "$8$ is not in A, so it cannot be in $A - B$.",
              "hi": "$8$, A में नहीं है, इसलिए $A - B$ में नहीं हो सकता।"
            }
          }
        ]
      },
      "ideal_time_s": 30,
      "difficulty_estimate": "easy",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
    {
      "id": "q.math.sets.set-operations.0005",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "math.sets.set-operations.core.union-intersection-complement",
          "weight": 1
        }
      ],
      "depth": 2,
      "exam_styles": [
        "jee-main"
      ],
      "stem": {
        "en": "Let $U = \\{1, 2, 3, 4, 5, 6, 7, 8, 9\\}$ and $A = \\{2, 4, 6, 8\\}$. Then $A'$ is",
        "hi": "मान लीजिए $U = \\{1, 2, 3, 4, 5, 6, 7, 8, 9\\}$ और $A = \\{2, 4, 6, 8\\}$। तब $A'$ है"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "$\\{1, 3, 5, 7, 9\\}$",
            "hi": "$\\{1, 3, 5, 7, 9\\}$"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "$\\phi$",
            "hi": "$\\phi$"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "$\\{2, 4, 6, 8\\}$",
            "hi": "$\\{2, 4, 6, 8\\}$"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "$\\{1, 3, 5, 7\\}$",
            "hi": "$\\{1, 3, 5, 7\\}$"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Go through U one element at a time.",
          "hi": "U के अवयवों को एक-एक कर देखिए।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "The complement is what U has and A lacks.",
          "hi": "पूरक वह है जो U में है और A में नहीं।"
        },
        "steps": [
          {
            "en": "$A' = U - A = \\{1, 3, 5, 7, 9\\}$ (NCERT §1.10).",
            "hi": "$A' = U - A = \\{1, 3, 5, 7, 9\\}$ (NCERT §1.10)।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "A does not fill U.",
              "hi": "A, U को नहीं भरता।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "That is A itself.",
              "hi": "वह स्वयं A है।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "$9$ is in U and not in A, so it belongs to $A'$.",
              "hi": "$9$, U में है और A में नहीं, इसलिए $A'$ में है।"
            }
          }
        ]
      },
      "ideal_time_s": 30,
      "difficulty_estimate": "easy",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
    {
      "id": "q.math.sets.set-operations.0006",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "math.sets.set-operations.core.union-intersection-complement",
          "weight": 1
        }
      ],
      "depth": 2,
      "exam_styles": [
        "jee-main"
      ],
      "stem": {
        "en": "Which pair of sets is disjoint?",
        "hi": "कौन-सा समुच्चय युग्म असंयुक्त है?"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "$\\{1, 3, 5\\}$ and $\\{2, 4, 6\\}$",
            "hi": "$\\{1, 3, 5\\}$ और $\\{2, 4, 6\\}$"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "$\\{1, 2\\}$ and $\\{2, 3\\}$",
            "hi": "$\\{1, 2\\}$ और $\\{2, 3\\}$"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "$\\{a, e\\}$ and $\\{e, i\\}$",
            "hi": "$\\{a, e\\}$ और $\\{e, i\\}$"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "$\\mathbf{N}$ and $\\mathbf{Z}$",
            "hi": "$\\mathbf{N}$ और $\\mathbf{Z}$"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Find the intersection of each pair.",
          "hi": "हर युग्म का सर्वनिष्ठ निकालिए।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Disjoint means nothing in common.",
          "hi": "असंयुक्त का अर्थ है कुछ भी साझा नहीं।"
        },
        "steps": [
          {
            "en": "$\\{1, 3, 5\\} \\cap \\{2, 4, 6\\} = \\phi$ (NCERT §1.9).",
            "hi": "$\\{1, 3, 5\\} \\cap \\{2, 4, 6\\} = \\phi$ (NCERT §1.9)।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "They share $2$.",
              "hi": "इनमें $2$ साझा है।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "They share $e$.",
              "hi": "इनमें $e$ साझा है।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "$\\mathbf{N} \\subset \\mathbf{Z}$, so they share every natural number.",
              "hi": "$\\mathbf{N} \\subset \\mathbf{Z}$, इसलिए हर प्राकृत संख्या साझा है।"
            }
          }
        ]
      },
      "ideal_time_s": 30,
      "difficulty_estimate": "easy",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
    {
      "id": "q.math.sets.set-operations.0007",
      "type": "integer",
      "concepts": [
        {
          "id": "math.sets.set-operations.core.union-intersection-complement",
          "weight": 1
        }
      ],
      "depth": 3,
      "exam_styles": [
        "jee-main"
      ],
      "stem": {
        "en": "Let $A = \\{x : x \\in \\mathbf{N},\\ x \\le 10\\}$ and let B be the set of even natural numbers. Find $n(A \\cap B)$.",
        "hi": "मान लीजिए $A = \\{x : x \\in \\mathbf{N},\\ x \\le 10\\}$ और B सम प्राकृत संख्याओं का समुच्चय है। $n(A \\cap B)$ ज्ञात कीजिए।"
      },
      "answer": {
        "value": 5,
        "unit": null
      },
      "hints": [
        {
          "en": "The intersection holds elements in both sets.",
          "hi": "सर्वनिष्ठ में दोनों समुच्चयों के अवयव होते हैं।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Keep the even numbers from $1$ to $10$.",
          "hi": "$1$ से $10$ तक की सम संख्याएँ रखिए।"
        },
        "steps": [
          {
            "en": "$A \\cap B = \\{2, 4, 6, 8, 10\\}$, so $n(A \\cap B) = 5$ (NCERT §1.9).",
            "hi": "$A \\cap B = \\{2, 4, 6, 8, 10\\}$, अतः $n(A \\cap B) = 5$ (NCERT §1.9)।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "why": {
              "en": "Leaving out $10$, as if the sign were $<$ instead of $\\le$, gives $4$.",
              "hi": "$10$ को छोड़ देना, मानो चिह्न $<$ हो, $\\le$ नहीं, $4$ देता है।"
            }
          }
        ]
      },
      "ideal_time_s": 40,
