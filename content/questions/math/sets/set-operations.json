    {
      "id": "q.math.sets.set-operations.0008",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "math.sets.set-operations.core.union-intersection-complement",
          "weight": 1
        }
      ],
      "depth": 3,
      "exam_styles": [
        "jee-main"
      ],
      "stem": {
        "en": "For any sets A and B, $(A - B) \\cap B$ is",
        "hi": "किन्हीं समुच्चयों A और B के लिए $(A - B) \\cap B$ है"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "$\\phi$",
            "hi": "$\\phi$"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "A",
            "hi": "A"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "B",
            "hi": "B"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "$A \\cap B$",
            "hi": "$A \\cap B$"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Draw the two circles and shade.",
          "hi": "दोनों वृत्त बनाकर छायांकित कीजिए।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "$A - B$ was built by throwing out everything in B.",
          "hi": "$A - B$, B की हर चीज़ हटाकर बना है।"
        },
        "steps": [
          {
            "en": "No element of $A - B$ is in B, so the intersection is empty (NCERT §1.9: $A - B$ and $B$ share nothing).",
            "hi": "$A - B$ का कोई अवयव B में नहीं, अतः सर्वनिष्ठ रिक्त है (NCERT §1.9: $A - B$ और $B$ में कुछ साझा नहीं)।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "Elements of A that are in B were removed.",
              "hi": "A के जो अवयव B में थे, वे हटा दिए गए।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "$A - B$ contains no element of B.",
              "hi": "$A - B$ में B का कोई अवयव नहीं।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "$A \\cap B$ is exactly what was removed.",
              "hi": "$A \\cap B$ ठीक वही है जो हटाया गया।"
            }
          }
        ]
      },
      "ideal_time_s": 40,
      "difficulty_estimate": "medium",
      "media": null,
      "use": [
        "mock"
      ],
      "source": "original"
    },
    {
      "id": "q.math.sets.set-operations.0009",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "math.sets.set-operations.core.set-algebra-laws",
          "weight": 1
        }
      ],
      "depth": 3,
      "exam_styles": [
        "jee-main"
      ],
      "stem": {
        "en": "For subsets A and B of U, $(A \\cup B)'$ equals",
        "hi": "U के उपसमुच्चयों A और B के लिए $(A \\cup B)'$ बराबर है"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "$A' \\cap B'$",
            "hi": "$A' \\cap B'$"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "$A' \\cup B'$",
            "hi": "$A' \\cup B'$"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "$A \\cap B$",
            "hi": "$A \\cap B$"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "$A' \\cup B$",
            "hi": "$A' \\cup B$"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Complement flips $\\cup$ to $\\cap$.",
          "hi": "पूरक $\\cup$ को $\\cap$ में पलटता है।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Outside the union means outside A and outside B at once.",
          "hi": "सम्मिलन के बाहर का अर्थ है एक साथ A के बाहर और B के बाहर।"
        },
        "steps": [
          {
            "en": "De Morgan's law (NCERT §1.10): $(A \\cup B)' = A' \\cap B'$.",
            "hi": "डी मॉर्गन नियम (NCERT §1.10): $(A \\cup B)' = A' \\cap B'$।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "That is $(A \\cap B)'$.",
              "hi": "वह $(A \\cap B)'$ है।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "The overlap lies inside the union, not outside it.",
              "hi": "साझा भाग सम्मिलन के भीतर है, बाहर नहीं।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "B lies inside $A \\cup B$, so it cannot be in the complement.",
              "hi": "B, $A \\cup B$ के भीतर है, इसलिए पूरक में नहीं हो सकता।"
            }
          }
        ]
      },
      "ideal_time_s": 30,
      "difficulty_estimate": "easy",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
    {
      "id": "q.math.sets.set-operations.0010",
      "type": "integer",
      "concepts": [
        {
          "id": "math.sets.set-operations.core.set-algebra-laws",
          "weight": 1
        }
      ],
      "depth": 3,
      "exam_styles": [
        "jee-main"
      ],
      "stem": {
        "en": "If $n(A) = 20$, $n(B) = 15$ and $n(A \\cap B) = 6$, find $n(A \\cup B)$.",
        "hi": "यदि $n(A) = 20$, $n(B) = 15$ और $n(A \\cap B) = 6$, तो $n(A \\cup B)$ ज्ञात कीजिए।"
      },
      "answer": {
        "value": 29,
        "unit": null
      },
      "hints": [
        {
          "en": "Use $n(A) + n(B) - n(A \\cap B)$.",
          "hi": "$n(A) + n(B) - n(A \\cap B)$ लगाइए।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Add both counts, then take away the elements counted twice.",
          "hi": "दोनों गिनतियाँ जोड़िए, फिर दो बार गिने अवयव घटाइए।"
        },
        "steps": [
          {
            "en": "$n(A \\cup B) = 20 + 15 - 6 = 29$ (OpenStax Contemporary Mathematics §1.4).",
            "hi": "$n(A \\cup B) = 20 + 15 - 6 = 29$ (OpenStax Contemporary Mathematics §1.4)।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "why": {
              "en": "$35$ forgets to subtract the common elements.",
              "hi": "$35$ में साझा अवयव घटाना भूल गए।"
            }
          }
        ]
      },
      "ideal_time_s": 30,
      "difficulty_estimate": "easy",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
    {
      "id": "q.math.sets.set-operations.0011",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "math.sets.set-operations.core.set-algebra-laws",
          "weight": 1
        }
      ],
      "depth": 3,
      "exam_styles": [
        "jee-main"
      ],
      "stem": {
        "en": "In a group of 50 people, 30 speak Hindi and 25 speak English, and each person speaks at least one of the two. How many speak both?",
        "hi": "50 लोगों के एक समूह में 30 हिंदी और 25 अंग्रेज़ी बोलते हैं, और हर व्यक्ति दोनों में से कम से कम एक भाषा बोलता है। कितने लोग दोनों बोलते हैं?"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "$5$",
            "hi": "$5$"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "$55$",
            "hi": "$55$"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "$20$",
            "hi": "$20$"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "$0$",
            "hi": "$0$"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Rearrange $n(A \\cup B) = n(A) + n(B) - n(A \\cap B)$.",
          "hi": "$n(A \\cup B) = n(A) + n(B) - n(A \\cap B)$ को पुनर्व्यवस्थित कीजिए।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "The two groups add up to more than the whole group; the extra people were counted twice.",
          "hi": "दोनों समूहों का योग पूरे समूह से अधिक है; अतिरिक्त लोग दो बार गिने गए।"
        },
        "steps": [
          {
            "en": "$n(H \\cup E) = 50$, so $n(H \\cap E) = 30 + 25 - 50 = 5$ (OpenStax Contemporary Mathematics §1.4).",
            "hi": "$n(H \\cup E) = 50$, अतः $n(H \\cap E) = 30 + 25 - 50 = 5$ (OpenStax Contemporary Mathematics §1.4)।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "$55$ is $30 + 25$, more than the group.",
              "hi": "$55$, $30 + 25$ है, समूह से अधिक।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "$20$ is $50 - 30$, the number who speak English only.",
              "hi": "$20$, $50 - 30$ है, केवल अंग्रेज़ी बोलने वालों की संख्या।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "With $0$ in common the total would be $55$, not $50$.",
              "hi": "$0$ साझा होने पर कुल $55$ होता, $50$ नहीं।"
            }
          }
        ]
      },
      "ideal_time_s": 45,
      "difficulty_estimate": "medium",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
    {
      "id": "q.math.sets.set-operations.0012",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "math.sets.set-operations.core.set-algebra-laws",
          "weight": 1
        }
      ],
      "depth": 3,
      "exam_styles": [
        "jee-main"
      ],
      "stem": {
        "en": "$A \\cap (B \\cup C)$ is equal to",
        "hi": "$A \\cap (B \\cup C)$ बराबर है"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "$(A \\cap B) \\cup (A \\cap C)$",
            "hi": "$(A \\cap B) \\cup (A \\cap C)$"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "$(A \\cup B) \\cap C$",
            "hi": "$(A \\cup B) \\cap C$"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "$(A \\cap B) \\cup C$",
            "hi": "$(A \\cap B) \\cup C$"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "$A \\cup (B \\cap C)$",
            "hi": "$A \\cup (B \\cap C)$"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Every element must be in A.",
          "hi": "हर अवयव A में होना चाहिए।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Intersection distributes over union, like multiplication over addition.",
          "hi": "सर्वनिष्ठ सम्मिलन पर वितरित होता है, जैसे गुणा जोड़ पर।"
        },
        "steps": [
          {
            "en": "Distributive law (NCERT §1.9): $A \\cap (B \\cup C) = (A \\cap B) \\cup (A \\cap C)$.",
            "hi": "वितरण नियम (NCERT §1.9): $A \\cap (B \\cup C) = (A \\cap B) \\cup (A \\cap C)$।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "This contains elements of B and C that are not in A, so it is not the same set in general.",
              "hi": "इसमें B और C के वे अवयव भी आते हैं जो A में नहीं हैं, इसलिए यह सामान्यतः वही समुच्चय नहीं है।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "This contains all of C, even the part outside A.",
              "hi": "इसमें पूरा C है, A के बाहर वाला भाग भी।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "This contains all of A, even the part outside $B \\cup C$.",
              "hi": "इसमें पूरा A है, $B \\cup C$ के बाहर वाला भाग भी।"
            }
          }
        ]
      },
      "ideal_time_s": 40,
      "difficulty_estimate": "medium",
      "media": null,
      "use": [
        "mock"
      ],
      "source": "original"
    },
    {
      "id": "q.math.sets.set-operations.0013",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "math.sets.set-operations.core.set-algebra-laws",
          "weight": 1
        }
      ],
      "depth": 3,
      "exam_styles": [
        "jee-main"
      ],
      "stem": {
        "en": "In a survey of 60 students, 35 like tea, 30 like coffee and 10 like neither. How many like both?",
        "hi": "60 विद्यार्थियों के एक सर्वेक्षण में 35 को चाय, 30 को कॉफ़ी पसंद है और 10 को दोनों में से कुछ नहीं। कितनों को दोनों पसंद हैं?"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "$15$",
            "hi": "$15$"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "$5$",
            "hi": "$5$"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "$25$",
            "hi": "$25$"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "$10$",
            "hi": "$10$"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Union = total minus 'neither'.",
          "hi": "सम्मिलन = कुल में से 'कोई नहीं' घटाकर।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "First find how many like at least one drink, then use the union formula.",
          "hi": "पहले निकालिए कि कितनों को कम से कम एक पेय पसंद है, फिर सम्मिलन का सूत्र लगाइए।"
        },
        "steps": [
          {
            "en": "At least one: $60 - 10 = 50$. Both: $35 + 30 - 50 = 15$ (OpenStax Contemporary Mathematics §1.4).",
            "hi": "कम से कम एक: $60 - 10 = 50$। दोनों: $35 + 30 - 50 = 15$ (OpenStax Contemporary Mathematics §1.4)।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "$5$ comes from using $60$ as the union and ignoring the 10 who like neither.",
              "hi": "$5$ तब आता है जब $60$ को सम्मिलन मानकर उन 10 को अनदेखा किया जाए जिन्हें कुछ पसंद नहीं।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "$25$ subtracts the wrong totals.",
              "hi": "$25$ में गलत योग घटाए गए हैं।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "$10$ is the number who like neither.",
              "hi": "$10$ उनकी संख्या है जिन्हें कुछ पसंद नहीं।"
            }
          }
        ]
      },
      "ideal_time_s": 60,
      "difficulty_estimate": "medium",
      "media": null,
      "use": [
        "mock"
      ],
      "source": "original"
    }
  ],
