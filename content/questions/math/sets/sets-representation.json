    {
      "id": "q.math.sets.sets-representation.0007",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "math.sets.sets-representation.core.set-notation",
          "weight": 1
        }
      ],
      "depth": 3,
      "exam_styles": [
        "jee-main"
      ],
      "stem": {
        "en": "In roster form, $\\{x : x \\in \\mathbf{Z},\\ x^2 \\le 4\\}$ is",
        "hi": "सूचीरूप में $\\{x : x \\in \\mathbf{Z},\\ x^2 \\le 4\\}$ है"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "$\\{-2, -1, 0, 1, 2\\}$",
            "hi": "$\\{-2, -1, 0, 1, 2\\}$"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "$\\{0, 1, 2\\}$",
            "hi": "$\\{0, 1, 2\\}$"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "$\\{1, 2\\}$",
            "hi": "$\\{1, 2\\}$"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "$\\{-2, 2\\}$",
            "hi": "$\\{-2, 2\\}$"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Test $x = 0$ and $x = -1$.",
          "hi": "$x = 0$ और $x = -1$ जाँचिए।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Negative integers have positive squares too.",
          "hi": "ऋण पूर्णांकों के वर्ग भी धनात्मक होते हैं।"
        },
