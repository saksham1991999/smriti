      "id": "q.math.sets.sets-representation.0006",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "math.sets.sets-representation.core.set-notation",
          "weight": 1
        }
      ],
      "depth": 3,
      "exam_styles": [
        "jee-main"
      ],
      "stem": {
        "en": "A is the set of prime numbers that divide 60. In roster form, A is",
        "hi": "A उन अभाज्य संख्याओं का समुच्चय है जो 60 को विभाजित करती हैं। सूचीरूप में A है"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "$\\{2, 3, 5\\}$",
            "hi": "$\\{2, 3, 5\\}$"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "$\\{1, 2, 3, 5\\}$",
            "hi": "$\\{1, 2, 3, 5\\}$"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "$\\{2, 3, 4, 5\\}$",
            "hi": "$\\{2, 3, 4, 5\\}$"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "$\\{2, 3, 5, 6\\}$",
            "hi": "$\\{2, 3, 5, 6\\}$"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Prime and divisor: both conditions.",
          "hi": "अभाज्य और भाजक: दोनों शर्तें।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Factorise 60 into primes and keep each prime once.",
          "hi": "60 के अभाज्य गुणनखंड कीजिए और हर अभाज्य एक बार रखिए।"
        },
        "steps": [
          {
            "en": "$60 = 2^2 \\times 3 \\times 5$, so $A = \\{2, 3, 5\\}$.",
            "hi": "$60 = 2^2 \\times 3 \\times 5$, अतः $A = \\{2, 3, 5\\}$।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "$1$ is not a prime number.",
              "hi": "$1$ अभाज्य संख्या नहीं है।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "$4$ divides 60 but is not prime.",
              "hi": "$4$, 60 को विभाजित करता है पर अभाज्य नहीं है।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "$6$ divides 60 but is not prime.",
              "hi": "$6$, 60 को विभाजित करता है पर अभाज्य नहीं है।"
            }
          }
        ]
      },
      "ideal_time_s": 45,
      "difficulty_estimate": "easy",
      "media": null,
