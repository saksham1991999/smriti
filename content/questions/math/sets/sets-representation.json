  "questions": [
    {
      "id": "q.math.sets.sets-representation.0001",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "math.sets.sets-representation.core.set-notation",
          "weight": 1
        }
      ],
      "depth": 1,
      "exam_styles": [
        "jee-main"
      ],
      "stem": {
        "en": "If $A = \\{1, 3, 5, 7, 9\\}$, which statement is true?",
        "hi": "यदि $A = \\{1, 3, 5, 7, 9\\}$, तो कौन-सा कथन सत्य है?"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "$3 \\in A$",
            "hi": "$3 \\in A$"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "$4 \\in A$",
            "hi": "$4 \\in A$"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "$9 \\notin A$",
            "hi": "$9 \\notin A$"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "$\\{1\\} \\in A$",
            "hi": "$\\{1\\} \\in A$"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Is the object written in the braces?",
          "hi": "क्या वस्तु कोष्ठक के भीतर लिखी है?"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Check each object against the list: only listed objects belong to A.",
          "hi": "हर वस्तु को सूची से मिलाइए: केवल सूची में लिखी वस्तुएँ A में हैं।"
        },
        "steps": [
          {
            "en": "$3$ is in the list, so $3 \\in A$ (NCERT §1.2).",
            "hi": "$3$ सूची में है, अतः $3 \\in A$ (NCERT §1.2)।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "$4$ is even and is not listed.",
              "hi": "$4$ सम है और सूची में नहीं है।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "$9$ is listed, so $9 \\in A$.",
              "hi": "$9$ सूची में है, अतः $9 \\in A$।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "$\\{1\\}$ is a set, not one of the listed elements; the element is $1$.",
              "hi": "$\\{1\\}$ एक समुच्चय है, सूची का अवयव नहीं; अवयव $1$ है।"
            }
          }
        ]
      },
      "ideal_time_s": 30,
      "difficulty_estimate": "easy",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
    {
      "id": "q.math.sets.sets-representation.0002",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "math.sets.sets-representation.core.set-notation",
          "weight": 1
        }
      ],
      "depth": 2,
      "exam_styles": [
        "jee-main"
      ],
      "stem": {
        "en": "In roster form, $\\{x : x \\in \\mathbf{N},\\ x^2 < 20\\}$ is",
        "hi": "सूचीरूप में $\\{x : x \\in \\mathbf{N},\\ x^2 < 20\\}$ है"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "$\\{1, 2, 3, 4\\}$",
            "hi": "$\\{1, 2, 3, 4\\}$"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "$\\{1, 2, 3, 4, 5\\}$",
            "hi": "$\\{1, 2, 3, 4, 5\\}$"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "$\\{0, 1, 2, 3, 4\\}$",
            "hi": "$\\{0, 1, 2, 3, 4\\}$"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "$\\{1, 4, 9, 16\\}$",
            "hi": "$\\{1, 4, 9, 16\\}$"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "The elements are the values of x.",
          "hi": "अवयव x के मान हैं।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Try natural numbers one by one until the square reaches 20.",
          "hi": "प्राकृत संख्याओं को एक-एक कर आज़माइए जब तक वर्ग 20 तक न पहुँचे।"
        },
        "steps": [
          {
            "en": "$4^2 = 16 < 20$ but $5^2 = 25 > 20$, so the elements are $1, 2, 3, 4$.",
            "hi": "$4^2 = 16 < 20$ पर $5^2 = 25 > 20$, अतः अवयव $1, 2, 3, 4$ हैं।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "$5^2 = 25$ is not less than $20$.",
              "hi": "$5^2 = 25$, $20$ से कम नहीं है।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "$0$ is not a natural number.",
              "hi": "$0$ प्राकृत संख्या नहीं है।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "These are the squares; the set holds x, not $x^2$.",
              "hi": "ये वर्ग हैं; समुच्चय में x है, $x^2$ नहीं।"
            }
          }
        ]
      },
      "ideal_time_s": 45,
      "difficulty_estimate": "easy",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
    {
      "id": "q.math.sets.sets-representation.0003",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "math.sets.sets-representation.core.set-notation",
          "weight": 1
        }
      ],
      "depth": 2,
      "exam_styles": [
        "jee-main"
      ],
      "stem": {
        "en": "Which is the set-builder form of $\\{1, 4, 9, 16, 25\\}$?",
        "hi": "$\\{1, 4, 9, 16, 25\\}$ का समुच्चय-निर्माण रूप कौन-सा है?"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "$\\{x : x = n^2,\\ n \\in \\mathbf{N},\\ n \\le 5\\}$",
            "hi": "$\\{x : x = n^2,\\ n \\in \\mathbf{N},\\ n \\le 5\\}$"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "$\\{x : x = n^2,\\ n \\in \\mathbf{N},\\ n < 5\\}$",
            "hi": "$\\{x : x = n^2,\\ n \\in \\mathbf{N},\\ n < 5\\}$"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "$\\{x : x = 2n,\\ n \\in \\mathbf{N},\\ n \\le 5\\}$",
            "hi": "$\\{x : x = 2n,\\ n \\in \\mathbf{N},\\ n \\le 5\\}$"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "$\\{x : x = n^2,\\ n \\in \\mathbf{Z},\\ n \\le 5\\}$",
            "hi": "$\\{x : x = n^2,\\ n \\in \\mathbf{Z},\\ n \\le 5\\}$"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Write each number as a square.",
          "hi": "हर संख्या को वर्ग के रूप में लिखिए।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Each listed number is a perfect square, from $1^2$ up to $5^2$.",
          "hi": "सूची की हर संख्या पूर्ण वर्ग है, $1^2$ से $5^2$ तक।"
        },
        "steps": [
          {
            "en": "$1, 4, 9, 16, 25$ are $n^2$ for $n = 1, 2, 3, 4, 5$ (NCERT §1.2).",
            "hi": "$1, 4, 9, 16, 25$ क्रमशः $n^2$ हैं, जहाँ $n = 1, 2, 3, 4, 5$ (NCERT §1.2)।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "$n < 5$ stops at $16$ and misses $25$.",
              "hi": "$n < 5$ पर $16$ तक ही आता है और $25$ छूट जाता है।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "$2n$ gives $2, 4, 6, 8, 10$.",
              "hi": "$2n$ से $2, 4, 6, 8, 10$ मिलते हैं।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "With $n \\in \\mathbf{Z}$, every negative integer is allowed and gives more squares, such as $36$ from $n = -6$.",
              "hi": "$n \\in \\mathbf{Z}$ में हर ऋण पूर्णांक भी आता है और अधिक वर्ग देता है, जैसे $36$, जो $n = -6$ से मिलता है।"
            }
          }
        ]
      },
      "ideal_time_s": 45,
      "difficulty_estimate": "medium",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
    {
      "id": "q.math.sets.sets-representation.0004",
      "type": "integer",
      "concepts": [
        {
          "id": "math.sets.sets-representation.core.set-notation",
          "weight": 1
        }
      ],
      "depth": 2,
      "exam_styles": [
        "jee-main"
      ],
      "stem": {
        "en": "How many elements does the set of letters of the word MATHEMATICS have?",
        "hi": "शब्द MATHEMATICS के अक्षरों के समुच्चय में कितने अवयव हैं?"
      },
      "answer": {
        "value": 8,
        "unit": null
      },
      "hints": [
        {
          "en": "Which letters appear more than once?",
          "hi": "कौन-से अक्षर एक से अधिक बार आते हैं?"
        }
      ],
      "solution": {
        "feynman": {
          "en": "List each different letter once; repeats do not add elements.",
          "hi": "हर भिन्न अक्षर एक बार लिखिए; दोहराव से अवयव नहीं बढ़ते।"
        },
        "steps": [
          {
            "en": "The letters are $M, A, T, H, E, I, C, S$: $8$ different letters (NCERT §1.2: elements are not repeated).",
            "hi": "अक्षर $M, A, T, H, E, I, C, S$ हैं: $8$ भिन्न अक्षर (NCERT §1.2: अवयव दोहराए नहीं जाते)।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "why": {
              "en": "Counting all eleven letters of the word counts M, A and T twice.",
              "hi": "शब्द के सभी ग्यारह अक्षर गिनने से M, A और T दो-दो बार गिने जाते हैं।"
            }
          }
        ]
      },
      "ideal_time_s": 40,
      "difficulty_estimate": "easy",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
    {
      "id": "q.math.sets.sets-representation.0005",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "math.sets.sets-representation.core.set-notation",
          "weight": 1
        }
      ],
      "depth": 3,
      "exam_styles": [
        "jee-main"
      ],
      "stem": {
        "en": "Which of these collections is a set?",
        "hi": "इनमें से कौन-सा संग्रह समुच्चय है?"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "The natural numbers less than 100 that are divisible by 7",
            "hi": "100 से कम वे प्राकृत संख्याएँ जो 7 से विभाज्य हैं"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "The tall students of a class",
            "hi": "किसी कक्षा के लंबे विद्यार्थी"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "The interesting books in a library",
            "hi": "किसी पुस्तकालय की रोचक पुस्तकें"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "The most difficult chapters of a textbook",
            "hi": "किसी पाठ्यपुस्तक के सबसे कठिन अध्याय"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Is the rule for membership objective?",
          "hi": "क्या सदस्यता का नियम वस्तुनिष्ठ है?"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Ask whether two people could disagree about membership. Divisibility by 7 leaves no room to disagree.",
          "hi": "पूछिए कि क्या सदस्यता पर दो लोग असहमत हो सकते हैं। 7 से विभाज्यता में असहमति की कोई गुंजाइश नहीं।"
        },
        "steps": [
          {
            "en": "NCERT §1.2: a set must be well defined; tall, interesting and difficult depend on the person judging.",
            "hi": "NCERT §1.2: समुच्चय सुपरिभाषित होना चाहिए; लंबा, रोचक और कठिन परखने वाले पर निर्भर हैं।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "'Tall' has no fixed cut-off.",
              "hi": "'लंबा' की कोई निश्चित सीमा नहीं है।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "'Interesting' varies from reader to reader.",
              "hi": "'रोचक' हर पाठक के लिए अलग है।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "'Most difficult' is a matter of opinion.",
              "hi": "'सबसे कठिन' राय का विषय है।"
            }
          }
        ]
      },
      "ideal_time_s": 40,
      "difficulty_estimate": "easy",
      "media": null,
      "use": [
        "practice",
