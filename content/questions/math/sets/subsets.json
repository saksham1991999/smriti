      ],
      "stem": {
        "en": "The power set of the empty set, $P(\\phi)$, is",
        "hi": "रिक्त समुच्चय का घात समुच्चय, $P(\\phi)$, है"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "$\\{\\phi\\}$",
            "hi": "$\\{\\phi\\}$"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "$\\phi$",
            "hi": "$\\phi$"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "$\\{0\\}$",
            "hi": "$\\{0\\}$"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "$\\{\\phi, \\{\\phi\\}\\}$",
            "hi": "$\\{\\phi, \\{\\phi\\}\\}$"
          }
