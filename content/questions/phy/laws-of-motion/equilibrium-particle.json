  "questions": [
    {
      "id": "q.phy.laws-of-motion.equilibrium-particle.0001",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "phy.laws-of-motion.equilibrium-particle.core.concurrent-forces-equilibrium",
          "weight": 1
        }
      ],
      "depth": 2,
      "exam_styles": [
        "jee-main",
        "neet-ug"
      ],
      "stem": {
        "en": "Forces of 3 N towards east and 4 N towards north act on a particle. The third force needed to keep it in equilibrium has magnitude",
        "hi": "किसी कण पर पूर्व की ओर 3 N और उत्तर की ओर 4 N के बल लगते हैं। उसे संतुलन में रखने के लिए आवश्यक तीसरे बल का परिमाण है"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "5 N",
            "hi": "5 N"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "7 N",
            "hi": "7 N"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "1 N",
            "hi": "1 N"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "12 N",
            "hi": "12 N"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Find the resultant first.",
          "hi": "पहले परिणामी निकालिए।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "The third force must cancel the resultant of the first two.",
          "hi": "तीसरे बल को पहले दोनों के परिणामी को निरस्त करना होगा।"
        },
        "steps": [
          {
            "en": "Resultant $= \\sqrt{3^2 + 4^2} = 5$ N; the third force is 5 N, pointing south-west.",
            "hi": "परिणामी $= \\sqrt{3^2 + 4^2} = 5$ N; तीसरा बल 5 N है, दक्षिण-पश्चिम की ओर।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "The forces are at right angles, so they do not add directly.",
              "hi": "बल समकोण पर हैं, इसलिए सीधे नहीं जुड़ते।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "That is the difference, for opposite forces.",
              "hi": "यह अंतर है, विपरीत बलों के लिए।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "Forces do not multiply.",
              "hi": "बल गुणा नहीं होते।"
            }
          }
        ]
      },
      "ideal_time_s": 30,
      "difficulty_estimate": "easy",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
    {
      "id": "q.phy.laws-of-motion.equilibrium-particle.0002",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "phy.laws-of-motion.equilibrium-particle.core.concurrent-forces-equilibrium",
          "weight": 1
        }
      ],
      "depth": 2,
      "exam_styles": [
        "jee-main",
        "neet-ug"
      ],
      "stem": {
        "en": "A 2 kg lamp hangs at rest from a single vertical string. Taking $g = 10$ m/s², the tension in the string is",
        "hi": "2 kg का लैंप एक ऊर्ध्वाधर डोरी से विराम में लटका है। $g = 10$ m/s² लेकर डोरी में तनाव है"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "20 N",
            "hi": "20 N"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "2 N",
            "hi": "2 N"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "10 N",
            "hi": "10 N"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "0",
            "hi": "0"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Two forces, equal and opposite.",
          "hi": "दो बल, समान और विपरीत।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Only two forces act: the weight and the tension.",
          "hi": "केवल दो बल लगते हैं: भार और तनाव।"
        },
        "steps": [
          {
            "en": "Equilibrium: $T = mg = 2 \\times 10 = 20$ N",
            "hi": "संतुलन: $T = mg = 2 \\times 10 = 20$ N"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "That is the mass in kg, not the force.",
              "hi": "यह kg में द्रव्यमान है, बल नहीं।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "The full weight hangs on the one string.",
              "hi": "पूरा भार एक ही डोरी पर है।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "The string must hold the lamp up.",
              "hi": "डोरी को लैंप थामना है।"
            }
          }
        ]
      },
      "ideal_time_s": 20,
      "difficulty_estimate": "easy",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
    {
      "id": "q.phy.laws-of-motion.equilibrium-particle.0003",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "phy.laws-of-motion.equilibrium-particle.core.concurrent-forces-equilibrium",
          "weight": 1
        }
      ],
      "depth": 3,
      "exam_styles": [
        "jee-main",
        "neet-ug"
      ],
      "stem": {
        "en": "A 10 kg mass hangs from the midpoint of a light string; each half makes $60°$ with the vertical. Taking $g = 10$ m/s², the tension in each half is",
        "hi": "10 kg का द्रव्यमान एक हल्की डोरी के मध्य बिंदु से लटका है; हर आधा भाग ऊर्ध्वाधर से $60°$ बनाता है। $g = 10$ m/s² लेकर हर भाग में तनाव है"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "100 N",
            "hi": "100 N"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "50 N",
            "hi": "50 N"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "57.7 N",
            "hi": "57.7 N"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "200 N",
            "hi": "200 N"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "$\\cos 60° = \\frac{1}{2}$",
          "hi": "$\\cos 60° = \\frac{1}{2}$"
        }
      ],
      "solution": {
        "feynman": {
          "en": "The vertical parts of the two tensions hold the weight.",
          "hi": "दोनों तनावों के ऊर्ध्वाधर भाग भार थामते हैं।"
        },
        "steps": [
          {
            "en": "$2T\\cos 60° = 100$, so $T = 100$ N",
            "hi": "$2T\\cos 60° = 100$, अतः $T = 100$ N"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "Half the weight is right only for vertical strings.",
              "hi": "आधा भार केवल ऊर्ध्वाधर डोरियों के लिए सही है।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "That would be for $30°$ to the vertical.",
              "hi": "यह ऊर्ध्वाधर से $30°$ के लिए होता।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "The factor of 2 for two strings was dropped.",
              "hi": "दो डोरियों का गुणक 2 छूट गया।"
            }
          }
        ]
      },
      "ideal_time_s": 40,
      "difficulty_estimate": "medium",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
    {
      "id": "q.phy.laws-of-motion.equilibrium-particle.0004",
      "type": "integer",
      "concepts": [
        {
          "id": "phy.laws-of-motion.equilibrium-particle.core.concurrent-forces-equilibrium",
          "weight": 1
        }
      ],
      "depth": 3,
      "exam_styles": [
        "jee-main"
      ],
      "stem": {
        "en": "A 3 kg bob hangs from a string. A horizontal force F holds it so that the string makes $45°$ with the vertical. Taking $g = 10$ m/s², F in newtons is",
        "hi": "3 kg का गोलक एक डोरी से लटका है। एक क्षैतिज बल F उसे ऐसे थामता है कि डोरी ऊर्ध्वाधर से $45°$ बनाती है। $g = 10$ m/s² लेकर F, न्यूटन में, है"
      },
      "answer": {
        "value": 30,
        "unit": "N"
      },
      "hints": [
        {
          "en": "$F = mg\\tan\\theta$",
          "hi": "$F = mg\\tan\\theta$"
        }
      ],
      "solution": {
        "feynman": {
          "en": "At $45°$ the horizontal and vertical parts of the tension are equal.",
          "hi": "$45°$ पर तनाव के क्षैतिज और ऊर्ध्वाधर भाग बराबर होते हैं।"
        },
        "steps": [
          {
            "en": "$T\\cos 45° = 30$ and $T\\sin 45° = F$",
            "hi": "$T\\cos 45° = 30$ और $T\\sin 45° = F$"
          },
          {
            "en": "$F = 30\\tan 45° = 30$ N",
            "hi": "$F = 30\\tan 45° = 30$ N"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "why": {
              "en": "Giving the tension, $30\\sqrt{2} \\approx 42$ N, instead of F.",
              "hi": "F के बजाय तनाव, $30\\sqrt{2} \\approx 42$ N, देना।"
            }
          }
        ]
      },
      "ideal_time_s": 40,
      "difficulty_estimate": "easy",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
    {
      "id": "q.phy.laws-of-motion.equilibrium-particle.0005",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "phy.laws-of-motion.equilibrium-particle.core.concurrent-forces-equilibrium",
          "weight": 1
        }
      ],
      "depth": 3,
      "exam_styles": [
        "jee-main",
        "neet-ug"
      ],
      "stem": {
        "en": "Which set of three forces acting on a particle can keep it in equilibrium?",
        "hi": "किसी कण पर लगे तीन बलों का कौन-सा समूह उसे संतुलन में रख सकता है?"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "3 N, 4 N, 5 N",
            "hi": "3 N, 4 N, 5 N"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "3 N, 4 N, 8 N",
            "hi": "3 N, 4 N, 8 N"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "1 N, 2 N, 4 N",
            "hi": "1 N, 2 N, 4 N"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "2 N, 3 N, 6 N",
            "hi": "2 N, 3 N, 6 N"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Triangle rule.",
          "hi": "त्रिभुज नियम।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "They must close a triangle: each force at most the sum of the other two.",
          "hi": "उन्हें त्रिभुज बंद करना होगा: हर बल अन्य दो के योग से अधिक नहीं।"
        },
        "steps": [
          {
            "en": "Two forces can make any resultant from their difference to their sum; the third must fit in that range.",
            "hi": "दो बल अपने अंतर से योग तक कोई भी परिणामी दे सकते हैं; तीसरा उसी परास में होना चाहिए।"
          },
          {
            "en": "3 and 4 give 1 to 7, which includes 5.",
            "hi": "3 और 4 से 1 से 7 मिलता है, जिसमें 5 है।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "8 is more than 3 + 4.",
              "hi": "8, 3 + 4 से अधिक है।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "4 is more than 1 + 2.",
              "hi": "4, 1 + 2 से अधिक है।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "6 is more than 2 + 3.",
              "hi": "6, 2 + 3 से अधिक है।"
            }
          }
        ]
      },
      "ideal_time_s": 40,
      "difficulty_estimate": "medium",
      "media": null,
      "use": [
        "mock"
      ],
      "source": "original"
    }
