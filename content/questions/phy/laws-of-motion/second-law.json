        {
          "id": "c",
          "text": {
            "en": "10 N",
            "hi": "10 N"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "5 N",
            "hi": "5 N"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
