    {
      "id": "q.phy.laws-of-motion.second-law.0003",
      "type": "integer",
      "concepts": [
        {
          "id": "phy.laws-of-motion.second-law.core.momentum-second-law",
          "weight": 1
        }
      ],
      "depth": 3,
      "exam_styles": [
        "jee-main"
      ],
      "stem": {
        "en": "The velocity of a 2 kg body changes uniformly from 3 m/s to 7 m/s in 2 s, in a straight line. The net force on it, in newtons, is",
        "hi": "2 kg के पिंड का वेग सरल रेखा में 2 s में 3 m/s से 7 m/s तक एकसमान रूप से बदलता है। उस पर नेट बल, न्यूटन में, है"
      },
      "answer": {
        "value": 4,
        "unit": "N"
      },
      "hints": [
        {
          "en": "$F = \\Delta p / \\Delta t$",
          "hi": "$F = \\Delta p / \\Delta t$"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Force is the rate of change of momentum.",
          "hi": "बल संवेग परिवर्तन की दर है।"
        },
        "steps": [
          {
            "en": "$\\Delta p = 2 \\times (7 - 3) = 8$ kg m/s",
            "hi": "$\\Delta p = 2 \\times (7 - 3) = 8$ kg m/s"
          },
          {
            "en": "$F = \\frac{8}{2} = 4$ N",
            "hi": "$F = \\frac{8}{2} = 4$ N"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "why": {
              "en": "Using the final momentum alone gives 7, not the change.",
              "hi": "केवल अंतिम संवेग लेने पर 7 आता है, परिवर्तन नहीं।"
            }
          }
        ]
      },
      "ideal_time_s": 40,
      "difficulty_estimate": "easy",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
    {
      "id": "q.phy.laws-of-motion.second-law.0004",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "phy.laws-of-motion.second-law.core.momentum-second-law",
          "weight": 1
        }
      ],
      "depth": 3,
      "exam_styles": [
        "jee-main",
        "neet-ug"
      ],
      "stem": {
        "en": "A force acts on a moving body at right angles to its velocity. The force changes",
        "hi": "एक गतिमान पिंड पर उसके वेग के लंबवत बल लगता है। यह बल बदलता है"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "only the component of velocity along the force",
            "hi": "वेग का केवल बल के अनुदिश घटक"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "only the component of velocity along the original motion",
            "hi": "वेग का केवल मूल गति के अनुदिश घटक"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "both components equally",
            "hi": "दोनों घटक बराबर"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "neither component",
            "hi": "कोई घटक नहीं"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Think of gravity on a projectile.",
          "hi": "प्रक्षेप्य पर गुरुत्व सोचिए।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "The second law works component by component.",
          "hi": "द्वितीय नियम घटक-दर-घटक लागू होता है।"
        },
        "steps": [
          {
            "en": "$F_x = ma_x$, $F_y = ma_y$: with no force along the original motion, that component stays fixed.",
            "hi": "$F_x = ma_x$, $F_y = ma_y$: मूल गति के अनुदिश बल न हो तो वह घटक स्थिर रहता है।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "No force acts along the original motion.",
              "hi": "मूल गति के अनुदिश कोई बल नहीं।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "The force has no component along the original motion.",
              "hi": "बल का मूल गति के अनुदिश कोई घटक नहीं।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "A net force must change the velocity.",
              "hi": "नेट बल वेग को अवश्य बदलता है।"
            }
          }
        ]
      },
      "ideal_time_s": 40,
      "difficulty_estimate": "medium",
      "media": null,
      "use": [
        "mock"
      ],
      "source": "original"
    },
    {
      "id": "q.phy.laws-of-motion.second-law.0005",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "phy.laws-of-motion.second-law.core.impulse",
          "weight": 1
        }
      ],
      "depth": 2,
      "exam_styles": [
        "jee-main",
        "neet-ug"
      ],
      "stem": {
        "en": "A 0.2 kg ball hits a wall at 10 m/s and rebounds along the same line at 10 m/s. The magnitude of the impulse on the ball is",
        "hi": "0.2 kg की गेंद 10 m/s से दीवार से टकराकर उसी रेखा पर 10 m/s से लौटती है। गेंद पर आवेग का परिमाण है"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "4 N s",
            "hi": "4 N s"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "2 N s",
            "hi": "2 N s"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "0",
            "hi": "0"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "20 N s",
            "hi": "20 N s"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Signs matter.",
          "hi": "चिह्न मायने रखते हैं।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Reversing the velocity changes the momentum by twice its size.",
          "hi": "वेग उलटने से संवेग अपने परिमाण के दोगुने से बदलता है।"
        },
        "steps": [
          {
            "en": "$\\Delta p = 0.2 \\times 10 - (-0.2 \\times 10) = 4$ N s",
            "hi": "$\\Delta p = 0.2 \\times 10 - (-0.2 \\times 10) = 4$ N s"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "That would be stopping the ball, not reversing it.",
              "hi": "यह गेंद को रोकना होता, उलटना नहीं।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "Momentum is a vector; its direction changed.",
              "hi": "संवेग सदिश है; उसकी दिशा बदली।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "The mass was not used correctly.",
              "hi": "द्रव्यमान ठीक से नहीं लगाया गया।"
            }
          }
        ]
      },
      "ideal_time_s": 30,
      "difficulty_estimate": "easy",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
    {
      "id": "q.phy.laws-of-motion.second-law.0006",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "phy.laws-of-motion.second-law.core.impulse",
          "weight": 1
        }
      ],
      "depth": 2,
      "exam_styles": [
        "jee-main",
        "neet-ug"
      ],
      "stem": {
        "en": "A fielder pulls his hands back while catching a fast ball because this",
        "hi": "क्षेत्ररक्षक तेज़ गेंद पकड़ते समय हाथ पीछे खींचता है क्योंकि इससे"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "increases the time of stopping, so the force is smaller",
            "hi": "रुकने का समय बढ़ता है, इसलिए बल कम होता है"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "reduces the change in momentum of the ball",
            "hi": "गेंद का संवेग परिवर्तन कम होता है"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "increases the impulse on the hands",
            "hi": "हाथों पर आवेग बढ़ता है"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "reduces the mass of the ball",
            "hi": "गेंद का द्रव्यमान घटता है"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Which factor in $F\\,\\Delta t$ changes?",
          "hi": "$F\\,\\Delta t$ में कौन-सा गुणक बदलता है?"
        }
      ],
      "solution": {
        "feynman": {
          "en": "The change in momentum is fixed; spreading it over more time lowers the force.",
          "hi": "संवेग परिवर्तन निश्चित है; उसे अधिक समय में फैलाने से बल घटता है।"
        },
        "steps": [
          {
            "en": "$F = \\Delta p / \\Delta t$: same $\\Delta p$, larger $\\Delta t$, smaller F.",
            "hi": "$F = \\Delta p / \\Delta t$: वही $\\Delta p$, बड़ा $\\Delta t$, छोटा F।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "The ball still goes from moving to stopped.",
              "hi": "गेंद फिर भी गति से विराम तक जाती है।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "The impulse equals the same change in momentum.",
              "hi": "आवेग उसी संवेग परिवर्तन के बराबर है।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "Mass does not change.",
              "hi": "द्रव्यमान नहीं बदलता।"
            }
          }
        ]
      },
      "ideal_time_s": 25,
      "difficulty_estimate": "easy",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
