    {
      "id": "q.phy.laws-of-motion.second-law.0001",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "phy.laws-of-motion.second-law.core.momentum-second-law",
          "weight": 1
        }
      ],
      "depth": 2,
      "exam_styles": [
        "jee-main",
        "neet-ug"
      ],
      "stem": {
        "en": "A net force acts on a 5 kg body and gives it an acceleration of 2 m/s². The force is",
        "hi": "5 kg के पिंड पर एक नेट बल लगकर उसे 2 m/s² का त्वरण देता है। बल है"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "10 N",
            "hi": "10 N"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "2.5 N",
            "hi": "2.5 N"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "7 N",
            "hi": "7 N"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "0.4 N",
            "hi": "0.4 N"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "$F = ma$",
          "hi": "$F = ma$"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Force is mass times acceleration.",
          "hi": "बल द्रव्यमान गुणा त्वरण है।"
        },
        "steps": [
          {
            "en": "$F = ma = 5 \\times 2 = 10$ N",
            "hi": "$F = ma = 5 \\times 2 = 10$ N"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "That divides mass by acceleration.",
              "hi": "यह द्रव्यमान को त्वरण से भाग देता है।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "Mass and acceleration do not add.",
              "hi": "द्रव्यमान और त्वरण जुड़ते नहीं।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "That divides acceleration by mass.",
              "hi": "यह त्वरण को द्रव्यमान से भाग देता है।"
            }
          }
        ]
      },
