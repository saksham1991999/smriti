      ],
      "stem": {
        "en": "A 50 kg person stands on a weighing scale in a lift accelerating upwards at 2 m/s². Taking $g = 10$ m/s², the scale reads a force of",
        "hi": "50 kg का एक व्यक्ति ऊपर की ओर 2 m/s² से त्वरित लिफ़्ट में तराज़ू पर खड़ा है। $g = 10$ m/s² लेकर तराज़ू कितना बल दिखाता है?"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "600 N",
            "hi": "600 N"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "500 N",
            "hi": "500 N"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "400 N",
            "hi": "400 N"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "100 N",
            "hi": "100 N"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Draw the two forces on the person.",
          "hi": "व्यक्ति पर दोनों बल बनाइए।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "The scale must push harder than the weight to accelerate the person upwards.",
          "hi": "व्यक्ति को ऊपर त्वरित करने के लिए तराज़ू को भार से अधिक धकेलना पड़ता है।"
        },
        "steps": [
          {
            "en": "$R - mg = ma$, so $R = 50 \\times (10 + 2) = 600$ N",
            "hi": "$R - mg = ma$, अतः $R = 50 \\times (10 + 2) = 600$ N"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "That is the weight, true only without acceleration.",
              "hi": "यह भार है, केवल त्वरण न होने पर सही।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "That is for a downward acceleration.",
              "hi": "यह नीचे की ओर त्वरण के लिए है।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "That is only the extra force, ma.",
              "hi": "यह केवल अतिरिक्त बल ma है।"
            }
          }
        ]
      },
