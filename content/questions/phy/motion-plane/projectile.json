      ],
      "stem": {
        "en": "A ball is projected at 20 m/s at $30°$ above the horizontal. Taking $g = 10$ m/s², its maximum height, in metres, is",
        "hi": "एक गेंद क्षैतिज से $30°$ ऊपर 20 m/s से प्रक्षेपित की जाती है। $g = 10$ m/s² लेकर उसकी अधिकतम ऊँचाई, मीटर में, है"
      },
      "answer": {
        "value": 5,
        "unit": "m"
      },
      "hints": [
        {
          "en": "$h_m = (v_0\\sin\\theta_0)^2/2g$",
          "hi": "$h_m = (v_0\\sin\\theta_0)^2/2g$"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Only the vertical launch speed, $v_0\\sin\\theta_0$, lifts the ball.",
          "hi": "केवल ऊर्ध्वाधर प्रक्षेपण चाल, $v_0\\sin\\theta_0$, गेंद को उठाती है।"
        },
        "steps": [
          {
            "en": "$v_0\\sin 30° = 10$ m/s",
            "hi": "$v_0\\sin 30° = 10$ m/s"
          },
          {
            "en": "$h_m = \\frac{10^2}{2 \\times 10} = 5$ m",
            "hi": "$h_m = \\frac{10^2}{2 \\times 10} = 5$ m"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "why": {
              "en": "Using the full speed 20 m/s gives 20 m.",
              "hi": "पूरी चाल 20 m/s लेने पर 20 m आता है।"
            }
          }
        ]
      },
      "ideal_time_s": 40,
      "difficulty_estimate": "easy",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
    {
      "id": "q.phy.motion-plane.projectile.0005",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "phy.motion-plane.projectile.core.projectile-motion",
          "weight": 1
        }
      ],
      "depth": 3,
      "exam_styles": [
        "jee-main",
        "neet-ug"
      ],
      "stem": {
        "en": "A ball rolls off a table 80 cm high with a horizontal speed of 2 m/s. Taking $g = 10$ m/s², it lands at a horizontal distance from the table's edge of",
        "hi": "एक गेंद 80 cm ऊँची मेज़ से 2 m/s की क्षैतिज चाल से लुढ़ककर गिरती है। $g = 10$ m/s² लेकर वह मेज़ के किनारे से कितनी क्षैतिज दूरी पर गिरती है?"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "0.8 m",
            "hi": "0.8 m"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "0.4 m",
            "hi": "0.4 m"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "1.6 m",
            "hi": "1.6 m"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "8 m",
            "hi": "8 m"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Convert 80 cm to metres.",
          "hi": "80 cm को मीटर में बदलिए।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Find the falling time from the height, then multiply by the horizontal speed.",
          "hi": "ऊँचाई से गिरने का समय निकालिए, फिर क्षैतिज चाल से गुणा कीजिए।"
        },
        "steps": [
          {
            "en": "$0.8 = \\frac{1}{2} \\times 10 \\times t^2$ gives $t = 0.4$ s.",
            "hi": "$0.8 = \\frac{1}{2} \\times 10 \\times t^2$ से $t = 0.4$ s।"
          },
          {
            "en": "$x = 2 \\times 0.4 = 0.8$ m",
            "hi": "$x = 2 \\times 0.4 = 0.8$ m"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "That is the time in seconds, not the distance.",
              "hi": "यह सेकंड में समय है, दूरी नहीं।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "The time was doubled, as if the ball went up first.",
              "hi": "समय दोगुना कर दिया गया, मानो गेंद पहले ऊपर गई।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "That treats 80 cm as 80 m.",
              "hi": "यह 80 cm को 80 m मान लेता है।"
            }
          }
        ]
      },
      "ideal_time_s": 50,
      "difficulty_estimate": "medium",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
