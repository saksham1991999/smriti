        },
        "steps": [
          {
            "en": "$h_m = \\frac{v_0^2 \\sin^2 45°}{2g} = \\frac{v_0^2}{4g}$; $R = \\frac{v_0^2}{g}$",
            "hi": "$h_m = \\frac{v_0^2 \\sin^2 45°}{2g} = \\frac{v_0^2}{4g}$; $R = \\frac{v_0^2}{g}$"
          },
          {
            "en": "Ratio $= 1 : 4$",
            "hi": "अनुपात $= 1 : 4$"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "The $\\sin^2 45° = \\frac{1}{2}$ factor was missed.",
              "hi": "$\\sin^2 45° = \\frac{1}{2}$ गुणक छूट गया।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "Height and range are not equal at 45°.",
              "hi": "45° पर ऊँचाई और परास बराबर नहीं होते।"
            }
          },
          {
            "option_id": "d",
            "why": {
