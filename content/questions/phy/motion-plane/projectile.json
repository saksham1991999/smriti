      "stem": {
        "en": "The path of a projectile is $y = x - \\frac{x^2}{20}$, with x and y in metres. Its horizontal range is",
        "hi": "किसी प्रक्षेप्य का पथ $y = x - \\frac{x^2}{20}$ है, जहाँ x और y मीटर में हैं। उसका क्षैतिज परास है"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "20 m",
            "hi": "20 m"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "10 m",
            "hi": "10 m"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "5 m",
            "hi": "5 m"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "40 m",
            "hi": "40 m"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Set y = 0.",
          "hi": "y = 0 रखिए।"
        }
      ],
