      "id": "q.phy.motion-plane.projectile.0001",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "phy.motion-plane.projectile.core.projectile-motion",
          "weight": 1
        }
      ],
      "depth": 2,
      "exam_styles": [
        "jee-main",
        "neet-ug"
      ],
      "stem": {
        "en": "At the highest point of a projectile's path (no air resistance), its",
        "hi": "किसी प्रक्षेप्य के पथ के सर्वोच्च बिंदु पर (वायु प्रतिरोध नहीं), उसका"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "velocity is horizontal and acceleration is g downwards",
            "hi": "वेग क्षैतिज है और त्वरण नीचे की ओर g है"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "velocity and acceleration are both zero",
            "hi": "वेग और त्वरण दोनों शून्य हैं"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "velocity is zero and acceleration is g downwards",
            "hi": "वेग शून्य है और त्वरण नीचे की ओर g है"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "velocity is horizontal and acceleration is zero",
            "hi": "वेग क्षैतिज है और त्वरण शून्य है"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Treat the two components separately.",
          "hi": "दोनों घटक अलग-अलग देखिए।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Only the vertical motion pauses; gravity never switches off.",
          "hi": "केवल ऊर्ध्वाधर गति रुकती है; गुरुत्व कभी बंद नहीं होता।"
        },
        "steps": [
          {
            "en": "$v_y = 0$ at the top, $v_x = v_0\\cos\\theta_0$ is unchanged, and $\\vec{a} = -g\\,\\hat{j}$ throughout.",
            "hi": "शीर्ष पर $v_y = 0$, $v_x = v_0\\cos\\theta_0$ अपरिवर्तित, और $\\vec{a} = -g\\,\\hat{j}$ पूरे समय।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "Both the horizontal velocity and g remain.",
              "hi": "क्षैतिज वेग और g दोनों बने रहते हैं।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "The horizontal velocity does not vanish.",
              "hi": "क्षैतिज वेग शून्य नहीं होता।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "Gravity still acts at the top.",
              "hi": "शीर्ष पर भी गुरुत्व लगता है।"
            }
          }
        ]
      },
      "ideal_time_s": 30,
      "difficulty_estimate": "easy",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
    {
      "id": "q.phy.motion-plane.projectile.0002",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "phy.motion-plane.projectile.core.projectile-motion",
          "weight": 1
        }
      ],
      "depth": 3,
      "exam_styles": [
        "jee-main",
        "neet-ug"
      ],
      "stem": {
        "en": "A ball is projected at 20 m/s at $30°$ above the horizontal. Taking $g = 10$ m/s², its time of flight is",
        "hi": "एक गेंद क्षैतिज से $30°$ ऊपर 20 m/s से प्रक्षेपित की जाती है। $g = 10$ m/s² लेकर उसका उड़ान का समय है"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "2 s",
            "hi": "2 s"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "1 s",
            "hi": "1 s"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "$2\\sqrt{3}$ s",
            "hi": "$2\\sqrt{3}$ s"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "4 s",
            "hi": "4 s"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "$T_f = 2v_0\\sin\\theta_0/g$",
          "hi": "$T_f = 2v_0\\sin\\theta_0/g$"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Only the vertical part of the launch decides the time.",
          "hi": "केवल प्रक्षेपण का ऊर्ध्वाधर भाग समय तय करता है।"
        },
        "steps": [
          {
            "en": "$T_f = \\frac{2 \\times 20 \\times \\sin 30°}{10} = 2$ s",
            "hi": "$T_f = \\frac{2 \\times 20 \\times \\sin 30°}{10} = 2$ s"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "That is the time to the top only.",
              "hi": "यह केवल शीर्ष तक का समय है।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "That uses $\\cos 30°$.",
              "hi": "इसमें $\\cos 30°$ लगा है।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "That ignores the $\\sin 30°$ factor.",
              "hi": "इसमें $\\sin 30°$ गुणक छूट गया है।"
            }
          }
        ]
      },
      "ideal_time_s": 40,
      "difficulty_estimate": "easy",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
    {
      "id": "q.phy.motion-plane.projectile.0003",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "phy.motion-plane.projectile.core.projectile-motion",
          "weight": 1
        }
      ],
      "depth": 3,
      "exam_styles": [
        "jee-main",
        "neet-ug"
      ],
      "stem": {
        "en": "A stone thrown at $25°$ to the horizontal lands 30 m away on level ground. Thrown at the same speed, which other angle gives the same range?",
        "hi": "क्षैतिज से $25°$ पर फेंका गया एक पत्थर समतल ज़मीन पर 30 m दूर गिरता है। उसी चाल से फेंकने पर कौन-सा दूसरा कोण वही परास देता है?"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "$65°$",
            "hi": "$65°$"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "$50°$",
            "hi": "$50°$"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "$45°$",
            "hi": "$45°$"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "$75°$",
            "hi": "$75°$"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Complementary angles.",
          "hi": "पूरक कोण।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Angles 20° either side of 45° give the same range.",
          "hi": "45° के दोनों ओर 20° वाले कोण वही परास देते हैं।"
        },
        "steps": [
          {
            "en": "$\\sin(2 \\times 25°) = \\sin 50° = \\sin 130° = \\sin(2 \\times 65°)$",
            "hi": "$\\sin(2 \\times 25°) = \\sin 50° = \\sin 130° = \\sin(2 \\times 65°)$"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "Doubling the angle does not give the partner angle.",
              "hi": "कोण दोगुना करने से साथी कोण नहीं मिलता।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "45° gives the maximum range, which is more than 30 m.",
              "hi": "45° अधिकतम परास देता है, जो 30 m से अधिक है।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "$\\sin 150° = \\sin 30°$, not $\\sin 50°$.",
              "hi": "$\\sin 150° = \\sin 30°$, $\\sin 50°$ नहीं।"
            }
          }
        ]
      },
      "ideal_time_s": 30,
      "difficulty_estimate": "easy",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
    {
