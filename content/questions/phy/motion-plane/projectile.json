      "stem": {
        "en": "For a projectile launched at $45°$ on level ground, the ratio of its maximum height to its range is",
        "hi": "समतल ज़मीन पर $45°$ पर प्रक्षेपित प्रक्षेप्य की अधिकतम ऊँचाई और परास का अनुपात है"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "1 : 4",
            "hi": "1 : 4"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "1 : 2",
            "hi": "1 : 2"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "1 : 1",
            "hi": "1 : 1"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "4 : 1",
            "hi": "4 : 1"
          }
        }
      ],
      "answer": {
