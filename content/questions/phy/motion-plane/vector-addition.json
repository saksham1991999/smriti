      "stem": {
        "en": "Vectors $\\vec{A}$ and $\\vec{B}$ are perpendicular, with magnitudes 6 units and 8 units. The magnitude of $\\vec{A} - \\vec{B}$ is",
        "hi": "सदिश $\\vec{A}$ और $\\vec{B}$ लंबवत हैं, और उनके परिमाण 6 मात्रक और 8 मात्रक हैं। $\\vec{A} - \\vec{B}$ का परिमाण है"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "10 units",
            "hi": "10 मात्रक"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "2 units",
            "hi": "2 मात्रक"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "14 units",
            "hi": "14 मात्रक"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "48 units",
            "hi": "48 मात्रक"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Reversing B keeps the right angle.",
          "hi": "B को उलटने पर भी समकोण बना रहता है।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "$-\\vec{B}$ is still perpendicular to $\\vec{A}$.",
          "hi": "$-\\vec{B}$ अब भी $\\vec{A}$ के लंबवत है।"
        },
        "steps": [
          {
            "en": "$|\\vec{A} - \\vec{B}| = \\sqrt{6^2 + 8^2} = 10$ units",
            "hi": "$|\\vec{A} - \\vec{B}| = \\sqrt{6^2 + 8^2} = 10$ मात्रक"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "Subtracting magnitudes works only for vectors along one line.",
              "hi": "परिमाण घटाना केवल एक रेखा के सदिशों के लिए ठीक है।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "Adding magnitudes works only for parallel vectors.",
              "hi": "परिमाण जोड़ना केवल समांतर सदिशों के लिए ठीक है।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "Magnitudes do not multiply.",
              "hi": "परिमाण गुणा नहीं होते।"
            }
          }
        ]
      },
      "ideal_time_s": 30,
