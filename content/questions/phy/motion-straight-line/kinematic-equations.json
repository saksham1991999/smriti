    {
      "id": "q.phy.motion-straight-line.kinematic-equations.0006",
      "type": "integer",
      "concepts": [
        {
          "id": "phy.motion-straight-line.kinematic-equations.core.equations-of-motion",
          "weight": 1
        }
      ],
      "depth": 3,
      "exam_styles": [
        "jee-main"
      ],
      "stem": {
        "en": "A train moving at 20 m/s is brought to rest with uniform retardation over 100 m. How many seconds does it take to stop?",
        "hi": "20 m/s से चलती एक रेलगाड़ी एकसमान मंदन से 100 m में रोकी जाती है। उसे रुकने में कितने सेकंड लगते हैं?"
      },
      "answer": {
        "value": 10,
        "unit": null
      },
      "hints": [
        {
          "en": "Average velocity is $\\frac{20 + 0}{2} = 10$ m/s.",
          "hi": "औसत वेग $\\frac{20 + 0}{2} = 10$ m/s है।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Find the retardation from the distance, then the time.",
          "hi": "दूरी से मंदन निकालिए, फिर समय।"
        },
        "steps": [
          {
            "en": "$0 = 20^2 + 2a(100)$, so $a = -2$ m/s².",
            "hi": "$0 = 20^2 + 2a(100)$, अतः $a = -2$ m/s²।"
          },
          {
            "en": "$0 = 20 - 2t$, so $t = 10$ s.",
            "hi": "$0 = 20 - 2t$, अतः $t = 10$ s।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "why": {
              "en": "Dividing 100 m by 20 m/s gives 5 s, which assumes constant speed.",
              "hi": "100 m को 20 m/s से भाग देने पर 5 s आता है, जो नियत चाल मानता है।"
            }
          }
        ]
      },
      "ideal_time_s": 60,
      "difficulty_estimate": "medium",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
    {
      "id": "q.phy.motion-straight-line.kinematic-equations.0007",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "phy.motion-straight-line.kinematic-equations.core.equations-of-motion",
          "weight": 1
        }
      ],
      "depth": 3,
      "exam_styles": [
        "jee-main",
        "neet-ug"
      ],
      "stem": {
        "en": "A body falls freely from rest. The distances it falls in the first, second and third equal intervals of time are in the ratio",
        "hi": "एक वस्तु विराम से मुक्त रूप से गिरती है। पहले, दूसरे और तीसरे समान समय अंतरालों में उसके द्वारा तय दूरियों का अनुपात है"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "1 : 3 : 5",
            "hi": "1 : 3 : 5"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "1 : 2 : 3",
            "hi": "1 : 2 : 3"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "1 : 4 : 9",
            "hi": "1 : 4 : 9"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "1 : 1 : 1",
            "hi": "1 : 1 : 1"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Subtract the running totals.",
          "hi": "क्रमिक योग घटाइए।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Total distances go as 1, 4, 9; the differences are 1, 3, 5.",
          "hi": "कुल दूरियाँ 1, 4, 9 के अनुसार; अंतर 1, 3, 5 हैं।"
        },
        "steps": [
          {
            "en": "Galileo's law of odd numbers (NCERT keph102 Example 2.5).",
