    {
      "id": "q.phy.motion-straight-line.kinematic-equations.0001",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "phy.motion-straight-line.kinematic-equations.core.equations-of-motion",
          "weight": 1
        }
      ],
      "depth": 2,
      "exam_styles": [
        "jee-main",
        "neet-ug"
      ],
      "stem": {
        "en": "A car starts from rest with a uniform acceleration of 2 m/s². Its velocity after 5 s is",
        "hi": "एक कार विराम से 2 m/s² के एकसमान त्वरण से चलती है। 5 s बाद उसका वेग है"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "10 m/s",
            "hi": "10 m/s"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "25 m/s",
            "hi": "25 m/s"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "5 m/s",
            "hi": "5 m/s"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "20 m/s",
            "hi": "20 m/s"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "$v = v_0 + at$",
          "hi": "$v = v_0 + at$"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Each second adds 2 m/s.",
          "hi": "हर सेकंड 2 m/s जोड़ता है।"
        },
        "steps": [
          {
            "en": "$v = 0 + 2 \\times 5 = 10$ m/s",
            "hi": "$v = 0 + 2 \\times 5 = 10$ m/s"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "That is the distance $\\frac{1}{2}at^2$ in metres.",
              "hi": "यह मीटर में दूरी $\\frac{1}{2}at^2$ है।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "Not what the numbers give.",
              "hi": "संख्याओं से यह नहीं आता।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "This doubles the correct value.",
              "hi": "यह सही मान का दोगुना है।"
            }
          }
        ]
      },
      "ideal_time_s": 30,
      "difficulty_estimate": "easy",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
    {
      "id": "q.phy.motion-straight-line.kinematic-equations.0002",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "phy.motion-straight-line.kinematic-equations.core.equations-of-motion",
          "weight": 1
        }
      ],
      "depth": 3,
      "exam_styles": [
        "jee-main",
        "neet-ug"
      ],
      "stem": {
        "en": "A stone is dropped from rest from a height of 45 m. Taking g = 10 m/s², it reaches the ground after",
        "hi": "एक पत्थर 45 m की ऊँचाई से विराम से गिराया जाता है। g = 10 m/s² लें, तो यह धरती पर पहुँचता है"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "3 s",
            "hi": "3 s"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "4.5 s",
            "hi": "4.5 s"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "9 s",
            "hi": "9 s"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "2 s",
            "hi": "2 s"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Solve for $t^2$ first.",
          "hi": "पहले $t^2$ निकालिए।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Distance fallen from rest is $\\frac{1}{2}gt^2$.",
          "hi": "विराम से गिरने की दूरी $\\frac{1}{2}gt^2$ है।"
        },
        "steps": [
          {
            "en": "$45 = \\frac{1}{2} \\times 10 \\times t^2$, so $t^2 = 9$ and $t = 3$ s",
            "hi": "$45 = \\frac{1}{2} \\times 10 \\times t^2$, अतः $t^2 = 9$ और $t = 3$ s"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "This divides 45 by 10, as if the speed were constant.",
              "hi": "यह 45 को 10 से भाग देता है, मानो चाल नियत हो।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "That is $t^2$, not t.",
              "hi": "यह $t^2$ है, t नहीं।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "Not what the numbers give.",
              "hi": "संख्याओं से यह नहीं आता।"
            }
          }
        ]
      },
      "ideal_time_s": 45,
      "difficulty_estimate": "easy",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
    {
      "id": "q.phy.motion-straight-line.kinematic-equations.0003",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "phy.motion-straight-line.kinematic-equations.core.equations-of-motion",
          "weight": 1
        }
      ],
      "depth": 2,
      "exam_styles": [
        "jee-main",
        "neet-ug"
      ],
      "stem": {
        "en": "With the same braking deceleration, if a vehicle's initial speed is doubled, its stopping distance becomes",
        "hi": "समान ब्रेकिंग मंदन के साथ, यदि किसी वाहन की प्रारंभिक चाल दोगुनी कर दी जाए, तो उसकी रुकने की दूरी हो जाती है"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "four times",
            "hi": "चार गुनी"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "twice",
            "hi": "दोगुनी"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "the same",
            "hi": "उतनी ही"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "half",
            "hi": "आधी"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Use $v^2 = v_0^2 + 2ax$ with $v = 0$.",
          "hi": "$v^2 = v_0^2 + 2ax$ लगाइए, $v = 0$ रखकर।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Stopping distance goes as the square of the speed.",
          "hi": "रुकने की दूरी चाल के वर्ग के अनुसार है।"
        },
        "steps": [
          {
            "en": "$d_s = \\frac{v_0^2}{2|a|}$, so $2v_0$ gives $4d_s$ (NCERT keph102 Example 2.6).",
            "hi": "$d_s = \\frac{v_0^2}{2|a|}$, अतः $2v_0$ से $4d_s$ मिलता है (NCERT keph102 उदाहरण 2.6)।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "That would need $d_s$ proportional to $v_0$.",
              "hi": "इसके लिए $d_s$ का $v_0$ के अनुक्रमानुपाती होना चाहिए।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "Faster cars need more room to stop.",
              "hi": "तेज़ कारों को रुकने के लिए अधिक जगह चाहिए।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "The distance grows, not shrinks.",
              "hi": "दूरी बढ़ती है, घटती नहीं।"
            }
          }
        ]
      },
      "ideal_time_s": 30,
      "difficulty_estimate": "easy",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
    {
      "id": "q.phy.motion-straight-line.kinematic-equations.0004",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "phy.motion-straight-line.kinematic-equations.core.equations-of-motion",
          "weight": 1
        }
      ],
      "depth": 2,
      "exam_styles": [
        "jee-main",
        "neet-ug"
      ],
      "stem": {
        "en": "The equations $v = v_0 + at$, $x = v_0 t + \\frac{1}{2}at^2$ and $v^2 = v_0^2 + 2ax$ can be used when",
        "hi": "समीकरण $v = v_0 + at$, $x = v_0 t + \\frac{1}{2}at^2$ और $v^2 = v_0^2 + 2ax$ तब लगाए जा सकते हैं जब"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "the acceleration is constant in magnitude and direction",
            "hi": "त्वरण परिमाण और दिशा में नियत हो"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "the velocity is constant",
            "hi": "वेग नियत हो"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "the motion is of any kind",
            "hi": "गति किसी भी प्रकार की हो"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "the acceleration increases uniformly",
            "hi": "त्वरण एकसमान रूप से बढ़े"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "What did the derivation assume?",
          "hi": "व्युत्पत्ति में क्या माना गया?"
        }
      ],
      "solution": {
        "feynman": {
          "en": "They were derived assuming a fixed a.",
          "hi": "ये नियत a मानकर निकाले गए थे।"
        },
        "steps": [
          {
            "en": "NCERT keph102 Points to Ponder 6.",
            "hi": "NCERT keph102 विचारणीय विषय 6।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "Constant velocity is only the special case $a = 0$.",
              "hi": "नियत वेग केवल विशेष स्थिति $a = 0$ है।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "For changing a, use the calculus definitions.",
              "hi": "बदलते a के लिए कलन वाली परिभाषाएँ लगाइए।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "A changing acceleration breaks the derivation.",
              "hi": "बदलता त्वरण व्युत्पत्ति को तोड़ देता है।"
            }
          }
        ]
      },
      "ideal_time_s": 30,
      "difficulty_estimate": "easy",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
