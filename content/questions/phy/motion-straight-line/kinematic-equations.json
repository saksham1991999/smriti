        }
      ],
      "depth": 4,
      "exam_styles": [
        "jee-main",
        "neet-ug"
      ],
      "stem": {
        "en": "A ball is thrown vertically up at 10 m/s from the top of a tower 15 m high. Taking g = 10 m/s², it hits the ground after",
        "hi": "15 m ऊँचे टावर की चोटी से एक गेंद 10 m/s से ऊर्ध्वाधर ऊपर फेंकी जाती है। g = 10 m/s² लें, तो यह धरती से टकराती है"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "3 s",
            "hi": "3 s"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "1 s",
            "hi": "1 s"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "2 s",
            "hi": "2 s"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "4 s",
            "hi": "4 s"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Put the final position as $y = 0$.",
          "hi": "अंतिम स्थिति $y = 0$ रखिए।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "One equation covers the whole flight; the ground is 15 m below the start.",
          "hi": "एक समीकरण पूरी उड़ान के लिए है; धरती आरंभ से 15 m नीचे है।"
        },
        "steps": [
          {
            "en": "Up positive, origin at the ground: $0 = 15 + 10t - 5t^2$.",
            "hi": "ऊपर धनात्मक, मूल बिंदु धरती पर: $0 = 15 + 10t - 5t^2$।"
          },
          {
            "en": "$t^2 - 2t - 3 = 0$, so $t = 3$ s (the negative root is rejected).",
            "hi": "$t^2 - 2t - 3 = 0$, अतः $t = 3$ s (ऋणात्मक मूल अस्वीकार)।"
          }
        ],
