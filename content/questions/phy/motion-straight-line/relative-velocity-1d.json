      "stem": {
        "en": "A passenger walks at 1 m/s towards the back of a train moving east at 15 m/s. Her velocity with respect to the ground is",
        "hi": "पूर्व की ओर 15 m/s से चलती रेलगाड़ी में एक यात्री पीछे की ओर 1 m/s से चलती है। धरती के सापेक्ष उसका वेग है"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "14 m/s east",
            "hi": "14 m/s पूर्व"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "16 m/s east",
            "hi": "16 m/s पूर्व"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "14 m/s west",
            "hi": "14 m/s पश्चिम"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "1 m/s west",
            "hi": "1 m/s पश्चिम"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Which frame is each number measured in?",
          "hi": "हर संख्या किस तंत्र में मापी गई है?"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Her velocity relative to the train plus the train's velocity.",
          "hi": "रेलगाड़ी के सापेक्ष उसका वेग धन रेलगाड़ी का वेग।"
        },
        "steps": [
          {
            "en": "East positive: $v = 15 + (-1) = +14$ m/s",
            "hi": "पूर्व धनात्मक: $v = 15 + (-1) = +14$ m/s"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "Walking towards the back subtracts.",
              "hi": "पीछे की ओर चलना घटाता है।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "The train carries her east.",
              "hi": "रेलगाड़ी उसे पूर्व की ओर ले जाती है।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "That is her velocity relative to the train.",
              "hi": "यह रेलगाड़ी के सापेक्ष उसका वेग है।"
            }
          }
        ]
      },
