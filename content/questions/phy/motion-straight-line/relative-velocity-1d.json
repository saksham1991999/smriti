    {
      "id": "q.phy.motion-straight-line.relative-velocity-1d.0001",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "phy.motion-straight-line.relative-velocity-1d.core.relative-velocity",
          "weight": 1
        }
      ],
      "depth": 2,
      "exam_styles": [
        "jee-main",
        "neet-ug"
      ],
      "stem": {
        "en": "Two cars move east on a straight road at 60 km/h and 40 km/h. The velocity of the faster car relative to the slower one is",
        "hi": "सीधी सड़क पर दो कारें पूर्व की ओर 60 km/h और 40 km/h से चल रही हैं। धीमी कार के सापेक्ष तेज़ कार का वेग है"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "20 km/h east",
            "hi": "20 km/h पूर्व"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "100 km/h east",
            "hi": "100 km/h पूर्व"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "20 km/h west",
            "hi": "20 km/h पश्चिम"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "zero",
            "hi": "शून्य"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "$v_1 - v_2$",
          "hi": "$v_1 - v_2$"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Same direction: subtract.",
          "hi": "एक ही दिशा: घटाइए।"
        },
        "steps": [
          {
            "en": "$v_{12} = 60 - 40 = +20$ km/h",
            "hi": "$v_{12} = 60 - 40 = +20$ km/h"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "Speeds add only for opposite directions.",
              "hi": "चालें केवल विपरीत दिशाओं में जुड़ती हैं।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "That is the slower car relative to the faster.",
              "hi": "यह तेज़ के सापेक्ष धीमी कार है।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "Their velocities differ.",
              "hi": "उनके वेग अलग हैं।"
            }
          }
        ]
      },
      "ideal_time_s": 30,
      "difficulty_estimate": "easy",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
    {
      "id": "q.phy.motion-straight-line.relative-velocity-1d.0002",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "phy.motion-straight-line.relative-velocity-1d.core.relative-velocity",
          "weight": 1
        }
      ],
      "depth": 2,
      "exam_styles": [
        "jee-main",
        "neet-ug"
      ],
      "stem": {
        "en": "Two trains on parallel tracks approach each other, each at 50 km/h with respect to the ground. The speed of one as seen by a passenger in the other is",
        "hi": "समांतर पटरियों पर दो रेलगाड़ियाँ एक-दूसरे की ओर आ रही हैं, हर एक धरती के सापेक्ष 50 km/h से। एक रेलगाड़ी के यात्री को दूसरी की चाल दिखती है"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "100 km/h",
            "hi": "100 km/h"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "0",
            "hi": "0"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "50 km/h",
            "hi": "50 km/h"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "25 km/h",
            "hi": "25 km/h"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Give one train a minus sign.",
          "hi": "एक रेलगाड़ी को ऋण चिह्न दीजिए।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Opposite directions: the speeds add.",
          "hi": "विपरीत दिशाएँ: चालें जुड़ती हैं।"
        },
        "steps": [
          {
            "en": "$v_{12} = 50 - (-50) = 100$ km/h",
            "hi": "$v_{12} = 50 - (-50) = 100$ km/h"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "Zero would mean they move together the same way.",
              "hi": "शून्य का अर्थ होगा कि वे एक ही ओर साथ चल रही हैं।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "That is the speed with respect to the ground.",
              "hi": "यह धरती के सापेक्ष चाल है।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "Not what the signs give.",
              "hi": "चिह्नों से यह नहीं आता।"
            }
          }
        ]
      },
      "ideal_time_s": 30,
      "difficulty_estimate": "easy",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
    {
      "id": "q.phy.motion-straight-line.relative-velocity-1d.0003",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "phy.motion-straight-line.relative-velocity-1d.core.relative-velocity",
          "weight": 1
        }
      ],
      "depth": 3,
      "exam_styles": [
        "jee-main",
        "neet-ug"
      ],
      "stem": {
        "en": "A police van moving at 10 m/s fires a bullet forward with a muzzle speed of 100 m/s relative to the van, at a car ahead moving away at 20 m/s in the same direction. The speed with which the bullet hits the car is",
        "hi": "10 m/s से चलती पुलिस वैन वैन के सापेक्ष 100 m/s की नालमुख चाल से आगे की ओर गोली चलाती है, जो उसी दिशा में 20 m/s से दूर जाती आगे की कार पर लगती है। गोली कार से जिस चाल से टकराती है, वह है"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "90 m/s",
            "hi": "90 m/s"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "110 m/s",
            "hi": "110 m/s"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "130 m/s",
            "hi": "130 m/s"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "80 m/s",
            "hi": "80 m/s"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Two steps: van to ground, ground to car.",
          "hi": "दो चरण: वैन से धरती, धरती से कार।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Find the bullet's ground velocity, then subtract the car's.",
          "hi": "गोली का धरती के सापेक्ष वेग निकालिए, फिर कार का घटाइए।"
        },
        "steps": [
          {
            "en": "Bullet relative to ground: $100 + 10 = 110$ m/s.",
            "hi": "धरती के सापेक्ष गोली: $100 + 10 = 110$ m/s।"
          },
          {
            "en": "Relative to the car: $110 - 20 = 90$ m/s.",
            "hi": "कार के सापेक्ष: $110 - 20 = 90$ m/s।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "That is the bullet's speed relative to the ground.",
              "hi": "यह धरती के सापेक्ष गोली की चाल है।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "The car's velocity was added instead of subtracted.",
              "hi": "कार का वेग घटाने के बजाय जोड़ दिया।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "The van's velocity was ignored.",
              "hi": "वैन का वेग छोड़ दिया।"
            }
          }
        ]
      },
      "ideal_time_s": 60,
      "difficulty_estimate": "medium",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
    {
      "id": "q.phy.motion-straight-line.relative-velocity-1d.0004",
      "type": "integer",
      "concepts": [
        {
          "id": "phy.motion-straight-line.relative-velocity-1d.core.relative-velocity",
          "weight": 1
        }
      ],
      "depth": 3,
      "exam_styles": [
        "jee-main"
      ],
      "stem": {
        "en": "Two trains 150 m and 250 m long run on parallel tracks in opposite directions at 15 m/s and 25 m/s. How many seconds do they take to cross each other completely?",
        "hi": "150 m और 250 m लंबी दो रेलगाड़ियाँ समांतर पटरियों पर विपरीत दिशाओं में 15 m/s और 25 m/s से चल रही हैं। एक-दूसरे को पूरी तरह पार करने में उन्हें कितने सेकंड लगते हैं?"
      },
      "answer": {
        "value": 10,
        "unit": null
      },
      "hints": [
        {
          "en": "Opposite directions add.",
          "hi": "विपरीत दिशाएँ जुड़ती हैं।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "The gap to close is both lengths; the closing speed is the sum.",
          "hi": "घटाई जाने वाली दूरी दोनों लंबाइयाँ है; पास आने की चाल योग है।"
        },
        "steps": [
          {
            "en": "Relative speed $= 15 + 25 = 40$ m/s; distance $= 150 + 250 = 400$ m.",
            "hi": "आपेक्षिक चाल $= 15 + 25 = 40$ m/s; दूरी $= 150 + 250 = 400$ m।"
          },
          {
            "en": "$t = \\frac{400}{40} = 10$ s",
            "hi": "$t = \\frac{400}{40} = 10$ s"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "why": {
              "en": "Subtracting the speeds gives 40 s, as if they moved the same way.",
              "hi": "चालें घटाने पर 40 s आता है, मानो वे एक ही ओर चल रही हों।"
            }
          }
        ]
      },
      "ideal_time_s": 60,
      "difficulty_estimate": "medium",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
