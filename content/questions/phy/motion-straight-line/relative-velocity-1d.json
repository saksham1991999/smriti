      "options": [
        {
          "id": "a",
          "text": {
            "en": "25 m/s forward",
            "hi": "25 m/s आगे"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "15 m/s forward",
            "hi": "15 m/s आगे"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "5 m/s forward",
            "hi": "5 m/s आगे"
          }
        },
        {
          "id": "d",
