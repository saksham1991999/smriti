            "why": {
              "en": "The distance is squared.",
              "hi": "दूरी का वर्ग होता है।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "N m is the unit of torque.",
              "hi": "N m बल आघूर्ण का मात्रक है।"
            }
          },
          {
            "option_id": "d",
            "why": {
