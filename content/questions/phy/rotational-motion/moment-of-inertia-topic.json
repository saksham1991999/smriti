    {
      "id": "q.phy.rotational-motion.moment-of-inertia-topic.0007",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "phy.rotational-motion.moment-of-inertia-topic.core.standard-moments-of-inertia",
          "weight": 1
        }
      ],
      "depth": 3,
      "exam_styles": [
        "jee-main",
        "neet-ug"
      ],
      "stem": {
        "en": "The radius of gyration of a solid sphere of radius R about a diameter is",
        "hi": "R त्रिज्या के ठोस गोले की व्यास के परितः परिभ्रमण त्रिज्या है"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "$\\sqrt{2/5}\\,R$",
            "hi": "$\\sqrt{2/5}\\,R$"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "$2R/5$",
            "hi": "$2R/5$"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "$R/\\sqrt{2}$",
            "hi": "$R/\\sqrt{2}$"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "$R$",
            "hi": "$R$"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "$I = Mk^2$",
          "hi": "$I = Mk^2$"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Set $Mk^2$ equal to $2MR^2/5$.",
          "hi": "$Mk^2$ को $2MR^2/5$ के बराबर रखिए।"
        },
        "steps": [
          {
            "en": "$Mk^2 = \\frac{2}{5}MR^2$, so $k = \\sqrt{\\frac{2}{5}}\\,R \\approx 0.63R$",
            "hi": "$Mk^2 = \\frac{2}{5}MR^2$, अतः $k = \\sqrt{\\frac{2}{5}}\\,R \\approx 0.63R$"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
