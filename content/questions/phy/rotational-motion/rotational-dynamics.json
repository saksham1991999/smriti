      "concepts": [
        {
          "id": "phy.rotational-motion.rotational-dynamics.core.rotational-equations",
          "weight": 1
        }
      ],
      "depth": 3,
      "exam_styles": [
        "jee-main",
        "neet-ug"
      ],
      "stem": {
        "en": "A light rope is wound round a hollow cylinder of mass 2 kg and radius 0.5 m, free to turn about its axis. The rope is pulled with a force of 10 N. The angular acceleration of the cylinder is",
        "hi": "2 kg द्रव्यमान और 0.5 m त्रिज्या के खोखले बेलन पर, जो अपने अक्ष के परितः घूमने के लिए स्वतंत्र है, एक हलकी रस्सी लिपटी है। रस्सी को 10 N बल से खींचा जाता है। बेलन का कोणीय त्वरण है"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "10 rad/s²",
            "hi": "10 rad/s²"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "20 rad/s²",
            "hi": "20 rad/s²"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "5 rad/s²",
            "hi": "5 rad/s²"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "2.5 rad/s²",
