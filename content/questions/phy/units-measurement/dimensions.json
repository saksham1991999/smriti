      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "$[M^0 L T^{-2}]$",
            "hi": "$[M^0 L T^{-2}]$"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "$[M^0 L T^{-1}]$",
            "hi": "$[M^0 L T^{-1}]$"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "$[M L T^{-2}]$",
            "hi": "$[M L T^{-2}]$"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "$[M^0 L^2 T^{-2}]$",
            "hi": "$[M^0 L^2 T^{-2}]$"
          }
        }
      ],
      "answer": {
