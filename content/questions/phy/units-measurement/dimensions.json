        },
        "steps": [
          {
            "en": "$[L T^{-1}]/[T] = [M^0 L T^{-2}]$ (NCERT §1.5).",
            "hi": "$[L T^{-1}]/[T] = [M^0 L T^{-2}]$ (NCERT §1.5)।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "That is velocity.",
              "hi": "यह वेग है।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "That is force.",
              "hi": "यह बल है।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "Length appears once, not twice.",
              "hi": "लंबाई एक बार आती है, दो बार नहीं।"
            }
          }
        ]
      },
      "ideal_time_s": 30,
