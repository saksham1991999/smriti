    {
      "id": "q.phy.units-measurement.si-units.0001",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "phy.units-measurement.si-units.core.fundamental-derived-units",
          "weight": 1
        }
      ],
      "depth": 2,
      "exam_styles": [
        "jee-main",
        "neet-ug"
      ],
      "stem": {
        "en": "In the CGS system, the base units of length, mass and time are",
        "hi": "CGS पद्धति में लंबाई, द्रव्यमान और समय के मूल मात्रक हैं"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "centimetre, gram, second",
            "hi": "सेंटीमीटर, ग्राम, सेकंड"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "metre, kilogram, second",
            "hi": "मीटर, किलोग्राम, सेकंड"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "foot, pound, second",
            "hi": "फ़ुट, पाउंड, सेकंड"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "centimetre, kilogram, second",
            "hi": "सेंटीमीटर, किलोग्राम, सेकंड"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "C, G, S stand for the three units.",
          "hi": "C, G, S तीनों मात्रकों के लिए हैं।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "The name says it: centimetre, gram, second.",
          "hi": "नाम ही बताता है: सेंटीमीटर, ग्राम, सेकंड।"
        },
        "steps": [
          {
            "en": "NCERT §1.2: CGS uses the centimetre, gram and second.",
            "hi": "NCERT §1.2: CGS में सेंटीमीटर, ग्राम और सेकंड।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "These are the MKS (and SI) units.",
              "hi": "ये MKS (और SI) मात्रक हैं।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "These are the FPS units.",
              "hi": "ये FPS मात्रक हैं।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "This mixes CGS length with the MKS mass unit.",
              "hi": "इसमें CGS लंबाई के साथ MKS द्रव्यमान मात्रक मिला है।"
            }
          }
        ]
      },
