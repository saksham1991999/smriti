    {
      "id": "q.phy.units-measurement.si-units.0002",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "phy.units-measurement.si-units.core.fundamental-derived-units",
          "weight": 1
        }
      ],
      "depth": 2,
      "exam_styles": [
        "jee-main",
        "neet-ug"
      ],
      "stem": {
        "en": "Which of these is NOT an SI base unit?",
        "hi": "इनमें से कौन-सा SI मूल मात्रक नहीं है?"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "newton",
            "hi": "न्यूटन"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "ampere",
            "hi": "ऐम्पियर"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "kelvin",
            "hi": "केल्विन"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "candela",
            "hi": "कैन्डेला"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Recall the seven: m, kg, s, A, K, mol, cd.",
          "hi": "सात याद कीजिए: m, kg, s, A, K, mol, cd।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Of the four, only the newton is built from other units.",
          "hi": "चारों में से केवल न्यूटन दूसरे मात्रकों से बना है।"
        },
        "steps": [
          {
            "en": "$1\\,\\mathrm{N} = 1\\,\\mathrm{kg\\,m\\,s^{-2}}$, a derived unit.",
            "hi": "$1\\,\\mathrm{N} = 1\\,\\mathrm{kg\\,m\\,s^{-2}}$, एक व्युत्पन्न मात्रक।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "The ampere is the base unit of electric current.",
              "hi": "ऐम्पियर विद्युत धारा का मूल मात्रक है।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "The kelvin is the base unit of thermodynamic temperature.",
              "hi": "केल्विन ऊष्मागतिक ताप का मूल मात्रक है।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "The candela is the base unit of luminous intensity.",
              "hi": "कैन्डेला ज्योति तीव्रता का मूल मात्रक है।"
            }
          }
        ]
      },
      "ideal_time_s": 30,
      "difficulty_estimate": "easy",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
    {
      "id": "q.phy.units-measurement.si-units.0003",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "phy.units-measurement.si-units.core.fundamental-derived-units",
          "weight": 1
        }
      ],
      "depth": 2,
      "exam_styles": [
        "jee-main",
        "neet-ug"
      ],
      "stem": {
        "en": "The SI unit of the amount of substance is",
        "hi": "पदार्थ की मात्रा का SI मात्रक है"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "mole",
            "hi": "मोल"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "kilogram",
            "hi": "किलोग्राम"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "candela",
            "hi": "कैन्डेला"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "kelvin",
            "hi": "केल्विन"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "It is also used in chemistry for counting particles.",
          "hi": "रसायन में कणों को गिनने के लिए भी यही प्रयुक्त होता है।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Amount of substance counts elementary entities; its unit is the mole.",
          "hi": "पदार्थ की मात्रा मूल कणों की गिनती है; इसका मात्रक मोल है।"
        },
        "steps": [
          {
            "en": "NCERT Table 1.1: amount of substance, mole (mol).",
            "hi": "NCERT तालिका 1.1: पदार्थ की मात्रा, मोल (mol)।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "The kilogram measures mass, not the number of entities.",
              "hi": "किलोग्राम द्रव्यमान मापता है, कणों की संख्या नहीं।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "The candela is for luminous intensity.",
              "hi": "कैन्डेला ज्योति तीव्रता के लिए है।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "The kelvin is for temperature.",
              "hi": "केल्विन ताप के लिए है।"
            }
          }
        ]
      },
      "ideal_time_s": 30,
      "difficulty_estimate": "easy",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
    {
      "id": "q.phy.units-measurement.si-units.0004",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "phy.units-measurement.si-units.core.fundamental-derived-units",
          "weight": 1
        }
      ],
      "depth": 3,
      "exam_styles": [
        "jee-main",
        "neet-ug"
      ],
      "stem": {
        "en": "Force is mass times acceleration. Its SI unit, in base units, is",
        "hi": "बल द्रव्यमान गुणा त्वरण है। मूल मात्रकों में इसका SI मात्रक है"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "$\\mathrm{kg\\,m\\,s^{-2}}$",
            "hi": "$\\mathrm{kg\\,m\\,s^{-2}}$"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "$\\mathrm{kg\\,m\\,s^{-1}}$",
            "hi": "$\\mathrm{kg\\,m\\,s^{-1}}$"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "$\\mathrm{g\\,cm\\,s^{-2}}$",
            "hi": "$\\mathrm{g\\,cm\\,s^{-2}}$"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "$\\mathrm{kg\\,m^{2}\\,s^{-2}}$",
            "hi": "$\\mathrm{kg\\,m^{2}\\,s^{-2}}$"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Acceleration is m s⁻².",
          "hi": "त्वरण m s⁻² है।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Multiply the unit of mass by the unit of acceleration, metre per second per second.",
          "hi": "द्रव्यमान के मात्रक को त्वरण के मात्रक, मीटर प्रति सेकंड प्रति सेकंड, से गुणा कीजिए।"
        },
        "steps": [
          {
            "en": "$\\mathrm{kg} \\times \\mathrm{m\\,s^{-2}} = \\mathrm{kg\\,m\\,s^{-2}}$",
            "hi": "$\\mathrm{kg} \\times \\mathrm{m\\,s^{-2}} = \\mathrm{kg\\,m\\,s^{-2}}$"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "That is the unit of momentum (mass times velocity).",
              "hi": "यह संवेग (द्रव्यमान गुणा वेग) का मात्रक है।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "These are CGS units, not SI.",
              "hi": "ये CGS मात्रक हैं, SI नहीं।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "That is the unit of energy, the joule.",
              "hi": "यह ऊर्जा, जूल, का मात्रक है।"
            }
          }
        ]
      },
      "ideal_time_s": 40,
      "difficulty_estimate": "easy",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
    {
      "id": "q.phy.units-measurement.si-units.0005",
