    {
      "id": "q.phy.work-energy-power.power.0004",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "phy.work-energy-power.power.core.power-definition",
          "weight": 1
        }
      ],
      "depth": 3,
      "exam_styles": [
        "jee-main",
        "neet-ug"
      ],
      "stem": {
        "en": "A body starts from rest and moves in a straight line with constant acceleration under a constant net force. The power delivered by that force",
        "hi": "एक पिंड विराम से चलकर नियत नेट बल के अधीन सरल रेखा में नियत त्वरण से चलता है। उस बल द्वारा दी गई शक्ति"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "grows in proportion to the time",
            "hi": "समय के अनुक्रमानुपात में बढ़ती है"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "grows as the square of the time",
            "hi": "समय के वर्ग के अनुसार बढ़ती है"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "stays constant",
            "hi": "नियत रहती है"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "grows as the square root of the time",
            "hi": "समय के वर्गमूल के अनुसार बढ़ती है"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "$P = Fv$ and $v = at$",
          "hi": "$P = Fv$ और $v = at$"
        }
      ],
      "solution": {
        "feynman": {
          "en": "With F fixed, power follows the speed.",
          "hi": "F नियत हो तो शक्ति चाल के अनुसार चलती है।"
        },
        "steps": [
          {
            "en": "$P = Fv = F(at)$, and F and a are constant, so $P \\propto t$.",
            "hi": "$P = Fv = F(at)$, और F तथा a नियत हैं, अतः $P \\propto t$।"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "That would follow the distance, not the speed.",
              "hi": "यह दूरी के अनुसार होता, चाल के नहीं।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "The speed rises, so the power rises.",
              "hi": "चाल बढ़ती है, इसलिए शक्ति बढ़ती है।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "The speed is proportional to t, not $\\sqrt{t}$.",
              "hi": "चाल t के अनुक्रमानुपाती है, $\\sqrt{t}$ के नहीं।"
            }
          }
        ]
      },
      "ideal_time_s": 35,
      "difficulty_estimate": "medium",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
    },
    {
      "id": "q.phy.work-energy-power.power.0005",
      "type": "mcq_single",
      "concepts": [
        {
          "id": "phy.work-energy-power.power.core.power-definition",
          "weight": 1
        }
      ],
      "depth": 3,
      "exam_styles": [
        "jee-main",
        "neet-ug"
      ],
      "stem": {
        "en": "A pump lifts 600 kg of water through a height of 10 m in 1 minute. Taking $g = 10$ m/s², the useful power it delivers is",
        "hi": "एक पंप 600 kg पानी को 1 मिनट में 10 m ऊँचाई तक उठाता है। $g = 10$ m/s² लेकर, वह जो उपयोगी शक्ति देता है, वह है"
      },
      "options": [
        {
          "id": "a",
          "text": {
            "en": "1000 W",
            "hi": "1000 W"
          }
        },
        {
          "id": "b",
          "text": {
            "en": "60000 W",
            "hi": "60000 W"
          }
        },
        {
          "id": "c",
          "text": {
            "en": "100 W",
            "hi": "100 W"
          }
        },
        {
          "id": "d",
          "text": {
            "en": "6000 W",
            "hi": "6000 W"
          }
        }
      ],
      "answer": {
        "option_ids": [
          "a"
        ]
      },
      "hints": [
        {
          "en": "Convert 1 minute to 60 s.",
          "hi": "1 मिनट को 60 s में बदलिए।"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Divide the work against gravity by the time in seconds.",
          "hi": "गुरुत्व के विरुद्ध कार्य को सेकंड में समय से भाग दीजिए।"
        },
        "steps": [
          {
            "en": "$W = mgh = 600 \\times 10 \\times 10 = 60000$ J; $P = 60000 / 60 = 1000$ W",
            "hi": "$W = mgh = 600 \\times 10 \\times 10 = 60000$ J; $P = 60000 / 60 = 1000$ W"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "option_id": "b",
            "why": {
              "en": "That is the work, not the power.",
              "hi": "यह कार्य है, शक्ति नहीं।"
            }
          },
          {
            "option_id": "c",
            "why": {
              "en": "That divides by 600 instead of 60.",
              "hi": "यह 60 के बजाय 600 से भाग देता है।"
            }
          },
          {
            "option_id": "d",
            "why": {
              "en": "That divides by 10 instead of 60.",
              "hi": "यह 60 के बजाय 10 से भाग देता है।"
            }
          }
        ]
      },
      "ideal_time_s": 35,
      "difficulty_estimate": "medium",
      "media": null,
