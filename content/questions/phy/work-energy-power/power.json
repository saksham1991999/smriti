      "depth": 2,
      "exam_styles": [
        "jee-main"
      ],
      "stem": {
        "en": "A force $\\vec{F} = (3\\hat{i} + 4\\hat{j})$ N acts on a body moving with velocity $\\vec{v} = (2\\hat{i} + \\hat{j})$ m/s. The power delivered by the force, in W, is",
        "hi": "एक बल $\\vec{F} = (3\\hat{i} + 4\\hat{j})$ N, $\\vec{v} = (2\\hat{i} + \\hat{j})$ m/s वेग से चलते पिंड पर लगता है। बल द्वारा दी गई शक्ति, W में, है"
      },
      "answer": {
        "value": 10,
        "unit": "W"
      },
      "hints": [
        {
          "en": "$P = F_xv_x + F_yv_y$",
          "hi": "$P = F_xv_x + F_yv_y$"
        }
      ],
      "solution": {
        "feynman": {
          "en": "Power is force dotted with velocity.",
          "hi": "शक्ति बल और वेग का बिंदु गुणनफल है।"
        },
        "steps": [
          {
            "en": "$P = \\vec{F}\\cdot\\vec{v} = 3(2) + 4(1) = 10$ W",
            "hi": "$P = \\vec{F}\\cdot\\vec{v} = 3(2) + 4(1) = 10$ W"
          }
        ],
        "shortcut": null,
        "shortcut_fails_when": null,
        "common_traps": [
          {
            "why": {
              "en": "Multiplying the magnitudes, $5 \\times \\sqrt{5}$, ignores the angle.",
              "hi": "परिमाणों का गुणा, $5 \\times \\sqrt{5}$, कोण की उपेक्षा करता है।"
            }
          }
        ]
      },
      "ideal_time_s": 30,
      "difficulty_estimate": "easy",
      "media": null,
      "use": [
        "practice",
        "lesson"
      ],
      "source": "original"
