{
  "name": "smriti",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "content:check": "turbo run content:check --filter=@smriti/content-schema",
    "env:check": "node tools/deploy/src/env-check.ts",
    "format": "prettier --write .",
    "db:up": "bash scripts/dev/db.sh up",
    "db:reset": "bash scripts/dev/db.sh reset",
    "db:down": "bash scripts/dev/db.sh down",
    "stack": "bash scripts/dev/stack.sh",
    "stack:smoke": "bash scripts/dev/stack.sh --smoke"
  },
  "devDependencies": {
    "prettier": "3.3.3",
    "turbo": "2.3.3",
    "typescript": "5.9.3"
  }
}
