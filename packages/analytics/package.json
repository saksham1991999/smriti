{
  "name": "@smriti/analytics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typed analytics event catalogue (generated from the flow docs), props guard, minors policy and a batching client with an injected transport.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs && node scripts/export-json.mjs",
    "generate:check": "node scripts/generate.mjs --check && node scripts/export-json.mjs --check",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "lint": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.6.3",
    "vitest": "4.1.11"
  }
}
