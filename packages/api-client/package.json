{
  "name": "@smriti/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typed client for the Smriti API, generated from apps/api's OpenAPI document, with TanStack Query hooks.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.ts",
    "./openapi.json": "./openapi.json"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "check:generated": "node scripts/generate.mjs --check",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "lint": "tsc --noEmit -p ."
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5.0.0",
    "react": ">=18.2.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-query": "5.104.2",
    "@types/node": "24.19.2",
    "@types/react": "19.2.18",
    "openapi-typescript": "7.13.0",
    "prettier": "3.3.3",
    "react": "19.2.9",
    "typescript": "5.6.3",
    "vitest": "4.1.11"
  }
}
