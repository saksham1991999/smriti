{
  "name": "@smriti/app-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Platform-free logic shared by the web and mobile apps: storage interface, outbox and sync, auth, gamification rules, FSRS, Home hero, limits, stores and content downloads.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react/index.ts",
    "./test-vectors/*.json": "./test-vectors/*.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.react.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "vectors": "UPDATE_VECTORS=1 vitest run test/vectors.test.ts",
    "lint": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@smriti/config": "workspace:*",
    "@supabase/supabase-js": "2.117.3",
    "ts-fsrs": "5.4.2",
    "zustand": "5.0.15"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "5.6.3",
    "vitest": "4.1.11"
  }
}
