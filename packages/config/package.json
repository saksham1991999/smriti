{
  "name": "@smriti/config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "App variants, the feature-flag registry with defaults, and the client env schema.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./variants/*.json": "./variants/*.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "lint": "tsc --noEmit -p .",
    "flags:export": "node scripts/export-flag-defaults.mjs"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.6.3",
    "vitest": "4.1.11"
  }
}
