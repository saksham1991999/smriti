{
  "name": "@smriti/config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "App variants, the feature-flag registry with defaults, and the client env schema.",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "react-native": "./src/index.ts",
      "browser": "./src/index.ts",
      "node": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./variants/*.json": "./variants/*.json"
  },
  "files": ["src", "dist", "variants"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "prepare": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "test": "node scripts/build.mjs && vitest run",
    "lint": "tsc --noEmit -p ."
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "typescript": "5.6.3",
    "vitest": "4.1.11"
  }
}
