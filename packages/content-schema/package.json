{
  "name": "@smriti/content-schema",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "JSON Schemas, TypeScript types, Ajv validators and the content check for Smriti content.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./check": "./src/check/index.ts",
    "./schemas/*": "./schemas/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "lint": "tsc --noEmit -p . && tsx scripts/gen-types.ts --check",
    "test": "vitest run",
    "content:check": "tsx src/check/cli.ts",
    "gen:types": "tsx scripts/gen-types.ts",
    "gen:python": "bash scripts/gen-python.sh",
    "test:python": "uv run --project python --group dev pytest -q python/tests"
  },
  "dependencies": {
    "@smriti/tokens": "workspace:*",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "json-schema-to-typescript": "15.0.4",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "vitest": "4.1.11"
  }
}
