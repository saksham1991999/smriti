{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.smriti.app/content/coverage.schema.json",
  "title": "CoverageReport",
  "description": "content/coverage/{exam_profile_id}.json: generated by the content check (quality-bar 1, PRD 14). Never hand-edited. A subject ships only at 100%.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "exam_profile", "totals", "syllabus", "inventory", "subjects"],
  "properties": {
    "schema": { "const": "coverage@1" },
    "exam_profile": { "$ref": "common.schema.json#/$defs/ExamProfileId" },
    "fixture": { "type": "boolean" },
    "totals": { "$ref": "#/$defs/Tally" },
    "syllabus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lines", "mapped", "percent", "unmapped"],
      "properties": {
        "lines": { "type": "integer", "minimum": 0 },
        "mapped": { "type": "integer", "minimum": 0 },
        "percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "unmapped": { "type": "array", "items": { "type": "string" } }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "mapped", "excluded", "percent", "unmapped"],
      "properties": {
        "items": { "type": "integer", "minimum": 0 },
        "mapped": { "type": "integer", "minimum": 0 },
        "excluded": { "type": "integer", "minimum": 0 },
        "percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "unmapped": { "type": "array", "items": { "type": "string" } }
      }
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "released", "ready", "tally", "chapters"],
        "properties": {
          "id": { "type": "string" },
          "released": { "type": "boolean" },
          "ready": {
            "description": "true when every concept, syllabus line and inventory item of the subject is covered.",
            "type": "boolean"
          },
          "tally": { "$ref": "#/$defs/Tally" },
          "chapters": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "tally", "concepts"],
              "properties": {
                "id": { "type": "string" },
                "tally": { "$ref": "#/$defs/Tally" },
                "concepts": { "type": "array", "items": { "$ref": "#/$defs/ConceptCoverage" } }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "Tally": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concepts", "covered", "percent"],
      "properties": {
        "concepts": { "type": "integer", "minimum": 0 },
        "covered": { "type": "integer", "minimum": 0 },
        "percent": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "Requirement": {
      "type": "string",
      "enum": [
        "teaching_card",
        "revision_card",
        "practice_question",
        "srs_card",
        "formula_card",
        "worked_example",
        "memory_hook"
      ]
    },
    "ConceptCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "depth", "covered", "met", "missing"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string" },
        "depth": { "type": "integer" },
        "covered": { "type": "boolean" },
        "met": { "type": "array", "items": { "$ref": "#/$defs/Requirement" } },
        "missing": { "type": "array", "items": { "$ref": "#/$defs/Requirement" } }
      }
    }
  }
}
