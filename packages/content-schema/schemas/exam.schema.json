{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.smriti.app/content/exam.schema.json",
  "title": "ExamFile",
  "description": "content/exams/{exam_id}.json: an exam and its profiles (one per cycle). Projects to content.exams and content.exam_profiles.",
  "type": "object",
  "allOf": [{ "$ref": "common.schema.json#/$defs/FileMeta" }],
  "required": ["schema", "id", "name", "category", "profiles"],
  "properties": {
    "schema": { "const": "exam@1" },
    "id": { "$ref": "common.schema.json#/$defs/ExamId" },
    "name": { "$ref": "common.schema.json#/$defs/I18nText" },
    "category": {
      "type": "string",
      "enum": [
        "engineering",
        "medical",
        "civil_services",
        "ssc",
        "banking",
        "railways",
        "defence",
        "state",
        "school"
      ]
    },
    "conducting_body": { "type": ["string", "null"] },
    "official_url": { "type": ["string", "null"], "format": "uri" },
    "is_active": { "type": "boolean" },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/ExamProfile" }
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "ExamProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "cycle", "locales", "papers"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/ExamProfileId" },
        "cycle": { "type": "string", "minLength": 1 },
        "name": {
          "$ref": "common.schema.json#/$defs/I18nText"
        },
        "locales": {
          "description": "Locales every content field used by this profile must have.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/Locale" }
        },
        "papers": {
          "description": "Paper codes; each has a blueprint in blueprints/{profile}/{paper}.v{n}.json.",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/Slug" }
        },
        "schedule": {
          "description": "Official dates for the cycle, each with its notification URL. null until announced.",
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "date", "source_url"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "application_open",
                  "application_close",
                  "exam_window_start",
                  "exam_window_end",
                  "exam_day",
                  "result"
                ]
              },
              "date": { "$ref": "common.schema.json#/$defs/IsoDate" },
              "source_url": { "type": "string", "format": "uri" }
            }
          }
        },
        "is_active": { "type": "boolean" }
      }
    }
  }
}
