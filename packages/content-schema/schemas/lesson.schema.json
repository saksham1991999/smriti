{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.smriti.app/content/lesson.schema.json",
  "title": "LessonFile",
  "description": "content/lessons/{subject}/{chapter_slug}/{topic_slug}.{mode}.json: a Deep Dive or Quick Revision for one topic (lesson-author). Projects to content.content_items (kind lesson) and is built into bundles.",
  "type": "object",
  "allOf": [{ "$ref": "common.schema.json#/$defs/FileMeta" }],
  "required": [
    "schema",
    "id",
    "topic",
    "mode",
    "estimated_minutes",
    "min_depth",
    "max_depth",
    "concepts",
    "cards"
  ],
  "properties": {
    "schema": { "const": "lesson@1" },
    "id": {
      "description": "{topic_id}:{mode}",
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*:(deep_dive|quick_revision)$"
    },
    "topic": { "$ref": "common.schema.json#/$defs/TopicId" },
    "mode": { "$ref": "#/$defs/LessonMode" },
    "estimated_minutes": { "type": "number", "exclusiveMinimum": 0, "maximum": 60 },
    "min_depth": { "$ref": "common.schema.json#/$defs/Depth" },
    "max_depth": { "$ref": "common.schema.json#/$defs/Depth" },
    "min_app_version": {
      "description": "Set when the lesson uses a card renderer newer than the oldest supported app.",
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/ConceptId" }
    },
    "bites": {
      "description": "Deep Dive bites of 2-4 minutes, each ending at LES-08. When missing, a bite ends at each summary card. Every card belongs to exactly one bite, in card order.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Bite" }
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "card.schema.json" }
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "LessonMode": { "type": "string", "enum": ["deep_dive", "quick_revision"] },
    "Bite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "card_ids", "estimated_minutes"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/Slug" },
        "title": { "$ref": "common.schema.json#/$defs/I18nText" },
        "subtopic": { "$ref": "common.schema.json#/$defs/DottedId" },
        "card_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/CardId" }
        },
        "estimated_minutes": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
