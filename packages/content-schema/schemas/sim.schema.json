{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.smriti.app/content/sim.schema.json",
  "title": "SimManifest",
  "description": "sims/{sim_id}/sim.json: a simulation or virtual lab bundle (sim-builder). Projects to content.sims.",
  "type": "object",
  "allOf": [{ "$ref": "common.schema.json#/$defs/FileMeta" }],
  "required": [
    "schema",
    "id",
    "version",
    "title",
    "origin",
    "licence",
    "entry",
    "locales",
    "params_schema",
    "measurements",
    "aspect",
    "size_bytes",
    "concepts"
  ],
  "properties": {
    "schema": { "const": "sim@1" },
    "id": { "$ref": "common.schema.json#/$defs/Slug" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "title": { "$ref": "common.schema.json#/$defs/I18nText" },
    "origin": { "type": "string", "enum": ["own", "phet", "other_open"] },
    "licence": { "type": "string", "minLength": 1 },
    "attribution": { "type": ["string", "null"] },
    "entry": {
      "description": "The HTML entry point, relative to the bundle root.",
      "type": "string",
      "pattern": "^[A-Za-z0-9._/-]+\\.html$"
    },
    "bridge_version": { "type": "integer", "minimum": 1 },
    "locales": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/Locale" }
    },
    "params_schema": {
      "description": "JSON Schema for init.params.",
      "type": "object"
    },
    "measurements": {
      "description": "Measurements the sim can report, which lesson tasks may check.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "unit"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "unit": { "$ref": "common.schema.json#/$defs/Unit" },
          "label": { "$ref": "common.schema.json#/$defs/I18nText" }
        }
      }
    },
    "aspect": { "type": "string", "enum": ["4:3", "1:1", "16:9", "3:4"] },
    "size_bytes": {
      "description": "Total bundle size. Budget: under 2 MB.",
      "type": "integer",
      "minimum": 1,
      "maximum": 2097152
    },
    "supports_low_power": { "type": "boolean" },
    "poster": { "$ref": "common.schema.json#/$defs/ImageRef" },
    "concepts": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/ConceptId" }
    }
  },
  "unevaluatedProperties": false
}
