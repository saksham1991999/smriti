{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.smriti.app/content/subject.schema.json",
  "title": "SubjectFile",
  "description": "content/graph/{subject_id}/subject.json: the subject, its units and the ordered chapter list. Projects to content.subjects and content.units; the chapter order gives content.chapters.sort.",
  "type": "object",
  "allOf": [{ "$ref": "common.schema.json#/$defs/FileMeta" }],
  "required": ["schema", "id", "name", "color_family", "sort", "units", "chapters"],
  "properties": {
    "schema": { "const": "subject@1" },
    "id": { "$ref": "common.schema.json#/$defs/Slug" },
    "name": { "$ref": "common.schema.json#/$defs/I18nText" },
    "color_family": {
      "$ref": "common.schema.json#/$defs/SubjectFamily"
    },
    "sort": { "type": "integer", "minimum": 0 },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/DottedId" },
          "name": { "$ref": "common.schema.json#/$defs/I18nText" }
        }
      }
    },
    "chapters": {
      "description": "Chapter ids in teaching order (NCERT order where it exists). Each has a graph/{subject}/{chapter_slug}.json file.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/DottedId" }
    }
  },
  "unevaluatedProperties": false
}
