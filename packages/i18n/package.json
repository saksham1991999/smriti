{
  "name": "@smriti/i18n",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "English and Hindi UI catalogues extracted from the UX docs, i18next with ICU, and a typed key helper.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./locales/*.json": "./src/locales/*.json"
  },
  "scripts": {
    "extract": "node scripts/extract.mjs",
    "extract:check": "node scripts/extract.mjs --check",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "lint": "tsc --noEmit -p ."
  },
  "dependencies": {
    "i18next": "26.4.4",
    "i18next-icu": "2.4.5",
    "intl-messageformat": "12.1.3"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.21",
    "@types/node": "24.19.2",
    "typescript": "5.6.3",
    "vitest": "4.1.11"
  }
}
