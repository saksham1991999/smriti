{
  "name": "@smriti/lesson-player-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web renderer for lessons: one renderer per card type (concept, worked example, MCQ, numeric, sim, recap), the two-attempt check, confidence and the preview cut-off. Built against a small local card interface until @smriti/lesson-core lands.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "lint": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@smriti/ui-web": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
