{
  "name": "@smriti/lesson-player-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web renderer for published lesson bundles: one renderer per card and question type on top of @smriti/lesson-core's LessonSession (two tries, hints, worked solutions, confidence, the Pro preview cut-off).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "lint": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@smriti/content-schema": "workspace:*",
    "@smriti/i18n": "workspace:*",
    "@smriti/lesson-core": "workspace:*",
    "@smriti/ui-web": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.13.0",
    "jsdom": "30.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
