{
  "name": "@smriti/sim-bridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Typed postMessage protocol between the app (WebView or iframe host) and Smriti sims.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./sim": "./src/sim/index.ts",
    "./host": "./src/host/index.ts"
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "lint": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "vitest": "5.0.4"
  }
}
