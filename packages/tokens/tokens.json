    "chemistry": { "light": { "tint": "#F1E9FF", "strong": "#7B4DDB", "onStrong": "#FFFFFF", "text": "#794BDB" }, "dark": { "tint": "#2A2550", "strong": "#A98BFF", "onStrong": "#11131C", "text": "#A98BFF" } },
    "biology":   { "light": { "tint": "#E2F6EA", "strong": "#1F9D55", "onStrong": "#151A2D", "text": "#187B43" }, "dark": { "tint": "#123F33", "strong": "#3FD08A", "onStrong": "#11131C", "text": "#3FD08A" } },
    "maths":     { "light": { "tint": "#FFEBDC", "strong": "#E8590C", "onStrong": "#151A2D", "text": "#B84609" }, "dark": { "tint": "#3D2A12", "strong": "#FF9F43", "onStrong": "#11131C", "text": "#FF9F43" } },
    "history":   { "light": { "tint": "#FFF1D6", "strong": "#B7791F", "onStrong": "#151A2D", "text": "#946219" }, "dark": { "tint": "#3A3110", "strong": "#F2B84B", "onStrong": "#11131C", "text": "#F2B84B" } },
    "polity":    { "light": { "tint": "#E3F4F8", "strong": "#0E7C93", "onStrong": "#FFFFFF", "text": "#0D768C" }, "dark": { "tint": "#0F3640", "strong": "#2BC3D8", "onStrong": "#11131C", "text": "#2BC3D8" } },
