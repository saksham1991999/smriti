  },
  "subjectMap": {
    "$description": "Which colour family each subject id uses. Add new subjects here.",
    "phy": "physics", "chem": "chemistry", "bio": "biology", "math": "maths",
    "history": "history", "geography": "history", "social": "history", "art-culture": "history",
    "polity": "polity", "economy": "polity", "environment": "biology", "science-tech": "physics",
    "english": "language", "hindi": "language", "reasoning": "language", "quant": "maths", "gk": "polity"
  },
  "examAccent": {
    "$description": "Exam apps swap only the primary family (DESIGN.md §2.3). `light`/`dark` are the accent fills. Tint, pressed and text come from the matching subject family and the mock kit (design/mocks/kit.css), so text in the accent colour still meets 4.5:1. `onAccent*` is the text on the accent fill.",
    "all":  { "light": "#3557E8", "dark": "#7B93FF", "onAccentLight": "#FFFFFF", "onAccentDark": "#11131C", "tintLight": "#E7EEFF", "tintDark": "#1E2A4D", "pressedLight": "#2A47C4", "pressedDark": "#94A8FF", "textLight": "#3557E8", "textDark": "#7B93FF" },
    "jee":  { "light": "#3557E8", "dark": "#7B93FF", "onAccentLight": "#FFFFFF", "onAccentDark": "#11131C", "tintLight": "#E7EEFF", "tintDark": "#1E2A4D", "pressedLight": "#2A47C4", "pressedDark": "#94A8FF", "textLight": "#3557E8", "textDark": "#7B93FF" },
    "neet": { "light": "#1F9D55", "dark": "#3FD08A", "onAccentLight": "#151A2D", "onAccentDark": "#11131C", "tintLight": "#E2F6EA", "tintDark": "#123F33", "pressedLight": "#187B43", "pressedDark": "#3FD08A", "textLight": "#187B43", "textDark": "#3FD08A" },
    "upsc": { "light": "#0E7C93", "dark": "#2BC3D8", "onAccentLight": "#FFFFFF", "onAccentDark": "#11131C", "tintLight": "#E3F4F8", "tintDark": "#0F3640", "pressedLight": "#0B6476", "pressedDark": "#2BC3D8", "textLight": "#0D768C", "textDark": "#2BC3D8" },
    "ssc":  { "light": "#E8590C", "dark": "#FF9F43", "onAccentLight": "#151A2D", "onAccentDark": "#11131C", "tintLight": "#FFEBDC", "tintDark": "#3D2A12", "pressedLight": "#C24A0A", "pressedDark": "#FF9F43", "textLight": "#B84609", "textDark": "#FF9F43" }
  },
  "logo": {
    "$description": "Fills of the Smriti mark in brand/logo, the same in light and dark mode. On an exam-accent tile the mark turns white and the spark stays gold, except on SSC where the spark turns white too (DESIGN.md §12).",
    "leafDeep": "#3557E8",
    "leafLight": "#2BB5E8",
    "stem": "#2282C5",
    "spark": "#F5A300"
  },
  "mockPalette": {
    "$description": "Exam-standard question palette. Every state also has a shape, never colour alone.",
    "notVisited":     { "fill": "#FFFFFF", "border": "#7A8299", "text": "#151A2D", "shape": "square" },
    "notAnswered":    { "fill": "#D6363C", "border": "#D6363C", "text": "#FFFFFF", "shape": "pentagon-down" },
    "answered":       { "fill": "#1F9D55", "border": "#1F9D55", "text": "#151A2D", "shape": "pentagon-up" },
    "marked":         { "fill": "#6C4BFF", "border": "#6C4BFF", "text": "#FFFFFF", "shape": "circle" },
    "answeredMarked": { "fill": "#6C4BFF", "border": "#1F9D55", "text": "#FFFFFF", "shape": "circle-tick" }
  },
  "dataViz": {
    "$description": "Sequential scale for heat map cells (docs/ux/practice.md, Heat map cell). Each step mixes the base primary (examAccent.all) into surface by `mix`; `text` names the colour token printed on it. packages/tokens computes the hex values per mode and the contrast test checks them.",
    "sequential": [
      { "mix": 0.12, "text": "ink" },
      { "mix": 0.28, "text": "ink" },
      { "mix": 0.44, "text": "ink" },
      { "mix": 0.6, "text": "ink" },
      { "mix": 1, "text": "onPrimary" }
    ]
  },
  "thirdParty": {
    "$description": "Brand exception (DESIGN.md §5, Third-party sign-in buttons). Google's and Apple's own button colours, used only by the Continue with Google and Continue with Apple buttons. Never use these anywhere else. Google: https://developers.google.com/identity/branding-guidelines. Apple: https://developer.apple.com/design/human-interface-guidelines/sign-in-with-apple.",
    "google": {
      "light":   { "fill": "#FFFFFF", "stroke": "#747775", "text": "#1F1F1F" },
      "dark":    { "fill": "#131314", "stroke": "#8E918F", "text": "#E3E3E3" },
      "neutral": { "fill": "#F2F2F2", "text": "#1F1F1F" },
      "strokeWidth": 1,
      "font": { "family": "Google Sans", "weight": 500, "size": 14, "lineHeight": 20 },
      "padding": {
        "android": { "beforeLogo": 12, "afterLogo": 10, "afterText": 12 },
        "web":     { "beforeLogo": 12, "afterLogo": 10, "afterText": 12 },
        "ios":     { "beforeLogo": 16, "afterLogo": 12, "afterText": 16 }
      }
    },
    "apple": {
      "$description": "Rendered by the system button on iOS (ASAuthorizationAppleIDButton / expo-apple-authentication). These values are for mocks and previews only.",
      "black":        { "fill": "#000000", "text": "#FFFFFF" },
      "white":        { "fill": "#FFFFFF", "text": "#000000" },
      "whiteOutline": { "fill": "#FFFFFF", "stroke": "#000000", "text": "#000000" }
    }
  },
  "font": {
    "latin": "Plus Jakarta Sans",
    "devanagari": "Noto Sans Devanagari",
    "mono": "JetBrains Mono",
    "weights": { "body": 500, "ui": 600, "strong": 700, "heading": 800 }
  },
  "type": {
    "display": { "size": 30, "lineHeight": 36, "weight": 800, "tracking": -0.4 },
    "title":   { "size": 22, "lineHeight": 28, "weight": 800, "tracking": -0.2 },
    "heading": { "size": 18, "lineHeight": 24, "weight": 700, "tracking": 0 },
    "body":    { "size": 16, "lineHeight": 24, "weight": 500, "tracking": 0 },
    "label":   { "size": 14, "lineHeight": 20, "weight": 600, "tracking": 0 },
    "caption": { "size": 12, "lineHeight": 16, "weight": 600, "tracking": 0.2 },
    "devanagariLineHeightScale": 1.15
  },
  "space": { "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64 },
  "radius": { "xs": 8, "sm": 12, "md": 16, "card": 20, "cardLarge": 24, "sheet": 28, "button": 20, "pill": 999 },
  "shadow": {
    "card":   { "x": 0, "y": 2, "blur": 10, "color": "rgba(21,26,45,0.06)" },
    "raised": { "x": 0, "y": 8, "blur": 24, "color": "rgba(21,26,45,0.10)" },
    "ctaGlow": { "x": 0, "y": 10, "blur": 24, "colorFromPrimaryAlpha": 0.35 }
  },
  "size": { "touchMin": 48, "buttonHeight": 56, "buttonHeightSmall": 40, "tabBar": 82, "iconSm": 20, "icon": 24, "iconLg": 32 },
  "motion": {
    "duration": { "instant": 80, "fast": 120, "base": 200, "slow": 300, "emphasis": 400, "celebrate": 1200 },
    "easing": { "standard": [0.2, 0, 0, 1], "enter": [0, 0, 0, 1], "exit": [0.3, 0, 1, 1] },
    "spring": { "pop": { "damping": 14, "stiffness": 220 }, "gentle": { "damping": 20, "stiffness": 140 } },
    "pressScale": 0.97
  }
}
