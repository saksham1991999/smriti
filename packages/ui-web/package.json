{
  "name": "@smriti/ui-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Smriti web components (DESIGN.md §5) on React 19, Tailwind with the tokens preset, Radix primitives and Phosphor icons. Same names and props as @smriti/ui-native.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./fonts.css": "./src/fonts.css"
  },
  "sideEffects": ["*.css"],
  "scripts": {
    "predev": "pnpm --filter @smriti/tokens build",
    "dev": "vite --config gallery/vite.config.ts",
    "build:gallery": "pnpm --filter @smriti/tokens build && vite build --config gallery/vite.config.ts",
    "preview": "vite preview --config gallery/vite.config.ts",
    "typecheck": "tsc --noEmit -p .",
    "lint": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/noto-sans-devanagari": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@radix-ui/react-visually-hidden": "1.2.13",
    "@smriti/tokens": "workspace:*",
    "katex": "0.19.0"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
