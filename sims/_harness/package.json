{
  "name": "@smriti/sim-harness",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Developer host page: loads any sim in a sandboxed iframe through sim-bridge and shows the event log.",
  "scripts": {
    "build": "vite build",
    "build:all": "pnpm --filter \"./sims/*\" --filter \"!@smriti/sim-harness\" --filter \"!@smriti/sim-kit\" -w build && vite build",
    "serve": "node serve.mjs --port 4173",
    "typecheck": "tsc --noEmit -p .",
    "lint": "tsc --noEmit -p .",
    "test": "vitest run --passWithNoTests --dir src",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@smriti/sim-bridge": "workspace:*",
    "@smriti/sim-kit": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "typescript": "5.6.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
