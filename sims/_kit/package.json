{
  "name": "@smriti/sim-kit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shared kit for Smriti sims: bridge wiring, controls, token theme, i18n, units, loop and the Vite build preset.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./vite": "./vite.ts"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "lint": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/noto-sans-devanagari": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@phosphor-icons/core": "2.1.1",
    "@smriti/sim-bridge": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.6.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
