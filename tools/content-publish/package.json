{
  "name": "@smriti/content-publish",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Builds content bundles, manifests, patches, seed packs, the site index and content.* SQL from content/.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "lint": "tsc --noEmit -p .",
    "test": "vitest run",
    "publish:local": "tsx src/cli.ts --target local",
    "publish:fixtures": "tsx src/cli.ts --root content/fixtures --target local --out tools/content-publish/out",
    "publish:dry-run": "tsx src/cli.ts --dry-run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1150.0",
    "@smriti/content-schema": "workspace:*",
    "katex": "0.19.0",
    "mathjax-full": "3.2.2"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "vitest": "4.1.11",
    "zod": "4.6.7"
  }
}
